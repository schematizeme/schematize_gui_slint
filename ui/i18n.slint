// `global L` — TODA string estática da UI. Nada de texto hardcoded nos
// componentes: o Rust preenche isto a partir do catálogo i18n do lib.

export global L {
    in-out property <string> window-title: "schematize";
    in-out property <string> verified;   // tooltip do selo
    in-out property <string> tab-overdev;
    in-out property <string> tab-graph;
    in-out property <string> coming-soon;
    // aba Environments
    in-out property <string> tab-environments;
    // Aba MERCADO — o hub delega a janela do market (ADR-0012). As chaves `env-*` abaixo
    // seguem em uso pelo MODAL do marketplace, que ainda oferece instalar o environment de
    // uma linguagem junto com a skill.
    in-out property <string> mercado-title;
    in-out property <string> mercado-body;
    in-out property <string> mercado-open;
    in-out property <string> mercado-missing;
    in-out property <string> mercado-install;
    in-out property <string> deployer-title;
    in-out property <string> deployer-body;
    in-out property <string> deployer-open-keys;
    in-out property <string> deployer-open-hosts;
    in-out property <string> deployer-missing;
    in-out property <string> deployer-install;
    // Delegação do BANCO DE DADOS (E1 da extradição, ADR-0018). Mesmas cinco frases das
    // delegações irmãs, e pelo mesmo desenho: um componente só serve as quatro.
    in-out property <string> database-title;
    in-out property <string> database-body;
    in-out property <string> database-open;
    in-out property <string> database-missing;
    in-out property <string> database-install;
    // Delegação do GIT (E2 da extradição, ADR-0019).
    in-out property <string> git-title;
    in-out property <string> git-body;
    in-out property <string> git-open;
    in-out property <string> git-missing;
    in-out property <string> git-install;
    // Delegação do DISCO ao optimizer (E3 da extradição).
    in-out property <string> optimizer-title;
    in-out property <string> optimizer-body;
    in-out property <string> optimizer-open-disco;
    in-out property <string> optimizer-missing;
    in-out property <string> optimizer-install;
    // Delegação das SKILLS (E5 da extradição, ADR-0012 F4).
    in-out property <string> skills-title;
    in-out property <string> skills-body;
    in-out property <string> skills-open;
    in-out property <string> skills-missing;
    in-out property <string> skills-install;
    /// O rótulo da sub-aba. Curto de propósito: ele divide espaço com "Ambientes" numa barra.
    in-out property <string> skills-tab;
    in-out property <string> overdev-open;
    in-out property <string> overdev-missing;
    in-out property <string> overdev-install;
    in-out property <string> overdev-aba-perguntas;
    in-out property <string> overdev-aba-checklist;
    in-out property <string> overdev-aba-historico;
    // modal de instalação do Marketplace (dep opcional + environment opcional)
    in-out property <string> mp-cancel;           // "Cancelar"
    // aba Overdev (seletor de projeto + view)
    in-out property <string> project;            // "Projeto:"
    in-out property <string> no-project;          // empty-state: nenhum projeto
    in-out property <string> open-folder;         // "Abrir pasta…"
    in-out property <string> reload;              // "recarregar"
    in-out property <string> dev-dirs;            // "Diretórios de desenvolvimento"
    in-out property <string> add-dev-dir;         // "Adicionar diretório…"
    in-out property <string> dev-dirs-empty;      // empty-state dos dev_dirs
    // ---- Projetos fixados (pins) ----
    in-out property <string> pinned-projects;     // título "Projetos fixados"
    in-out property <string> pin-folder;          // botão "Fixar pasta…"
    in-out property <string> pin-hint;            // texto de ajuda do pin
    in-out property <string> open-browser;
    in-out property <string> od-open-terminal;        // "abrir no navegador"
    // ---- aba Overdev — Fase 3 (editor + tasks + checklist 2-níveis) ----
    in-out property <string> od-notes-title;       // título "Notas e correções"
    // ---- checklist FATIADO (filtro + paginação) ----
    // ---- editor acoplado sob demanda ----
    // ---- aba Overdev — Fase 4 (terminal externo + monitor leve) ----
    in-out property <string> od-run;               // botão "Executar overdev"
    in-out property <string> od-gen-archive;       // botão "Gerar afazeres do archive"
    // aba Grafo
    in-out property <string> g-search-hint;        // hint da busca ("procurar")
    in-out property <string> g-nodes-suffix;       // sufixo "nós"
    in-out property <string> g-fit;                // "ajustar"
    in-out property <string> g-no-graph;           // empty-state: sem índice/grafo
    in-out property <string> g-export-obsidian;    // "exportar Obsidian"
    in-out property <string> g-open-editor;        // "abrir no editor"
    in-out property <string> g-no-loc;             // "sem arquivo:linha no índice"
    in-out property <string> g-reindex;            // "Reindexar" (dispara o índice §39 num terminal)
    in-out property <string> g-reload;             // "Recarregar" (re-roda load_graph + descrições)
    in-out property <string> g-drill;              // "Grafo do serviço" (drill-down no nó selecionado)
    in-out property <string> g-global;             // "← Grafo global" (volta da visão por-serviço)
    in-out property <string> g-node-nodesc;        // "(sem descrição no índice — rode Reindexar)"
    // ---- Home + navegação (Fase 1 do redesenho) ----
    in-out property <string> home-title;             // "O que você quer fazer?"
    in-out property <string> home-market;            // card + breadcrumb "Mercado de Skills"
    in-out property <string> home-overdev-desc;      // descrição do card Overdev
    in-out property <string> home-market-desc;       // descrição do card Mercado
    in-out property <string> home-graph-desc;        // descrição do card Grafo
    in-out property <string> home-environments;      // card "Environments" (avulso, futuro)
    in-out property <string> home-environments-desc;
    in-out property <string> home-ssh;               // card "SSH" (futuro)
    in-out property <string> home-ssh-desc;
    in-out property <string> home-settings;          // card "Configurações" (futuro)
    in-out property <string> home-settings-desc;
    in-out property <string> open-vscode;            // "Abrir no VSCode"
    in-out property <string> open-loose-project;     // "Abrir projeto avulso…" (no modal)
    // ---- aba Gerenciar (criar + editar skills) — chaves NOVAS via `tor` ----
    // ---- Tela SSH (chaves) — chaves NOVAS via `tor` ----
    // ---- Tela Configurações — chaves NOVAS via `tor` ----
    in-out property <string> cfg-title;
    in-out property <string> cfg-language;            // "Idioma"
    in-out property <string> cfg-theme;               // "Tema"
    in-out property <string> cfg-autostart;           // "Autostart do agente"
    in-out property <string> cfg-autostart-desc;
    in-out property <string> cfg-hooks;               // "Hooks do overdev"
    in-out property <string> cfg-hooks-desc;
    in-out property <string> cfg-dirs;                // "Diretórios de dev e projetos fixados"
    in-out property <string> cfg-dirs-desc;
    in-out property <string> cfg-manage;              // "Gerenciar…"
    // ---- Diagnóstico (relatório de debug) ----
    in-out property <string> cfg-debug-title;         // "Diagnóstico"
    in-out property <string> cfg-debug-btn;           // "Gerar relatório de debug"
    in-out property <string> cfg-debug-generating;    // "Gerando…"
    in-out property <string> cfg-debug-open;          // "Abrir pasta"
    in-out property <string> cfg-debug-note;          // "modo 600 · segredos redigidos · revise antes de compartilhar"
    in-out property <string> cfg-debug-net;           // "incluir diagnóstico de rede (mais lento)"
    in-out property <string> cfg-debug-saved;         // "Relatório gravado em"
    // ---- Overdev — aditivos (histórico DB + commits) ----
    in-out property <string> od-commits;              // "Commits e push"
    in-out property <string> od-commits-empty;        // empty-state dos commits
    in-out property <string> od-close;                // "Fechar" (visor)
    // ---- Paginação ----
    in-out property <string> pg-prev;                 // "‹ Anterior"
    in-out property <string> pg-next;                 // "Próximo ›"
    in-out property <string> pg-of;                   // "de" (página X de Y)

    // ---- versão do app + self-update (Configurações) ----
    in-out property <string> app-version-title;       // "Versão do app"
    in-out property <string> app-check-update;        // "Verificar atualização"
    in-out property <string> app-checking;            // "Verificando…"
    in-out property <string> app-update-btn;          // "Atualizar app"
    in-out property <string> app-updating;            // "Atualizando…"
    in-out property <string> app-restart-hint;        // "Atualização concluída — reinicie o app."
    in-out property <string> app-restart;             // "Reiniciar"
    in-out property <string> gestor-missing-msg;     // "O gestor de atualizações não está instalado."
    in-out property <string> gestor-install-btn;     // "Instalar gestor de atualizações"

    // ---- sininho de notificações ----
    in-out property <string> notif-title;             // "Notificações"
    in-out property <string> notif-empty;             // "Sem notificações"
    in-out property <string> notif-global;            // "Globais"
    in-out property <string> notif-personal;          // "Pessoais"
    in-out property <string> notif-loading;           // "Carregando…"
    in-out property <string> notif-do-update;         // ação app_update: "Atualizar"
    in-out property <string> notif-open;              // ação news: "Abrir"
    in-out property <string> notif-go-installed;      // ação skill_outdated: "Ver instaladas"

    // ---- fork + comparar ----

    // ---- Conta (login via device flow) ----
    in-out property <string> acc-section;              // título da seção "Conta"
    in-out property <string> acc-login;                // "Entrar na plataforma"
    in-out property <string> acc-logout;               // "Sair"
    in-out property <string> acc-connected-as;         // "Conectado como" (prefixo do sub)
    in-out property <string> acc-logged-out-hint;      // descrição do estado deslogado
    in-out property <string> acc-modal-title;          // título do modal de login
    in-out property <string> acc-code-label;           // "Digite este código no navegador:"
    in-out property <string> acc-open-browser;         // "Abrir no navegador"
    in-out property <string> acc-verification-at;      // "Acesse:" (rótulo da URL)
    in-out property <string> acc-waiting;              // "Aguardando confirmação…"
    in-out property <string> acc-cancel;               // "Cancelar"
    in-out property <string> acc-indicator-tip;        // tooltip do indicador no header

    // ---- Database builder (tela 6) ----
    in-out property <string> home-database;            // card da Home "Banco de dados"
    in-out property <string> home-database-desc;

    // ---- Disco (tela 7) ----
    in-out property <string> home-disk;                 // card "Disco"
    in-out property <string> home-disk-desc;

    // ---- Git (tela 8) ----
    in-out property <string> home-git;                  // card "Git"
    in-out property <string> home-git-desc;

    // ---- Resolver item humano + caixa de entrada + skills do projeto ----
    in-out property <string> od-caixa-title;        // "Acrescentar ao projeto"
    in-out property <string> od-skills-outdated;    // "evoluíram desde que moldaram este projeto"
    in-out property <string> od-skills-rerun;       // "Rerodar skills"
    // ---- Portal (Home) ----
    in-out property <string> home-academy;
    in-out property <string> home-academy-desc;
    in-out property <string> home-research;
    in-out property <string> home-research-desc;
    in-out property <string> home-blog;
    in-out property <string> home-blog-desc;
    in-out property <string> notif-history;          // "Histórico" (o que já foi resolvido)

    // ---- Gestor de VPS (o "Termius embutido") ------------------------------
    in-out property <string> home-vps;
    in-out property <string> home-vps-desc;

}
