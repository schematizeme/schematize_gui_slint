    in-out property <string> notif-personal;          // "Pessoais"
    in-out property <string> notif-loading;           // "Carregando…"
    in-out property <string> notif-do-update;         // ação app_update: "Atualizar"
    in-out property <string> notif-open;              // ação news: "Abrir"
    in-out property <string> notif-go-installed;      // ação skill_outdated: "Ver instaladas"

    // ---- fork + comparar ----
    in-out property <string> fork-badge;              // "fork"
