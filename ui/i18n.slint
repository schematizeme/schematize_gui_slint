    in-out property <string> ssh-passphrase;          // "Passphrase (opcional)"
    in-out property <string> ssh-copy-pub;            // "Copiar pública"
    in-out property <string> ssh-copied;              // "copiado"
    in-out property <string> ssh-remove;              // "Remover"
    in-out property <string> ssh-empty;               // empty-state
    in-out property <string> ssh-priv-note;           // "A chave privada nunca é exposta"
    in-out property <string> ssh-keys-title;          // "Suas chaves"
    in-out property <string> ssh-entropy-ed25519;     // nota de entropia do ed25519
    in-out property <string> ssh-entropy-rsa;         // nota de entropia do RSA 4096
    in-out property <string> ssh-kind-hint;           // "ed25519 é o default forte; RSA exige ≥4096"
    in-out property <string> ssh-proof-label;         // "Prova da chave (bits · fingerprint · tipo)"
    in-out property <string> ssh-export-bw;           // "Exportar → Bitwarden"
    in-out property <string> ssh-bw-note;             // nota: a privada nunca aparece na tela
    // ---- Tela Configurações — chaves NOVAS via `tor` ----
    in-out property <string> cfg-title;
    in-out property <string> cfg-language;            // "Idioma"
    in-out property <string> cfg-theme;               // "Tema"
    in-out property <string> cfg-autostart;           // "Autostart do agente"
    in-out property <string> cfg-autostart-desc;
    in-out property <string> cfg-hooks;               // "Hooks do overdev"
    in-out property <string> cfg-hooks-desc;
    in-out property <string> cfg-dirs;                // "Diretórios de dev e projetos fixados"
    in-out property <string> cfg-dirs-desc;
    in-out property <string> cfg-manage;              // "Gerenciar…"
    in-out property <string> cfg-on;                  // "ligado"
    in-out property <string> cfg-off;                 // "desligado"
    // ---- Diagnóstico (relatório de debug) ----
    in-out property <string> cfg-debug-title;         // "Diagnóstico"
    in-out property <string> cfg-debug-btn;           // "Gerar relatório de debug"
    in-out property <string> cfg-debug-generating;    // "Gerando…"
    in-out property <string> cfg-debug-open;          // "Abrir pasta"
    in-out property <string> cfg-debug-note;          // "modo 600 · segredos redigidos · revise antes de compartilhar"
    in-out property <string> cfg-debug-net;           // "incluir diagnóstico de rede (mais lento)"
    in-out property <string> cfg-debug-saved;         // "Relatório gravado em"
    // ---- Overdev — aditivos (histórico DB + commits) ----
    in-out property <string> od-history;              // "Histórico (backup)"
    in-out property <string> od-history-note;         // explicação da cópia de segurança
    in-out property <string> od-view;                 // "Ver"
    in-out property <string> od-restore;              // "Restaurar"
    in-out property <string> od-snap-empty;           // empty-state do histórico
    in-out property <string> od-commits;              // "Commits e push"
    in-out property <string> od-commits-empty;        // empty-state dos commits
    in-out property <string> od-close;                // "Fechar" (visor)
    // ---- Paginação ----
    in-out property <string> pg-prev;                 // "‹ Anterior"
    in-out property <string> pg-next;                 // "Próximo ›"
    in-out property <string> pg-of;                   // "de" (página X de Y)

    // ---- versão do app + self-update (Configurações) ----
    in-out property <string> app-version-title;       // "Versão do app"
    in-out property <string> app-check-update;        // "Verificar atualização"
    in-out property <string> app-checking;            // "Verificando…"
    in-out property <string> app-up-to-date;          // "Você está atualizado"
    in-out property <string> app-update-btn;          // "Atualizar app"
    in-out property <string> app-updating;            // "Atualizando…"
    in-out property <string> app-restart-hint;        // "Atualização concluída — reinicie o app."
    in-out property <string> app-restart;             // "Reiniciar"
    in-out property <string> updater-missing-msg;     // "O gestor de atualizações não está instalado."
    in-out property <string> updater-install-btn;     // "Instalar gestor de atualizações"

    // ---- sininho de notificações ----
    in-out property <string> notif-title;             // "Notificações"
    in-out property <string> notif-empty;             // "Sem notificações"
