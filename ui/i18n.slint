    in-out property <string> acc-open-browser;         // "Abrir no navegador"
    in-out property <string> acc-verification-at;      // "Acesse:" (rótulo da URL)
    in-out property <string> acc-waiting;              // "Aguardando confirmação…"
    in-out property <string> acc-cancel;               // "Cancelar"
    in-out property <string> acc-indicator-tip;        // tooltip do indicador no header

    // ---- Database builder (tela 6) ----
    in-out property <string> home-database;            // card da Home "Banco de dados"
    in-out property <string> home-database-desc;
    in-out property <string> db-title;                 // título da tela
    in-out property <string> db-sub-connect;           // sub-aba "Conectar"
    in-out property <string> db-sub-schema;            // sub-aba "Schema"
    in-out property <string> db-sub-generate;          // sub-aba "Gerar"
    in-out property <string> db-sub-graph;             // sub-aba "Grafo"
    in-out property <string> db-sqlite-label;          // "Arquivo SQLite"
    in-out property <string> db-pg-label;              // "Connection string Postgres"
    in-out property <string> db-pick-file;             // "Escolher…"
    in-out property <string> db-introspect;            // "Introspectar"
    in-out property <string> db-load-json;             // "Carregar schema.json"
    in-out property <string> db-save-json;             // "Salvar schema.json"
    in-out property <string> db-no-schema;             // empty-state (nenhum schema)
    in-out property <string> db-tables-title;          // "Tabelas"
    in-out property <string> db-cols-label;            // "Colunas"
    in-out property <string> db-fks-label;             // "Chaves estrangeiras"
    in-out property <string> db-indexes-label;         // "Índices"
    in-out property <string> db-editor-title;          // "Editar schema"
