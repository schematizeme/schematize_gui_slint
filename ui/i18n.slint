    in-out property <string> compare-note;            // "Comparar NÃO sobrescreve nada"
    in-out property <string> compare-files;           // "Arquivos"
    in-out property <string> compare-loading;         // "Comparando…"

    // ---- Conta (login via device flow) ----
    in-out property <string> acc-section;              // título da seção "Conta"
    in-out property <string> acc-login;                // "Entrar na plataforma"
    in-out property <string> acc-logout;               // "Sair"
    in-out property <string> acc-connected-as;         // "Conectado como" (prefixo do sub)
