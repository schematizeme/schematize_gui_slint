    in-out property <string> db-unique;                // "UNIQUE"
    in-out property <string> db-nullable;              // "NULL"
    in-out property <string> db-add-fk;                // "Adicionar FK"
    in-out property <string> db-fk-col;                // "Coluna"
    in-out property <string> db-fk-reftable;           // "Tabela ref."
    in-out property <string> db-fk-refcol;             // "Coluna ref."
    in-out property <string> db-gen-sql;               // "Gerar SQL"
    in-out property <string> db-gen-migration;         // "Gerar migration"
    in-out property <string> db-gen-save;              // "Salvar em arquivo…"
    in-out property <string> db-ai-title;              // "Gerar por descrição (IA)"
    in-out property <string> db-ai-hint;               // hint do campo de descrição
    in-out property <string> db-ai-generate;           // "Gerar com IA"
    in-out property <string> db-ai-note;               // "roda no terminal; carregue o schema.json quando terminar"
    in-out property <string> db-ai-no-project;         // aviso: selecione um projeto
    in-out property <string> db-view-graph;            // "Ver grafo"
    in-out property <string> db-node-cols;             // texto do nó quando sem descrição

    // ---- Disco (tela 7) ----
    in-out property <string> home-disk;                 // card "Disco"
    in-out property <string> home-disk-desc;
    in-out property <string> disk-min-days;             // "Parado há"
    in-out property <string> disk-any;                  // "qualquer"
    in-out property <string> disk-scan;                 // "Varrer"
    in-out property <string> disk-scanning;             // "varrendo…"
    in-out property <string> disk-intro;                // o que a tela faz, antes da 1ª varredura
    in-out property <string> disk-by-mount;             // "POR DISCO"
    in-out property <string> disk-by-kind;              // "POR TIPO"
    in-out property <string> disk-docker;               // "DOCKER"
    in-out property <string> disk-largest;              // "MAIORES"
    in-out property <string> disk-reclaimable;          // "recuperável:"
    in-out property <string> disk-prune;                // "Podar"
    in-out property <string> disk-prune-data;           // "Apagar volumes"
    in-out property <string> disk-open;                 // "Abrir"
    in-out property <string> disk-delete;               // "Apagar"
    in-out property <string> disk-data-warning;         // volume é DADO, não build

    // ---- Git (tela 8) ----
    in-out property <string> home-git;                  // card "Git"
    in-out property <string> home-git-desc;
    in-out property <string> git-projects;              // seção "Projetos"
