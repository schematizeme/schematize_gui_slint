// `global L` — TODA string estática da UI. Nada de texto hardcoded nos
// componentes: o Rust preenche isto a partir do catálogo i18n do lib.

export global L {
    in-out property <string> window-title: "schematize";
    in-out property <string> subtitle;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> check;
    in-out property <string> update-all;
    in-out property <string> update-installed-only; // texto-guia do "Atualizar tudo"
    in-out property <string> update-sel;
    in-out property <string> install-sel-market;
    in-out property <string> remove-sel;
    in-out property <string> sel-label;
    in-out property <string> sel-all;
    in-out property <string> sel-pending;
    in-out property <string> sel-none;
    in-out property <string> col-skill;
    in-out property <string> col-author;
    in-out property <string> col-installed;
    in-out property <string> col-latest;
    in-out property <string> col-state;
    in-out property <string> col-actions;
    in-out property <string> verified;   // tooltip do selo
    in-out property <string> tab-installed;
    in-out property <string> tab-marketplace;
    in-out property <string> tab-overdev;
    in-out property <string> tab-graph;
    in-out property <string> coming-soon;
    in-out property <string> act-install;
    in-out property <string> act-update;
    in-out property <string> act-remove;   // "Desinstalar" por-linha
    // aba Environments
    in-out property <string> tab-environments;
    in-out property <string> env-intro;      // texto-guia (mexe na máquina / roda em terminal)
    in-out property <string> env-method;      // "Método:"
    in-out property <string> env-no-methods;  // nenhum método disponível
    // modal de instalação do Marketplace (dep opcional + environment opcional)
    in-out property <string> mp-recommends-note; // "Recomenda a skill base:"
    in-out property <string> mp-env-note;         // "o environment mexe na máquina / roda em terminal"
    in-out property <string> mp-confirm;          // "Instalar"
    in-out property <string> mp-cancel;           // "Cancelar"
    // aba Overdev (seletor de projeto + view)
    in-out property <string> project;            // "Projeto:"
    in-out property <string> no-project;          // empty-state: nenhum projeto
    in-out property <string> detected-projects;   // cabeçalho do grupo detectados
    in-out property <string> recent-projects;     // cabeçalho do grupo recentes
    in-out property <string> open-folder;         // "Abrir pasta…"
    in-out property <string> reload;              // "recarregar"
    in-out property <string> dev-dirs;            // "Diretórios de desenvolvimento"
    in-out property <string> add-dev-dir;         // "Adicionar diretório…"
    in-out property <string> dev-dirs-empty;      // empty-state dos dev_dirs
    in-out property <string> remove;              // tooltip "remover"
    // ---- Projetos fixados (pins) ----
    in-out property <string> pinned-projects;     // título "Projetos fixados"
    in-out property <string> pin-folder;          // botão "Fixar pasta…"
    in-out property <string> unpin;               // tooltip/botão "Desafixar"
    in-out property <string> pin-hint;            // texto de ajuda do pin
    in-out property <string> no-overdev;          // empty-state: sem run de overdev
    in-out property <string> od-decisions;        // "Decisões"
    in-out property <string> od-plan;             // "Plano"
    in-out property <string> od-questions;        // "Perguntas parkeadas"
    in-out property <string> open-browser;        // "abrir no navegador"
    // ---- aba Overdev — Fase 3 (editor + tasks + checklist 2-níveis) ----
    in-out property <string> od-human;             // etiqueta "humano"
    in-out property <string> od-machine;           // etiqueta "máquina"
    in-out property <string> od-mark-human;        // botão "marcar como feito"
    in-out property <string> od-editor;            // título "Editor"
    in-out property <string> od-save-plan;         // botão "Salvar"
    in-out property <string> od-tasks;             // título "Tarefas e notas"
    in-out property <string> od-add-note;          // botão "Adicionar nota"
    in-out property <string> od-note;              // rótulo/hint "Nota para esta tarefa…"
    in-out property <string> od-correction;        // título/hint "Prompt de correção…"
    in-out property <string> od-notes-title;       // título "Notas e correções"
    // ---- checklist FATIADO (filtro + paginação) ----
    in-out property <string> od-cl-all;            // filtro "Todos"
    in-out property <string> od-cl-open;           // filtro "Abertos"
    in-out property <string> od-cl-done;           // filtro "Feitos"
    in-out property <string> od-cl-hold;           // filtro "On-hold"
    in-out property <string> od-cl-human;          // filtro "Humanos"
    in-out property <string> od-cl-of;             // conector "de" ("1–100 de 700")
    in-out property <string> od-cl-empty;          // "Nenhum item neste filtro"
    // ---- editor acoplado sob demanda ----
    in-out property <string> od-editor-show;       // botão "Abrir editor"
    in-out property <string> od-editor-hide;       // botão "Fechar editor"
    in-out property <string> od-editor-big;        // aviso "arquivo grande demais…"
    in-out property <string> od-editor-external;   // botão "Abrir no editor externo"
    // ---- aba Overdev — Fase 4 (terminal externo + monitor leve) ----
    in-out property <string> od-run;               // botão "Executar overdev"
    in-out property <string> od-gen-archive;       // botão "Gerar afazeres do archive"
    in-out property <string> od-stop;              // botão "Parar"
    in-out property <string> od-running;           // pill de estado (monitor ligado)
    in-out property <string> od-mon-active;        // pill quando o run está "active"
    in-out property <string> od-confirm-run;       // texto do guardrail (aviso do disparo)
    in-out property <string> od-run-done;          // status "concluído"
    in-out property <string> od-agent-cmd;         // rótulo "Comando do agente"
    in-out property <string> od-ext-terminal;      // rótulo "claude rodando em terminal externo…"
    in-out property <string> od-mon-iters;         // rótulo "iterações"
    in-out property <string> od-mon-open-title;    // título "Itens abertos"
    in-out property <string> od-attach;            // botão "Reload / Acompanhar" (anexa a run externo)
    in-out property <string> od-refresh-tokens;    // botão "Atualizar tokens"
    in-out property <string> od-completions-title; // título "Conclusões" (log com data/hora)
    // aba Grafo
    in-out property <string> g-search-hint;        // hint da busca ("procurar")
    in-out property <string> g-nodes-suffix;       // sufixo "nós"
    in-out property <string> g-fit;                // "ajustar"
    in-out property <string> g-no-graph;           // empty-state: sem índice/grafo
    in-out property <string> g-export-obsidian;    // "exportar Obsidian"
    in-out property <string> g-open-editor;        // "abrir no editor"
    in-out property <string> g-no-loc;             // "sem arquivo:linha no índice"
    in-out property <string> g-reindex;            // "Reindexar" (dispara o índice §39 num terminal)
    in-out property <string> g-reload;             // "Recarregar" (re-roda load_graph + descrições)
    in-out property <string> g-drill;              // "Grafo do serviço" (drill-down no nó selecionado)
    in-out property <string> g-global;             // "← Grafo global" (volta da visão por-serviço)
    in-out property <string> g-node-nodesc;        // "(sem descrição no índice — rode Reindexar)"
    // ---- Home + navegação (Fase 1 do redesenho) ----
    in-out property <string> home;                   // breadcrumb de volta ("Início")
    in-out property <string> home-title;             // "O que você quer fazer?"
    in-out property <string> home-market;            // card + breadcrumb "Mercado de Skills"
    in-out property <string> home-overdev-desc;      // descrição do card Overdev
    in-out property <string> home-market-desc;       // descrição do card Mercado
    in-out property <string> home-graph-desc;        // descrição do card Grafo
    in-out property <string> home-environments;      // card "Environments" (avulso, futuro)
    in-out property <string> home-environments-desc;
    in-out property <string> home-ssh;               // card "SSH" (futuro)
    in-out property <string> home-ssh-desc;
    in-out property <string> home-settings;          // card "Configurações" (futuro)
    in-out property <string> home-settings-desc;
    in-out property <string> open-vscode;            // "Abrir no VSCode"
    in-out property <string> open-loose-project;     // "Abrir projeto avulso…" (no modal)
    // ---- aba Gerenciar (criar + editar skills) — chaves NOVAS via `tor` ----
    in-out property <string> manage;                 // sub-aba "Gerenciar"
    in-out property <string> create-skill;            // modo/título "Criar skill"
    in-out property <string> edit-skill;              // modo/título "Editar skill"
    in-out property <string> skill-slug;              // rótulo campo slug
    in-out property <string> skill-name;              // rótulo campo nome
    in-out property <string> skill-desc;              // rótulo campo descrição
    in-out property <string> create;                  // botão "Criar"
    in-out property <string> save;                    // botão "Salvar"
    in-out property <string> saved;                   // feedback "Salvo"
    in-out property <string> slug-invalid;            // erro de slug inválido
    in-out property <string> skill-exists;            // erro "já existe"
    in-out property <string> pick-skill;              // rótulo dropdown de skills
    in-out property <string> pick-file;               // rótulo lista de arquivos
    in-out property <string> skill-created;           // prefixo do sucesso ("Skill criada em")
    in-out property <string> no-installed-skills;     // empty-state do dropdown
    in-out property <string> edit-now;                // botão "Editar agora" (pós-criar)
    in-out property <string> pick-file-hint;          // empty-state do editor
    // ---- Tela SSH (chaves) — chaves NOVAS via `tor` ----
    in-out property <string> ssh-title;
    in-out property <string> ssh-generate;            // "Gerar chave"
    in-out property <string> ssh-name;                // "Nome"
    in-out property <string> ssh-kind;                // "Tipo"
