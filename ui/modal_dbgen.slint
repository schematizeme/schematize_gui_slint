import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { NotifItem, CmpFile } from "types.slint";
import { Btn, Chip, Check, Collapse, IconBtn } from "widgets.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Modal do SQL/migration gerado pelo Database builder (somente leitura).
export component DbGenModal inherits Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { Db.gen-open = false; } }
        Rectangle {
            width: Math.min(root.width - 64px, 760px);
            height: Math.min(root.height - 96px, 580px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: Db.gen-title; font-size: 14px; font-weight: 800; color: Theme.text; overflow: elide; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-gen-save; small: true; clicked => { Db.gen-save(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.od-close; small: true; clicked => { Db.gen-open = false; } }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextEdit {
                        width: 100%;
                        height: 100%;
                        read-only: true;
                        text: Db.gen-content;
                        font-size: 12px;
                        wrap: no-wrap;
                    }
                }
            }
        }
}
