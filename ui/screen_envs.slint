import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import {
    GraphNode, GraphEdge, SkillRow, EnvRow, ProjItem, OverItem, SkillAction, SshRow,
    LangItem, SnapRow, CommitRow, NotifItem, CmpFile, DbColumn, DbFkRow, DbIndexRow,
    DbTableRow,
} from "types.slint";
import {
    VerifiedCheck, Check, Btn, ThemeToggle, Bell, Collapse, Chip, TabBtn, StatePill,
    SkillName, AuthorCell, HomeCard, ReloadIcon, IconBtn,
} from "widgets.slint";
import { ProjectBar, Pager, GraphCanvas } from "chrome.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Aba ENVIRONMENTS (Mercado > 2) — runtimes de linguagem por método.
export component EnvsScreen inherits VerticalLayout {
            // texto-guia + botão recarregar
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: L.env-intro;
                            font-size: 12.5px;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            small: true;
                            clicked => { Cfg.refresh(); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    // Cada linha vem embrulhada: se `section-title` != "" ela ABRE uma
                    // seção (título "Linguagens" / "Ferramentas de dev", computado no
                    // Rust a partir do `category`), depois vem o card da linha.
                    for erow[ei] in Cfg.rows: VerticalLayout {
                        spacing: 12px;
                        if erow.section-title != "": Text {
                            text: erow.section-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-dim;
                        }
                        Rectangle {
                        height: 96px;
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            // linha 1: nome + status
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: erow.display;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 24px;
                                    width: stxt.preferred-width + 22px;
                                    border-radius: 12px;
                                    property <color> tone: erow.installed ? Theme.good : Theme.text-dim;
                                    background: tone.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: tone.transparentize(0.5);
                                    stxt := Text {
                                        text: erow.status-label;
                                        color: erow.installed ? Theme.good : Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {}
                                if erow.op-label != "": Text {
                                    text: erow.op-label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                            // linha 2 — LINGUAGEM: seletor de método (chips) + ações
                            if erow.category != "tool": HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-method;
                                        font-size: 12.5px;
                                        color: Theme.text-dim;
                                    }
                                }
                                if erow.methods.length == 0: VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-no-methods;
                                        font-size: 12.5px;
                                        color: Theme.warn;
                                    }
                                }
                                for m[mi] in erow.methods: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        label: m;
                                        selected: m == erow.method-sel;
                                        clicked => { Cfg.pick-method(ei, m); }
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-install;
                                        primary: true;
                                        small: true;
                                        enabled: erow.methods.length > 0 && erow.method-sel != "";
                                        clicked => { Cfg.install(ei); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-remove;
                                        danger: true;
                                        small: true;
                                        enabled: erow.installed;
                                        clicked => { Cfg.remove(ei); }
                                    }
                                }
                            }
                            // linha 2 — FERRAMENTA: sem seletor de método; mostra só o
                            // caminho de instalação (install-hint) + as ações.
                            if erow.category == "tool": HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: erow.install-hint;
                                        font-size: 12.5px;
                                        color: Theme.text-dim;
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-install;
                                        primary: true;
                                        small: true;
                                        enabled: !erow.installed;
                                        clicked => { Cfg.install(ei); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-remove;
                                        danger: true;
                                        small: true;
                                        enabled: erow.installed;
                                        clicked => { Cfg.remove(ei); }
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }
}
