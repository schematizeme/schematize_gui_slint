import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { Btn } from "widgets.slint";
import { Pager } from "chrome.slint";
import { Cfg, Od } from "state.slint";
import { SkillsAviso } from "panel_skills.slint";
import { FaixaDelegada } from "screen_delegado.slint";

// Tela OVERDEV (2) — o HUB do projeto. O trabalho do overdev (checklist, perguntas, execução,
// caixa, notas, histórico de snapshots, governador) mora na janela `schematize-overdev-gui`;
// aqui ficam só: o caminho até ela (faixa), as ações que as SKILLS declaram (contrato de
// terceiro, `acoes --json`), o aviso de skills atrasadas e os commits/upstream do projeto.
export component OverdevScreen inherits VerticalLayout {
    // JANELA do overdev: abrir/instalar + atalhos para cada aba dela.
    FaixaDelegada {
        rotulo-abrir: L.overdev-open;
        rotulo-ausente: L.overdev-missing;
        rotulo-instalar: L.overdev-install;
        rotulo-perguntas: L.overdev-aba-perguntas;
        rotulo-checklist: L.overdev-aba-checklist;
        rotulo-execucao: L.od-run;
        rotulo-caixa: L.od-caixa-title;
        rotulo-notas: L.od-notes-title;
        rotulo-historico: L.overdev-aba-historico;
        presente: Cfg.overdev-presente;
        cmd: Cfg.overdev-cmd;
        nota: Cfg.overdev-nota;
        msg: Cfg.overdev-msg;
        abrir => { Cfg.overdev-abrir(""); }
        abrir-aba(aba) => { Cfg.overdev-abrir(aba); }
        instalar => { Cfg.overdev-instalar(); }
    }
    // (seletor de projeto vive no CABEÇALHO, ao lado do "← Voltar")
    // Empty-state: nenhum projeto escolhido.
    if !Od.has-project: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            padding: 24px;
            Text {
                text: L.no-project;
                font-size: 13px;
                color: Theme.text-dim;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
    if Od.has-project: ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            // Ações declaradas por skills instaladas (Q.A., Pentest, Archive, Afazeres…) — aparecem
            // quando a skill tem gui.json. Contrato de TERCEIRO: o hub só desenha o botão.
            if Od.skill-actions.length > 0: VerticalLayout {
                spacing: 8px;
                Text { text: "Ações de skills"; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                HorizontalLayout {
                    spacing: 8px;
                    for a in Od.skill-actions: Btn {
                        label: a.label;
                        small: true;
                        enabled: !a.needs-project || Od.has-project;
                        clicked => { Od.run-skill-action(a.command); }
                    }
                    Rectangle {}
                }
            }
            // Atalhos do projeto que a janela não tem: afazeres do archive, painel HTML, terminal.
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn { label: L.od-gen-archive; small: true; primary: true; clicked => { Od.gen-from-archive(); } }
                Btn { label: L.open-browser; small: true; clicked => { Od.open-browser(); } }
                Btn { label: L.od-open-terminal; small: true; clicked => { Od.open-terminal(); } }
                Btn { label: L.g-reload; small: true; clicked => { Od.reload(); } }
            }
            if Od.run-status != "": Text {
                text: Od.run-status;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            // Skills atrasadas neste projeto (dado do `schematize-skills`) + "Rerodar skills".
            SkillsAviso { }
            // O histórico de SNAPSHOTS do DB é a aba «Histórico» da janela do overdev. Os COMMITS
            // (e a linha de upstream) são do hub: a janela não os porta.
            Rectangle { height: 1px; background: Theme.border; }
            VerticalLayout {
                spacing: 8px;
                Text { text: L.od-commits; font-size: 14px; font-weight: 800; color: Theme.text; }
                if Od.upstream-line != "": Text { text: Od.upstream-line; font-size: 12px; font-weight: 600; color: Theme.accent; }
                if Od.commits.length == 0: Text { text: L.od-commits-empty; font-size: 12px; color: Theme.text-dim; }
                for c[ci] in Od.commits: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: c.pushed ? "●" : "○"; font-size: 13px; color: c.pushed ? Theme.good : Theme.text-dim; }
                        }
                        VerticalLayout {
                            width: 70px;
                            alignment: center;
                            Text { text: c.short; font-size: 12px; color: Theme.accent; }
                        }
                        VerticalLayout {
                            width: 90px;
                            alignment: center;
                            Text { text: c.date; font-size: 11.5px; color: Theme.text-dim; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: c.subject; font-size: 12.5px; color: Theme.text; overflow: elide; }
                        }
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text { text: c.author; font-size: 11.5px; color: Theme.text-dim; overflow: elide; }
                        }
                    }
                }
                if Od.commit-total > 20: Pager {
                    page: Od.commit-page;
                    total: Od.commit-total;
                    prev => { Od.commit-page-prev(); }
                    next => { Od.commit-page-next(); }
                }
            }
            Rectangle { height: 6px; }
        }
    }
}
