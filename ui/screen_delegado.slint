import { Theme } from "theme.slint";
import { Btn } from "widgets.slint";

// TELA DELEGADA — este hub aponta para a janela do app dono, em vez de desenhar a tela dele.
//
// ## Por que existe um componente, e não uma tela por app (ADR-0012)
//
// O market e o deployer são apps à parte, com ícone e janela próprios. Enquanto este hub
// desenhava as telas deles, existiam DUAS telas do mesmo produto: uma aqui, lendo o crate do
// app no mesmo processo, e outra na janela dele. Duas telas do mesmo produto divergem — e este
// projeto já pagou por isso: as duas cópias de `environments/` haviam divergido, e a do hub
// ficou com a versão que RECUSAVA instalar o .NET no openSUSE enquanto a do market já sabia
// adicionar o repo do fornecedor.
//
// São TRÊS delegações — Mercado, Chaves SSH e Hosts — e um componente só. Com três telas
// parecidas, um conserto numa delas deixa as outras duas para trás, que é a forma exata do bug
// que este repo já teve no `run_app_install`.
//
// ## Janela ausente NÃO é botão que não faz nada
//
// Se ela não estiver instalada, a tela diz isso e oferece instalar — porque um botão que não
// faz nada e não explica é o que o §37.48 chama de bug do software, não erro de quem clicou.
export component TelaDelegada inherits VerticalLayout {
    in property <string> titulo;
    in property <string> corpo;
    in property <string> rotulo-abrir;
    in property <string> rotulo-ausente;
    in property <string> rotulo-instalar;
    // A janela do app dono está instalada? Resolvido no Rust ao subir — sem isto a tela
    // mostraria um botão que tenta abrir o que não existe e falha em silêncio.
    in property <bool> presente: false;
    // O comando de instalação, VISÍVEL: quem prefere o terminal não deveria ter de adivinhá-lo,
    // e quem for pedir ajuda tem o que colar.
    in property <string> cmd;
    // Aviso opcional sob o comando — para o que a pessoa precisa saber ANTES de rodá-lo (ex.:
    // «o repositório ainda não é público»). Vazio = nada a dizer.
    in property <string> nota;
    // O que aconteceu com o último clique.
    in property <string> msg;
    callback abrir();
    callback instalar();

    alignment: center;
    Rectangle {
        height: 100%;
        background: Theme.bg;
        VerticalLayout {
            alignment: center;
            padding: 40px;
            spacing: 18px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.titulo;
                    font-size: 22px;
                    font-weight: 800;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    max-width: 520px;
                    VerticalLayout {
                        Text {
                            text: root.corpo;
                            font-size: 13px;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.presente: HorizontalLayout {
                alignment: center;
                Btn {
                    label: root.rotulo-abrir;
                    primary: true;
                    clicked => { root.abrir(); }
                }
            }

            if !root.presente: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.rotulo-ausente;
                        font-size: 13px;
                        color: Theme.warn;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        label: root.rotulo-instalar;
                        primary: true;
                        clicked => { root.instalar(); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        max-width: 560px;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.cmd;
                                font-size: 12px;
                                font-family: "monospace";
                                color: Theme.text-dim;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if !root.presente && root.nota != "": HorizontalLayout {
                alignment: center;
                Text {
                    text: root.nota;
                    font-size: 12px;
                    color: Theme.warn;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.msg != "": HorizontalLayout {
                alignment: center;
                Text {
                    text: root.msg;
                    font-size: 12px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// FAIXA DELEGADA — a versão COMPACTA da [`TelaDelegada`], para quando a aba ainda tem conteúdo
// próprio e a janela do app dono cobre só PARTE dele (aba Overdev, E6 M5).
//
// Existe separada porque a `TelaDelegada` ocupa a tela inteira e centraliza: serve a quem saiu
// por completo. Aqui o estado é o mesmo — janela presente abre (com atalhos para as abas dela);
// ausente mostra o comando de instalação e a nota honesta — mas numa faixa no topo.
export component FaixaDelegada inherits Rectangle {
    in property <string> rotulo-abrir;
    in property <string> rotulo-ausente;
    in property <string> rotulo-instalar;
    in property <string> rotulo-perguntas;
    in property <string> rotulo-checklist;
    in property <string> rotulo-historico;
    in property <bool> presente: false;
    in property <string> cmd;
    in property <string> nota;
    in property <string> msg;
    callback abrir();
    callback abrir-aba(string);
    callback instalar();

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        if root.presente: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Btn { label: root.rotulo-abrir; primary: true; small: true; clicked => { root.abrir(); } }
            Btn { label: root.rotulo-perguntas; small: true; clicked => { root.abrir-aba("perguntas"); } }
            Btn { label: root.rotulo-checklist; small: true; clicked => { root.abrir-aba("checklist"); } }
            Btn { label: root.rotulo-historico; small: true; clicked => { root.abrir-aba("historico"); } }
        }
        if !root.presente: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Text { text: root.rotulo-ausente; font-size: 12.5px; color: Theme.warn; }
                }
                Btn { label: root.rotulo-instalar; primary: true; small: true; clicked => { root.instalar(); } }
            }
            Text {
                text: root.cmd;
                font-size: 11.5px;
                font-family: "monospace";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if root.nota != "": Text { text: root.nota; font-size: 11.5px; color: Theme.warn; wrap: word-wrap; }
        }
        if root.msg != "": Text { text: root.msg; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
    }
}
