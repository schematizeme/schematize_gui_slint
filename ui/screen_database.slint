import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import {
    GraphNode, GraphEdge, SkillRow, EnvRow, ProjItem, OverItem, SkillAction, SshRow,
    LangItem, SnapRow, CommitRow, NotifItem, CmpFile, DbColumn, DbFkRow, DbIndexRow,
    DbTableRow,
} from "types.slint";
import {
    VerifiedCheck, Check, Btn, ThemeToggle, Bell, Collapse, Chip, TabBtn, StatePill,
    SkillName, AuthorCell, HomeCard, ReloadIcon, IconBtn,
} from "widgets.slint";
import { ProjectBar, Pager, GraphCanvas } from "chrome.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Tela DATABASE BUILDER (6) — schema, formulários de tabela/coluna/FK,
// geração de SQL/migration e o grafo do schema.
export component DatabaseScreen inherits VerticalLayout {
            // cabeçalho: título + Carregar/Salvar schema.json (sempre visíveis).
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.db-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-load-json; small: true; clicked => { Db.load-json(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-save-json; small: true; enabled: Db.has-schema; clicked => { Db.save-json(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // sub-abas.
            Rectangle {
                height: 50px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    alignment: start;
                    TabBtn { label: L.db-sub-connect; active: Db.view == 0; clicked => { Db.view = 0; } }
                    TabBtn { label: L.db-sub-schema; active: Db.view == 1; clicked => { Db.view = 1; } }
                    TabBtn { label: L.db-sub-generate; active: Db.view == 2; clicked => { Db.view = 2; } }
                    TabBtn { label: L.db-sub-graph; active: Db.view == 3; clicked => { Db.view = 3; Db.show-graph(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // banners de status/erro (compartilhados).
            if Db.error != "": Rectangle {
                background: Theme.warn.transparentize(0.88);
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
                    Text { text: Db.error; font-size: 12px; font-weight: 600; color: Theme.warn; wrap: word-wrap; }
                }
            }
            if Db.error == "" && Db.status != "": Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
                    Text { text: Db.status; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                }
            }

            // ---- (0) CONECTAR + LER ----
            if Db.view == 0: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    // SQLite
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.db-sqlite-label; font-size: 14px; font-weight: 800; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                width: 380px;
                                placeholder-text: "/caminho/para/app.db";
                                text: Db.sqlite-path;
                                edited(s) => { Db.sqlite-path = s; }
                            }
                            VerticalLayout { alignment: center; Btn { label: L.db-pick-file; small: true; clicked => { Db.pick-sqlite(); } } }
                            VerticalLayout {
                                alignment: center;
                                Btn { label: L.db-introspect; small: true; primary: true; enabled: Db.sqlite-path != ""; clicked => { Db.introspect-sqlite(); } }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // Postgres
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.db-pg-label; font-size: 14px; font-weight: 800; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                width: 460px;
                                placeholder-text: "postgres://user:pass@host:5432/db";
                                text: Db.pg-conn;
                                edited(s) => { Db.pg-conn = s; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: Db.busy ? L.db-introspect + "…" : L.db-introspect;
                                    small: true; primary: true;
                                    enabled: Db.pg-conn != "" && !Db.busy;
                                    clicked => { Db.introspect-postgres(); }
                                }
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // ---- (1) VISUALIZAR/EDITAR O SCHEMA ----
            if Db.view == 1: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    // editor mínimo viável (adicionar tabela / coluna / FK).
                    Text { text: L.db-editor-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    // adicionar tabela.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit {
                            width: 220px;
                            placeholder-text: L.db-table-name;
                            text: Db.new-table;
                            edited(s) => { Db.new-table = s; }
                        }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-table; small: true; enabled: Db.new-table != ""; clicked => { Db.add-table(); } } }
                    }
                    // tabela alvo (para coluna/FK) — dropdown dos nomes atuais.
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; Text { text: L.db-select-table; font-size: 12px; font-weight: 700; color: Theme.text-dim; } }
                        Rectangle {
                            width: 220px;
                            height: 34px;
                            border-radius: 8px;
                            background: tsel.has-hover ? Theme.surface-2 : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 8px;
                                Text {
                                    text: Db.sel-table != "" ? Db.sel-table : "—";
                                    color: Db.sel-table != "" ? Theme.text : Theme.text-dim;
                                    font-size: 13.5px; font-weight: 600; vertical-alignment: center; overflow: elide;
                                }
                                Rectangle {}
                                Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            tsel := TouchArea { mouse-cursor: pointer; clicked => { tselpop.show(); } }
                            tselpop := PopupWindow {
                                close-policy: close-on-click-outside; // vide lgpop: ScrollView+close-on-click engole o clique
                                x: 0; y: parent.height + 4px; width: 220px;
                                Rectangle {
                                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                                    VerticalLayout {
                                        padding: 6px; spacing: 1px;
                                        if Db.table-names.length == 0: Text { text: L.db-no-schema; font-size: 12px; color: Theme.text-dim; }
                                        for tn[tni] in Db.table-names: Rectangle {
                                            height: 30px; border-radius: 6px;
                                            background: tnta.has-hover ? Theme.surface-2 : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text { text: tn; font-size: 13px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                            }
                                            tnta := TouchArea { mouse-cursor: pointer; clicked => { Db.pick-table(tn); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // adicionar coluna.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { width: 160px; placeholder-text: L.db-col-name; text: Db.new-col; edited(s) => { Db.new-col = s; } }
                        LineEdit { width: 130px; placeholder-text: L.db-col-type; text: Db.new-col-type; edited(s) => { Db.new-col-type = s; } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: Db.new-col-pk; toggled => { Db.new-col-pk = !Db.new-col-pk; } } VerticalLayout { alignment: center; Text { text: L.db-pk; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: Db.new-col-unique; toggled => { Db.new-col-unique = !Db.new-col-unique; } } VerticalLayout { alignment: center; Text { text: L.db-unique; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: Db.new-col-nullable; toggled => { Db.new-col-nullable = !Db.new-col-nullable; } } VerticalLayout { alignment: center; Text { text: L.db-nullable; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-column; small: true; enabled: Db.sel-table != "" && Db.new-col != ""; clicked => { Db.add-column(); } } }
                    }
                    // adicionar FK.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { width: 150px; placeholder-text: L.db-fk-col; text: Db.fk-col; edited(s) => { Db.fk-col = s; } }
                        LineEdit { width: 150px; placeholder-text: L.db-fk-reftable; text: Db.fk-reftable; edited(s) => { Db.fk-reftable = s; } }
                        LineEdit { width: 150px; placeholder-text: L.db-fk-refcol; text: Db.fk-refcol; edited(s) => { Db.fk-refcol = s; } }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-fk; small: true; enabled: Db.sel-table != "" && Db.fk-col != "" && Db.fk-reftable != ""; clicked => { Db.add-fk(); } } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // lista de tabelas.
                    Text { text: L.db-tables-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    if !Db.has-schema: Text { text: L.db-no-schema; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap; }
                    for t[ti] in Db.tables: Rectangle {
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: t.name; font-size: 15px; font-weight: 800; color: Theme.header-fg; }
                            // colunas
                            Text { text: L.db-cols-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for c[ci] in t.columns: HorizontalLayout {
                                spacing: 8px;
                                Text { text: c.name; font-size: 13px; font-weight: 600; color: Theme.text; }
                                Text { text: c.ty; font-size: 12.5px; color: Theme.text-dim; }
                                if c.pk: Text { text: "PK"; font-size: 11px; font-weight: 800; color: Theme.accent; }
                                if c.unique && !c.pk: Text { text: "UK"; font-size: 11px; font-weight: 800; color: Theme.good; }
                                if c.nullable: Text { text: "NULL"; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                                Rectangle {}
                            }
                            // FKs
                            if t.fks.length > 0: Text { text: L.db-fks-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for f[fi] in t.fks: Text {
                                text: f.column + " → " + f.ref-table + "." + f.ref-column;
                                font-size: 12.5px; color: Theme.text; wrap: word-wrap;
                            }
                            // índices
                            if t.indexes.length > 0: Text { text: L.db-indexes-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for ix[ixi] in t.indexes: Text {
                                text: (ix.unique ? "UNIQUE " : "") + ix.name + " (" + ix.columns-text + ")";
                                font-size: 12px; color: Theme.text-dim; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // ---- (2) GERAR ----
            if Db.view == 2: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.db-gen-sql; small: true; primary: true; enabled: Db.has-schema; clicked => { Db.gen-sql(); } }
                        Btn { label: L.db-gen-migration; small: true; enabled: Db.has-schema; clicked => { Db.gen-migration(); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // Gerar por descrição (IA).
                    Text { text: L.db-ai-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    Text { text: L.db-ai-note; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                    Rectangle {
                        height: 160px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            width: 100%; height: 100%;
                            text: Db.ai-desc;
                            font-size: 13px;
                            wrap: word-wrap;
                            edited(s) => { Db.ai-desc = s; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.db-ai-generate; small: true; primary: true; enabled: Db.ai-desc != ""; clicked => { Db.ai-generate(); } }
                    }
                    if Db.ai-status != "": Text { text: Db.ai-status; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                    Rectangle {}
                }
            }

            // ---- (3) GRAFO DO SCHEMA (mesmo GraphCanvas) ----
            if Db.view == 3: VerticalLayout {
                Rectangle {
                    height: 46px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 24px; spacing: 12px;
                        VerticalLayout { alignment: center; Text { text: Db.g-node-count + " " + L.g-nodes-suffix; font-size: 12.5px; color: Theme.text-dim; } }
                        Rectangle {}
                        VerticalLayout { alignment: center; Btn { label: L.g-fit; small: true; enabled: Db.g-has-graph; clicked => { Db.graph-fit(); } } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if !Db.g-has-graph: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center; padding: 24px;
                        Text { text: L.db-no-schema; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; horizontal-alignment: center; }
                    }
                }
                if Db.g-has-graph: GraphCanvas {
                    nodes: Db.graph-nodes;
                    edges: Db.graph-edges;
                    scale: Db.g-scale;
                    ox: Db.g-ox;
                    oy: Db.g-oy;
                    has-sel: Db.g-has-sel;
                    sel-id: Db.g-sel-id;
                    sel-desc: Db.g-sel-desc;
                    sel-loc: "";
                    show-loc: false;
                    nodesc-label: L.db-node-cols;
                    press(a, b) => { Db.graph-press(a, b); }
                    move(a, b) => { Db.graph-move(a, b); }
                    release => { Db.graph-release(); }
                    scroll(a, b, d) => { Db.graph-scroll(a, b, d); }
                    resized(w, h) => { Db.graph-canvas-resized(w, h); }
                    clear-sel => { Db.graph-clear-sel(); }
                }
            }
}
