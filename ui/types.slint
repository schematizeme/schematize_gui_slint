// Structs da FRONTEIRA Rust <-> UI: cada `struct` daqui vira um tipo gerado no
// Rust pelo `slint::include_modules!()` e é como uma linha de modelo trafega.

// ---------------------------------------------------------------------------
// schematize — GUI em Slint (migração incremental egui→Slint).
//
// O quê: DUAS páginas de topo — "Instaladas" e "Marketplace" — sobre o MESMO
// modelo de linhas (uma linha por skill + cabeçalhos de categoria). A página
// ativa filtra as linhas por ESTADO:
//   • Marketplace = skills NÃO instaladas (state == "missing") → descobrir/instalar.
//   • Instaladas  = skills instaladas (state != "missing")     → atualizar/desinstalar.
// Overdev/Grafo seguem como placeholders ("em breve").
//
// Selo verificado: um CHECK pequeno (círculo de acento + ✓), estilo Instagram/X,
// com tooltip no hover — SEM texto ao lado.
//
// i18n: NADA de texto hardcoded — toda string estática vem do `global L`,
// preenchido pelo Rust a partir de `schematize::i18n` (11 locales).
// ---------------------------------------------------------------------------


// ---- Grafo (aba 4) ----------------------------------------------------------
// Um nó do grafo force-directed. As posições (x/y) são MUNDO (não-tela) — a física
// vive no Rust e as escreve a cada tick; o Slint aplica a transformação global
// (g-scale/g-ox/g-oy + centro do canvas) na hora de renderizar. `r` é o raio EM
// PIXELS de tela (constante ao zoom, como no egui). `selected`/`hot`/`dim`
// controlam cor e realce; `has-loc` diz se o nó tem `arquivo:linha` (abrível).
export struct GraphNode {
    id: string,
    label: string,
    x: float,
    y: float,
    r: float,
    selected: bool,
    hot: bool,      // vizinho do selecionado OU casa com a busca
    dim: bool,      // apagado (fora do foco/da busca)
    has-loc: bool,
}
// Uma aresta: as duas pontas em coordenadas de MUNDO (o Slint transforma). `on`
// realça quando toca o nó selecionado.
export struct GraphEdge {
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    on: bool,
}

// Uma linha do modelo. Pode ser um CABEÇALHO de categoria (is-header) ou uma
// SKILL. Campos preenchidos/atualizados pelo Rust (catálogo + rede + ações).
export struct SkillRow {
    is-header: bool,
    header-label: string,
    // Cabeçalho: a QUAL página pertence (0 = Instaladas, 1 = Marketplace) e
    // quantas skills ele agrupa AGORA nessa página (0 → cabeçalho some).
    page: int,
    count: int,
    // Categoria (base/language/external) — usada pelo Rust p/ recontar os
    // cabeçalhos após instalar/desinstalar (skill muda de página).
    category: string,
    slug: string,
    author: string,
    author-url: string,
    installed: string,
    latest: string,
    state: string,        // "missing" | "outdated" | "current" | "loading"
    state-label: string,
    verified: bool,
    selected: bool,
    busy: bool,           // operação (instalar/remover) em andamento nesta linha
    op-label: string,     // status transitório da linha ("instalando…", erro…)
    op-error: bool,       // op-label é um erro? (colore em warn)
    disp: int,            // índice de exibição na página ativa (paginação); -1 fora da página
    forked: bool,         // skill oficial que virou FORK editável (marca [fork] + habilita Comparar)
    rating: string,       // nota do marketplace ("★4.7 (12)"); vazio = sem nota (preenchido async)
}

// Uma linha da aba Environments: uma LINGUAGEM ou FERRAMENTA de dev, seus métodos
// disponíveis nesta máquina, o método escolhido pra instalar, e o status.
// Preenchida pelo Rust a partir de `schematize::environments::status()`.
// `category` ("language" | "tool") separa as duas seções; ferramentas não têm
// seletor de método (methods vazio) — mostram só o `install-hint`.
export struct EnvRow {
    lang: string,           // slug ("go", "rust", "claude", ...) — vira o arg do `schematize env`
    display: string,        // nome de exibição ("Go", "C# / .NET", "Claude Code", ...)
    category: string,       // "language" (runtime) | "tool" (ferramenta de dev)
    install-hint: string,   // rótulo do caminho de instalação (ferramenta: "npm -g" / "official (curl|sh)")
    section-title: string,  // não-vazio → esta linha ABRE uma seção com este título ("Linguagens"/"Ferramentas de dev")
    methods: [string],      // métodos utilizáveis AQUI (docker|mise|distro|official); vazio p/ ferramenta
    method-sel: string,     // método escolhido pra instalar (chip selecionado)
    installed: bool,        // já instalado (por método detectado OU runtime no PATH)
    status-label: string,   // texto de status traduzido (instalado via X / instalado / não)
    op-label: string,       // mensagem transitória da linha (terminal aberto / erro)
}

// Uma entrada do seletor de projeto da aba Overdev: um CABEÇALHO de grupo
// (Detectados/Recentes) ou um PROJETO clicável. Preenchida pelo Rust a partir de
// `schematize::projects::scan()` (detectados) + `config::recent_projects()`.
export struct ProjItem {
    is-header: bool,
    label: string,    // cabeçalho: rótulo do grupo
    name: string,     // projeto: nome de exibição (basename)
    path: string,     // projeto: caminho absoluto (arg das ações)
    marker: string,   // projeto: marcador que o identificou (.git/.overdev/…)
}

// Um item do checklist 2-níveis do overdev: tipo + texto + origem + índice humano.
// `kind` decide cor/ícone: máquina "done"=✓verde / "open"=○ / "hold"=~amarelo;
// humano "hdone"=✓ / "hopen"=○ (marcável pela pessoa). `machine`=🤖 vs 👤.
// `hindex` = posição 1-based do item entre os HUMANOS ABERTOS (arg de od-mark-human);
// -1 para itens não-marcáveis.
export struct OverItem {
    // "done" | "open" | "hold" | "cancel"           (máquina)
    // "hopen" | "hdone" | "hresp" | "hrec"          (humano)
    // "nota"                                        (o texto da resposta/recusa)
    kind: string,
    text: string,
    machine: bool,    // true = item de MÁQUINA (agente) · false = item HUMANO
    hindex: int,      // hopen: 1-based entre humanos abertos · senão -1
    // Linha INDENTADA = subtask. É assim que uma pergunta parkeada aparece presa ao
    // item de máquina que ela trava, em vez de solta numa lista plana.
    sub: bool,
}

// Uma ação declarada por uma skill instalada (gui.json) — vira botão na aba do projeto.
// Preenchida pelo Rust a partir de `schematize::guiactions::gui_actions()`.
export struct SkillAction {
    label: string,        // rótulo do botão ("Q.A.", "Pentest")
    command: string,      // comando disparado no claude ("/eng-qa")
    needs-project: bool,  // só habilita com projeto selecionado
    skill: string,        // slug da skill dona
}

// Um idioma no seletor de Configurações (código + nome nativo + se é o atual).
export struct LangItem {
    code: string,
    name: string,
    current: bool,
}

// Uma linha do histórico do DB do overdev (snapshot). Preenchida pelo Rust a
// partir de `schematize::overdevdb::history()`. `id` é a chave de Ver/Restaurar.
export struct SnapRow {
    id: int,
    file: string,     // caminho relativo (ex.: .overdev/CHECKLIST.md)
    date: string,     // ts epoch formatado (AAAA-MM-DD hh:mm)
    size: string,     // tamanho legível
    hash: string,     // hash curto
}

// Uma linha do histórico de commits. Preenchida pelo Rust a partir de
// `schematize::githist::commits()`. `pushed` decide o marcador ● / ○.
export struct CommitRow {
    short: string,
    date: string,
    author: string,
    subject: string,
    pushed: bool,
}

// Uma notificação do sininho (mapeada de `schematize::notifications::Notif`).
// `scope` = "global" | "personal" (agrupador). `has-action` decide se mostra o
// botão de ação; `kind` decide o rótulo/efeito ("app_update"|"news"|"skill_outdated").
export struct NotifItem {
    // Id ESTÁVEL, derivado do conteúdo. Substitui o índice posicional: a lista é
    // reordenada a cada sincronização (não-lidas sobem, concluídas afundam), e um
    // índice resolveria a notificação errada depois de um refresh.
    id: string,
    scope: string,
    title: string,
    body: string,
    kind: string,
    action: string,
    has-action: bool,
    // "nova" | "lida" | "concluida" — decide o marcador e se vai pro histórico.
    estado: string,
}

// Um arquivo na comparação fork-ativo vs nova oficial (mapeado de `skills::FileDiff`).
// `status` = "igual" | "mudou" | "novo" | "removido" (texto já em pt-BR do lib).
export struct CmpFile {
    path: string,
    status: string,
}

// ---- Database (tela 6): os QUATRO structs saíram com a tela -----------------
//
// `DbColumn`, `DbFkRow`, `DbIndexRow` e `DbTableRow` espelhavam o `database::Schema` do crate.
// Eles foram embora junto com a tela e com o módulo (E1 M5 da extradição, ADR-0018): quem
// desenha schema agora é a janela do `schematize-database`, e ela lê o `--json` do binário
// dele em vez de compartilhar struct com ninguém.
//
// Tipo de UI que espelha struct de domínio é a costura que prende os dois: enquanto existia,
// mexer no `database::Schema` obrigava a mexer aqui, e o hub compilava o crate do banco só
// para desenhar uma tabela.

// Rótulos estáticos da UI — ponto único de injeção de i18n vindo do Rust.

// ---- Disco (tela 7) ---------------------------------------------------------
// Um TOTAL agregado — serve às duas visões de cima da tela (por disco e por tipo).
// Duas visões, um struct só: ambas são "um rótulo, um tamanho, e uma nota do que
// custa refazer". `note` é o texto já montado no Rust (traduzido/legível).
export struct DiscoTotal {
    label: string,     // ponto de montagem ("/") ou rótulo do tipo ("target (Rust)")
    size: string,      // tamanho já legível ("115,3 GB")
    note: string,      // "compila de novo" / "baixa de novo" / caminho do disco
    frac: float,       // 0..1 — fração do maior total, pra a barra proporcional
}

// Uma coisa apagável (espelha `disco::Achado`). `idx` é a posição na lista COMPLETA
// do lado Rust — a UI só recebe a página visível, então o índice do repeater não
// serve como argumento de ação.
export struct DiscoRow {
    idx: int,
    path: string,
    kind: string,      // rótulo do tipo ("target (Rust)")
    size: string,      // legível
    days: string,      // "49 dias parado"
    mount: string,     // disco em que mora
    refaz: string,     // como se refaz, em uma linha
    net: bool,         // refazer custa REDE (baixar) — senão é CPU (compilar)
    op-label: string,  // feedback transitório da linha ("apagando…" / erro)
    op-error: bool,
}

// Uma categoria do `docker system df` + a poda correspondente, se houver.
// `destructive` marca a poda de VOLUMES (volume é dado, não build).
export struct DockerRow {
    label: string,
    size: string,        // ocupado, legível
    reclaim: string,     // recuperável, legível
    prune: string,       // rótulo da poda (arg da ação); vazio = linha só informativa
    destructive: bool,
    op-label: string,
    op-error: bool,
}

// ---- Git (tela 8) -----------------------------------------------------------
// Uma conta cadastrada (espelha `gitcontas::contas::Conta`). SEM SEGREDO: só o
// NOME do arquivo de chave, nunca o conteúdo. `alias-ok` diz se o bloco do
// ~/.ssh/config já existe — é o que faz o push sair pela identidade certa.
// ---- Git (tela 8): os TRÊS structs saíram com a tela ------------------------
//
// `GitAccountRow`, `GitProjRow` e `GitRepoRow` espelhavam o domínio do git. Foram embora com a
// tela e com o módulo (E2 M5 da extradição, ADR-0019): quem desenha conta e repositório agora
// é a janela do `schematize-git`, e ela lê o `--json` do binário dele em vez de compartilhar
// struct com ninguém.



// Uma OPÇÃO clicável de um quiz do overdev.
//
// O `id` é o que a resposta grava; o `rotulo` é o texto do botão. Nunca se responde pelo
// rótulo: rótulo muda de redação, e uma resposta gravada não pode mudar de significado porque
// alguém melhorou uma frase.
export struct QuizOpcao {
    id: string,
    rotulo: string,
    detalhe: string,       // o que escolher isto significa; "" é aceitável em opção óbvia
    sugerida: bool,        // o agente RECOMENDA esta. Destaque, NUNCA pré-seleção.
    marcada: bool,         // o usuário marcou (só em `multipla`)
}

// Uma pergunta do overdev na tela.
//
// **Onde:** a aba Overdev (`screen_overdev.slint`), alimentada por `wire/quiz.rs` a partir de
// `schematize overdev questions --json`.
//
// **Por que `kind` é string e não enum:** ela vem do JSON do CLI, e o conjunto é fechado LÁ —
// um `kind` desconhecido já é recusado na leitura. Repetir o enum aqui criaria dois lugares
// para adicionar uma variante, e o esquecido desenharia pergunta sem botão.
export struct QuizItem {
    id: string,
    titulo: string,
    contexto: string,      // por que o agente perguntou, e o que muda em cada caminho
    kind: string,          // aprovar | escolha | multipla | sim_nao_outro | livre
    opcoes: [QuizOpcao],
    destrava: string,      // o que esta resposta libera, por extenso (não por número)
    // Estado. Os três são exclusivos, e o do meio existe por pedido explícito do usuário:
    // respondida NÃO é liberada até a máquina revisar.
    aberta: bool,
    aguarda_revisao: bool,
    resposta_texto: string,   // a resposta em linguagem de gente ("Tela própria")
    respondida_em: string,    // hora LOCAL de quando foi respondida ("24/09 20:59")
    revisao: string,          // o que a máquina concluiu ao ler
}
