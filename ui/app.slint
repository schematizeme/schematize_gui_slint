// ---------------------------------------------------------------------------
// schematize — GUI em Slint (migração incremental egui→Slint).
//
// O quê: DUAS páginas de topo — "Instaladas" e "Marketplace" — sobre o MESMO
// modelo de linhas (uma linha por skill + cabeçalhos de categoria). A página
// ativa filtra as linhas por ESTADO:
//   • Marketplace = skills NÃO instaladas (state == "missing") → descobrir/instalar.
//   • Instaladas  = skills instaladas (state != "missing")     → atualizar/desinstalar.
// Overdev/Grafo seguem como placeholders ("em breve").
//
// Selo verificado: um CHECK pequeno (círculo de acento + ✓), estilo Instagram/X,
// com tooltip no hover — SEM texto ao lado.
//
// i18n: NADA de texto hardcoded — toda string estática vem do `global L`,
// preenchido pelo Rust a partir de `schematize::i18n` (11 locales).
// ---------------------------------------------------------------------------

import { ScrollView } from "std-widgets.slint";

// Uma linha do modelo. Pode ser um CABEÇALHO de categoria (is-header) ou uma
// SKILL. Campos preenchidos/atualizados pelo Rust (catálogo + rede + ações).
export struct SkillRow {
    is-header: bool,
    header-label: string,
    // Cabeçalho: a QUAL página pertence (0 = Instaladas, 1 = Marketplace) e
    // quantas skills ele agrupa AGORA nessa página (0 → cabeçalho some).
    page: int,
    count: int,
    // Categoria (base/language/external) — usada pelo Rust p/ recontar os
    // cabeçalhos após instalar/desinstalar (skill muda de página).
    category: string,
    slug: string,
    author: string,
    author-url: string,
    installed: string,
    latest: string,
    state: string,        // "missing" | "outdated" | "current" | "loading"
    state-label: string,
    verified: bool,
    selected: bool,
    busy: bool,           // operação (instalar/remover) em andamento nesta linha
    op-label: string,     // status transitório da linha ("instalando…", erro…)
    op-error: bool,       // op-label é um erro? (colore em warn)
}

// Rótulos estáticos da UI — ponto único de injeção de i18n vindo do Rust.
export global L {
    in-out property <string> window-title: "schematize";
    in-out property <string> subtitle;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> check;
    in-out property <string> update-all;
    in-out property <string> update-installed-only; // texto-guia do "Atualizar tudo"
    in-out property <string> update-sel;
    in-out property <string> install-sel-market;
    in-out property <string> remove-sel;
    in-out property <string> sel-label;
    in-out property <string> sel-all;
    in-out property <string> sel-pending;
    in-out property <string> sel-none;
    in-out property <string> col-skill;
    in-out property <string> col-author;
    in-out property <string> col-installed;
    in-out property <string> col-latest;
    in-out property <string> col-state;
    in-out property <string> col-actions;
    in-out property <string> verified;   // tooltip do selo
    in-out property <string> tab-installed;
    in-out property <string> tab-marketplace;
    in-out property <string> tab-overdev;
    in-out property <string> tab-graph;
    in-out property <string> coming-soon;
    in-out property <string> act-install;
    in-out property <string> act-update;
    in-out property <string> act-remove;   // "Desinstalar" por-linha
}

// Paleta central — um único ponto de verdade para claro/escuro.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:        dark ? #14161c : #f4f6fb;
    out property <color> surface:   dark ? #1b1e27 : #ffffff;
    out property <color> surface-2: dark ? #222634 : #eef1f8;
    out property <color> stripe:    dark ? #1e222d : #f8fafd;
    out property <color> border:    dark ? #2b3040 : #dfe4ee;
    out property <color> text:      dark ? #e6e9f2 : #1a1e2b;
    out property <color> text-dim:  dark ? #8a90a2 : #6b7280;
    out property <color> accent:    #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #dfe8ff;
    out property <color> good:      #3ecf8e;
    out property <color> warn:      #e6b23a;
    out property <color> header-fg: dark ? #9db4ff : #3a5bd0;
}

// Selo verificado: check pequeno (círculo de acento + ✓) + tooltip no hover.
// Sem texto ao lado do nome — só o ícone (estilo Instagram/X).
component VerifiedCheck inherits Rectangle {
    in property <string> tip;
    width: 17px;
    height: 17px;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        Text {
            text: "✓";
            color: #ffffff;
            font-size: 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: default; }
    // tooltip flutuante (aparece no hover; pode transbordar a linha).
    if ta.has-hover: Rectangle {
        x: parent.width + 6px;
        y: (parent.height - self.height) / 2;
        height: 22px;
        width: tip-txt.preferred-width + 16px;
        border-radius: 6px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        tip-txt := Text {
            text: root.tip;
            color: Theme.text;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Checkbox próprio (controle total do visual + tema). Emite `toggled`.
component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: checked ? Theme.accent : Theme.text-dim;
    background: checked ? Theme.accent : transparent;
    opacity: enabled ? 1.0 : 0.4;
    animate background, border-color { duration: 120ms; }
    Text {
        text: "✓";
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        visible: root.checked;
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
}

// Botão de ação com estilo próprio (primário/secundário, normal/compacto).
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> small: false;
    in property <bool> danger: false;
    callback clicked();
    height: small ? 30px : 38px;
    border-radius: small ? 7px : 9px;
    background: primary
        ? (ta.has-hover && enabled ? #6f9bff : Theme.accent)
        : (ta.has-hover && enabled ? Theme.surface-2 : Theme.surface);
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.warn.transparentize(0.4) : Theme.border;
    opacity: enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.small ? 12px : 16px;
        padding-right: root.small ? 12px : 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: primary ? #ffffff : (danger ? Theme.warn : Theme.text);
            font-size: small ? 12.5px : 14px;
            font-weight: 600;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// Aba do topo (rótulo + marca de "em breve" para as ainda não implementadas).
component TabBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> soon: false;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.surface-2 : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: active ? Theme.header-fg : Theme.text-dim;
            font-size: 13.5px;
            font-weight: active ? 700 : 600;
        }
        if root.soon: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            width: soonlbl.preferred-width + 12px;
            border-radius: 9px;
            background: Theme.warn.transparentize(0.85);
            border-width: 1px;
            border-color: Theme.warn.transparentize(0.55);
            soonlbl := Text {
                text: L.coming-soon;
                color: Theme.warn;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Pill de estado (Atualizar / Em dia / carregando) — usada na página Instaladas.
component StatePill inherits Rectangle {
    in property <string> state;
    in property <string> label;
    property <color> tone:
        state == "missing"  ? Theme.warn :
        state == "outdated" ? Theme.accent : Theme.text-dim;
    width: txt.preferred-width + 22px;
    height: 24px;
    border-radius: 12px;
    background: tone.transparentize(0.85);
    border-width: 1px;
    border-color: tone.transparentize(0.5);
    txt := Text {
        text: root.label;
        color: root.tone;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Nome da skill + selo verificado (compartilhado pelas duas páginas).
component SkillName inherits HorizontalLayout {
    in property <string> slug;
    in property <bool> verified;
    spacing: 7px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.slug;
            font-size: 14.5px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
    }
    if root.verified: VerticalLayout {
        alignment: center;
        VerifiedCheck { tip: L.verified; }
    }
}

// Autor clicável (abre sponsor.url). Compartilhado pelas duas páginas.
component AuthorCell inherits Rectangle {
    in property <string> author;
    in property <string> author-url;
    callback clicked();
    height: 24px;
    HorizontalLayout {
        alignment: start;
        Text {
            text: root.author;
            font-size: 13.5px;
            color: root.author-url != "" ? Theme.accent : Theme.text-dim;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.author-url != "";
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: L.window-title;
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 820px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 14px;

    in property <[SkillRow]> rows;
    in-out property <string> status: "";
    in-out property <bool> busy: false;
    // 0 = Instaladas, 1 = Marketplace, 2 = Overdev (soon), 3 = Grafo (soon).
    in-out property <int> active-tab: 0;

    callback toggle(int);
    callback row-install(int);   // Marketplace: instalar a linha i
    callback row-update(int);    // Instaladas: atualizar a linha i (só se outdated)
    callback row-remove(int);    // Instaladas: desinstalar a linha i
    callback open-author(int);   // abrir sponsor.url da linha i
    callback install-selected(); // Marketplace: instalar selecionadas (missing)
    callback update-selected();  // Instaladas: atualizar selecionadas (outdated)
    callback remove-selected();  // Instaladas: desinstalar selecionadas (instaladas)
    callback update-all();       // Instaladas: atualizar TODAS as instaladas-desatualizadas
    callback check();            // rechecar versões (re-resolve latest)
    callback select-all();
    callback select-pending();
    callback select-none();

    VerticalLayout {
        // ---- cabeçalho -------------------------------------------------
        Rectangle {
            height: 76px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "schematize";
                        font-size: 24px;
                        font-weight: 800;
                        color: Theme.text;
                    }
                    Text {
                        text: L.subtitle;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                }
                Rectangle {}  // espaçador elástico
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: Theme.dark ? L.theme-light : L.theme-dark;
                        clicked => { Theme.dark = !Theme.dark; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- barra de abas --------------------------------------------
        Rectangle {
            height: 50px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                TabBtn {
                    label: L.tab-installed;
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                TabBtn {
                    label: L.tab-marketplace;
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                TabBtn {
                    label: L.tab-overdev;
                    soon: true;
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                TabBtn {
                    label: L.tab-graph;
                    soon: true;
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- placeholder das abas em breve ----------------------------
        if root.active-tab >= 2: Rectangle {
            background: Theme.bg;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: L.coming-soon;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text-dim;
                    }
                }
            }
        }

        // ---- páginas Instaladas (0) e Marketplace (1) -----------------
        if root.active-tab <= 1: VerticalLayout {
            // ---- barra de ações (difere por página) -----------------------
            Rectangle {
                height: 62px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;

                    // --- ações da página INSTALADAS ---
                    if root.active-tab == 0: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            // "Atualizar tudo": SÓ instaladas-desatualizadas. Nunca instala nova.
                            Btn {
                                label: L.update-all;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.update-all(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: L.update-installed-only;
                                font-size: 11px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.update-sel;
                                enabled: !root.busy;
                                clicked => { root.update-selected(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.remove-sel;
                                danger: true;
                                enabled: !root.busy;
                                clicked => { root.remove-selected(); }
                            }
                        }
                    }

                    // --- ações da página MARKETPLACE ---
                    if root.active-tab == 1: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.install-sel-market;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.install-selected(); }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            enabled: !root.busy;
                            clicked => { root.check(); }
                        }
                    }
                    Rectangle {}  // espaçador
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.sel-label;
                                    font-size: 12.5px;
                                    color: Theme.text-dim;
                                }
                            }
                            Btn { label: L.sel-all; small: true; enabled: !root.busy; clicked => { root.select-all(); } }
                            // "Selecionar pendentes" só faz sentido em Instaladas (desatualizadas).
                            if root.active-tab == 0: Btn { label: L.sel-pending; small: true; enabled: !root.busy; clicked => { root.select-pending(); } }
                            Btn { label: L.sel-none; small: true; enabled: !root.busy; clicked => { root.select-none(); } }
                        }
                    }
                }
            }
            // ---- linha de status/toast ------------------------------------
            Rectangle {
                height: 26px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    Text {
                        text: root.status;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- cabeçalho de colunas (difere por página) -----------------
            Rectangle {
                height: 34px;
                background: Theme.surface-2;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 0px;
                    Rectangle { width: 34px; }
                    Text { width: 260px; text: L.col-skill; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 170px; text: L.col-author; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 90px; text: L.col-installed; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 90px; text: L.col-latest; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 150px; text: L.col-state; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { text: L.col-actions; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ---- lista rolável (modelo único, filtrado por página) --------
            ScrollView {
                VerticalLayout {
                    padding-bottom: 16px;
                    spacing: 0px;
                    for row[i] in root.rows: Rectangle {
                        // Visível quando: cabeçalho da página ativa com itens,
                        // ou skill cujo ESTADO casa com a página ativa.
                        //   tab 0 (Instaladas)  → state != "missing"
                        //   tab 1 (Marketplace) → state == "missing"
                        property <bool> show: row.is-header
                            ? (row.count > 0 && root.active-tab == row.page)
                            : (root.active-tab == 0 ? row.state != "missing"
                               : root.active-tab == 1 ? row.state == "missing"
                               : false);
                        height: show ? (row.is-header ? 48px : 56px) : 0px;
                        visible: show;
                        background: row.is-header
                            ? Theme.bg
                            : (Math.mod(i, 2) == 0 ? Theme.stripe : Theme.bg);

                        // --- cabeçalho de categoria ---
                        if row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-top: 18px;
                            Text {
                                text: row.header-label;
                                font-size: 14px;
                                font-weight: 800;
                                color: Theme.header-fg;
                            }
                        }

                        // --- linha de skill ---
                        if !row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 0px;
                            // checkbox
                            VerticalLayout {
                                width: 34px;
                                alignment: center;
                                Check {
                                    checked: row.selected;
                                    enabled: !root.busy;
                                    toggled => { root.toggle(i); }
                                }
                            }
                            // skill + selo
                            VerticalLayout {
                                width: 260px;
                                alignment: center;
                                SkillName { slug: row.slug; verified: row.verified; }
                            }
                            // autor
                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                AuthorCell {
                                    author: row.author;
                                    author-url: row.author-url;
                                    clicked => { root.open-author(i); }
                                }
                            }

                            // ===== colunas + ações da página INSTALADAS =====
                            if root.active-tab == 0: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.installed; font-size: 13.5px; color: Theme.text; }
                                }
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    width: 150px;
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: start;
                                        StatePill { state: row.state; label: row.state-label; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        // Atualizar: habilitado só se desatualizada.
                                        Btn {
                                            label: L.act-update; small: true; primary: true;
                                            enabled: !root.busy && row.state == "outdated";
                                            clicked => { root.row-update(i); }
                                        }
                                        // Desinstalar sempre disponível numa instalada.
                                        Btn {
                                            label: L.act-remove; small: true; danger: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-remove(i); }
                                        }
                                    }
                                }
                            }

                            // ===== colunas + ação da página MARKETPLACE =====
                            if root.active-tab == 1: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Botão Instalar grande/óbvio.
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            label: L.act-install; primary: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-install(i); }
                                        }
                                    }
                                }
                            }
                        }

                        // separador fino sob cada skill visível
                        if !row.is-header && show: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border.transparentize(0.5);
                        }
                    }
                }
            }
        }
    }
}
