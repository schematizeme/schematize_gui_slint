// schematize — GUI em Slint. Este arquivo guarda a JANELA (AppWindow): o estado
// de tela, os callbacks que o Rust liga e a composição das telas.
//
// O resto foi separado por arquivo (piso da casa: <=750 linhas, uma unidade
// lógica por arquivo):
//   types.slint   — structs da fronteira Rust <-> UI
//   i18n.slint    — `global L` (toda string estática)
//   theme.slint   — `global Theme` (paleta claro/escuro)
//   widgets.slint — componentes de base (Btn, Chip, TabBtn, Collapse, …)
//   chrome.slint  — ProjectBar, Pager e GraphCanvas

import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import {
    GraphNode, GraphEdge, SkillRow, EnvRow, ProjItem, OverItem, SkillAction, SshRow,
    LangItem, SnapRow, CommitRow, NotifItem, CmpFile, DbColumn, DbFkRow, DbIndexRow,
    DbTableRow,
} from "types.slint";
import {
    VerifiedCheck, Check, Btn, ThemeToggle, Bell, Collapse, Chip, TabBtn, StatePill,
    SkillName, AuthorCell, HomeCard, ReloadIcon, IconBtn,
} from "widgets.slint";
import { ProjectBar, Pager, GraphCanvas } from "chrome.slint";

// Reexporta os globais que o RUST acessa (`app.global::<L>()`): só o que sai do
// arquivo de entrada aparece na API gerada.
export { L } from "i18n.slint";
export { Theme } from "theme.slint";

export component AppWindow inherits Window {
    title: L.window-title;
    // Ícone da janela DESENHADO EM CÓDIGO (`appicon::rgba`, o node-graph da casa) — resiliente: não
    // depende de arquivo (não some, não quebra o build). O launcher .desktop usa o mesmo via hicolor.
    icon: root.app-icon;
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 820px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 14px;

    // Logo da janela (barra de título/taskbar). Setada pelo Rust a partir de
    // `schematize::appicon::rgba(256)` — desenhada em código, resiliente.
    in property <image> app-icon;

    in property <[SkillRow]> rows;
    in-out property <string> status: "";
    in-out property <bool> busy: false;
    // Tela de topo (navegação principal do redesenho):
    //   0 = Home | 1 = Mercado (usa active-tab p/ sub-abas) | 2 = Overdev | 3 = Grafo.
    in-out property <int> screen: 0;
    // Sub-aba do Mercado: 0 = Instaladas, 1 = Marketplace, 2 = Environments.
    in-out property <int> active-tab: 0;
    // Modal de gestão dos diretórios de dev (aberto pela ProjectBar em Overdev/Grafo).
    in-out property <bool> dev-modal-open: false;

    // ---- aba Overdev ----
    in property <[ProjItem]> od-projects;      // seletor de projeto (detectados + recentes)
    in property <[string]> od-dev-dirs;         // diretórios de desenvolvimento cadastrados
    in property <[string]> od-pinned;           // pastas FIXADAS como projeto (pins)
    in-out property <string> od-current;         // nome do projeto atual ("" = nenhum)
    in-out property <bool> od-has-project: false;
    in-out property <bool> od-has-overdev: false;
    in-out property <string> od-objetivo;
    in-out property <string> od-mode;
    in-out property <int> od-done;
    in-out property <int> od-open;
    in-out property <int> od-hold;
    in-out property <int> od-human-open;         // humanos abertos (- [H ])
    in property <[OverItem]> od-items;           // SÓ a página corrente (o resto vive no Rust)
    // Checklist FATIADO: o repeater do Slint não é virtualizado, então a UI nunca
    // recebe mais de `checklist::PER_PAGE` itens — o custo de render é constante,
    // não cresce com o projeto.
    in-out property <int> od-cl-filter: 0;   // 0 todos · 1 abertos · 2 feitos · 3 on-hold · 4 humanos
    in-out property <int> od-cl-page: 0;     // página corrente (0-based)
    in-out property <int> od-cl-pages: 1;    // total de páginas sob o filtro
    in-out property <int> od-cl-total: 0;    // itens sob o filtro
    in-out property <int> od-cl-from: 0;     // 1-based do 1º item da página
    in-out property <int> od-cl-to: 0;       // 1-based do último item da página
    in-out property <string> od-decisoes;
    in-out property <string> od-plano;
    in-out property <string> od-perguntas;
    // editor de PLAN/CHECKLIST (Fase 3)
    in-out property <string> od-editor-target: "PLAN.md";  // arquivo em edição
    in-out property <string> od-editor-content;             // conteúdo editável
    in-out property <string> od-editor-status;              // feedback salvo/erro
    in-out property <bool> od-editor-error: false;          // o status é erro?
    in-out property <bool> od-editor-open: false;           // editor ABERTO (só aí o TextEdit existe)
    in-out property <bool> od-editor-too-big: false;        // arquivo acima do teto → só editor externo
    in-out property <string> od-editor-size;                // tamanho legível do arquivo grande
    // notas / correções (Fase 3)
    in-out property <string> od-notes;                      // read_notes(root)
    in-out property <string> od-note-input;                 // input de nota por task
    in-out property <string> od-correction-input;           // input do prompt de correção
    // ---- overdev em terminal externo + MONITOR leve (Fase 4) ----
    in-out property <bool> od-session-running: false;       // MONITOR ativo (claude roda fora do app)
    in-out property <bool> od-confirm-open: false;          // guardrail (mini-modal de confirmação) aberto
    in-out property <string> od-agent-cmdline;              // comando que abre no terminal externo (guardrail)
    in-out property <string> od-run-status;                 // msg do launch/monitor (vazio = ocioso)
    in-out property <int> od-run-done: 0;                   // monitor: feitos
    in-out property <int> od-run-open: 0;                   // monitor: abertos (máquina)
    in-out property <int> od-mon-human: 0;                  // monitor: humanos abertos (- [H ])
    in-out property <int> od-mon-hold: 0;                   // monitor: on-hold (- [~])
    in-out property <int> od-mon-iter: 0;                   // monitor: iterações gastas
    in-out property <int> od-mon-max: 0;                    // monitor: teto de iterações
    in-out property <string> od-mon-mode;                   // monitor: estado do run (active/stopped/…)
    in-out property <[string]> od-mon-items;                // monitor: itens abertos (máquina)
    in-out property <[string]> od-completions;              // monitor: log de conclusões ("HH:MM:SS  texto")
    in-out property <string> od-usage-line;                 // monitor: tokens+modelo já formatado (vazio = sem dado)

    // ---- aba Environments ----
    in property <[EnvRow]> env-rows;

    // ---- modal de instalação do Marketplace (dep opcional + environment opcional) ----
    in-out property <bool> mp-open: false;    // modal visível?
    in-out property <int> mp-idx: -1;          // linha (skill) sendo instalada
    in-out property <string> mp-title;          // "Instalar <slug>" (montado no Rust)
    in-out property <bool> mp-rec-show: false;  // oferecer a recomendada (base)?
    in-out property <string> mp-rec-label;       // "instalar também a <slug> (base)"
    in-out property <bool> mp-rec-check: false; // usuário marcou instalar a base? (default OFF)
    in-out property <bool> mp-env-show: false;  // oferecer o environment da linguagem?
    in-out property <string> mp-env-label;       // "instalar também o environment <lang>"
    in-out property <bool> mp-env-check: false; // usuário marcou instalar o environment?
    in property <[string]> mp-methods;          // métodos do environment disponíveis aqui
    in-out property <string> mp-method-sel;      // método escolhido (chip)

    // ---- aba Gerenciar (criar + editar skills) ----
    in-out property <int> mg-mode: 0;             // 0 = Criar, 1 = Editar
    // Criar
    in-out property <string> mg-slug;              // slug digitado (validado no Rust)
    in-out property <string> mg-name;              // nome humano
    in-out property <string> mg-desc;              // descrição densa
    in-out property <string> mg-slug-error;        // "" = ok; senão msg de slug inválido
    in-out property <string> mg-create-result;     // sucesso (caminho) ou erro
    in-out property <bool> mg-create-error: false; // o resultado é erro?
    in-out property <string> mg-created-slug;      // slug recém-criado (p/ "editar agora")
    // Editar
    in property <[string]> mg-skills;             // skills instaladas (slugs) p/ o dropdown
    in-out property <string> mg-sel-skill;         // skill escolhida ("" = nenhuma)
    in property <[string]> mg-files;              // arquivos editáveis da skill escolhida
    in-out property <string> mg-sel-file;          // arquivo escolhido ("" = nenhum)
    in-out property <string> mg-content;           // conteúdo do arquivo no editor
    in-out property <string> mg-save-result;       // feedback de salvo/erro
    in-out property <bool> mg-save-error: false;   // o feedback é erro?

    callback mg-refresh-skills();        // re-sonda as skills instaladas (dropdown)
    callback mg-slug-edited(string);     // valida o slug digitado
    callback mg-create();                // scaffold(slug, nome, desc)
    callback mg-edit-created();          // pula pro modo Editar com a skill recém-criada
    callback mg-pick-skill(string);      // escolhe uma skill → lista os arquivos
    callback mg-pick-file(string);       // escolhe um arquivo → carrega o conteúdo
    callback mg-save();                  // write_file(skill, arquivo, conteúdo)

    // ==================== Tela SSH (chaves) ====================
    in property <[SshRow]> ssh-rows;
    in-out property <string> ssh-gen-name;
    in-out property <string> ssh-gen-kind: "ed25519";   // "ed25519" | "rsa"
    in-out property <string> ssh-gen-comment;
    in-out property <string> ssh-gen-passphrase;
    in-out property <string> ssh-gen-status;
    in-out property <bool> ssh-gen-error: false;
    in-out property <string> ssh-gen-proof;              // prova (bits·fingerprint·tipo) da chave recém-gerada
    in-out property <string> ssh-bw-result;              // resultado da exportação p/ Bitwarden (banner)
    in-out property <bool> ssh-bw-error: false;          // ssh-bw-result é erro?
    in-out property <bool> ssh-confirm-open: false;      // modal de confirmação de remoção
    in-out property <string> ssh-confirm-name;
    in-out property <string> ssh-confirm-msg;
    callback ssh-generate();
    callback ssh-export-bw(int);     // exportar a chave da linha i p/ o Bitwarden (thread)
    callback ssh-copy(int);          // copiar pública da linha i
    callback ssh-remove-request(int);// abrir confirmação de remoção da linha i
    callback ssh-remove-confirm();   // remove de fato
    callback ssh-remove-cancel();
    callback ssh-refresh();

    // ==================== Tela Configurações ====================
    in property <[LangItem]> cfg-langs;
    in-out property <string> cfg-lang-code;   // código do idioma atual
    in-out property <string> cfg-lang-name;   // nome nativo do idioma atual
    in-out property <bool> cfg-autostart-on: false;
    in-out property <bool> cfg-hooks-on: false;
    callback cfg-set-lang(string);       // troca o idioma (persiste + recarrega L)
    callback cfg-toggle-autostart();
    callback cfg-toggle-hooks();
    callback cfg-manage-dirs();          // abre o modal de dev_dirs/pins
    // ---- Diagnóstico (relatório de debug) ----
    in-out property <bool> cfg-debug-online: false;  // incluir diagnóstico de rede (mais lento)
    in-out property <bool> cfg-debug-running: false; // geração em andamento (thread)
    in-out property <string> cfg-debug-path;          // caminho do arquivo gravado ("" = nenhum)
    in-out property <string> cfg-debug-summary;       // short_summary() do relatório
    in-out property <string> cfg-debug-error;         // erro ("" = nenhum)
    callback cfg-debug-generate();       // gera o relatório (write_report em thread)
    callback cfg-debug-open-folder();    // abre a pasta do relatório no gerenciador de arquivos
    callback cfg-debug-toggle-online();  // alterna o diagnóstico de rede

    // ==================== Overdev — aditivos ====================
    callback od-refresh-history();       // recarrega histórico do DB + commits do projeto atual
    in property <[SnapRow]> od-snaps;    // histórico do DB (página atual)
    in-out property <int> od-snap-page: 0;
    in-out property <int> od-snap-total: 0;
    callback od-snap-page-prev();
    callback od-snap-page-next();
    callback od-snap-view(int);          // Ver: get(id) → visor
    callback od-snap-restore-request(int);
    in-out property <bool> od-snap-confirm-open: false;
    in-out property <int> od-snap-confirm-id: -1;
    in-out property <string> od-snap-confirm-msg;
    callback od-snap-restore-confirm();
    callback od-snap-restore-cancel();
    in-out property <bool> od-snap-view-open: false;   // visor read-only
    in-out property <string> od-snap-view-title;
    in-out property <string> od-snap-view-content;
    in property <[CommitRow]> od-commits;
    in-out property <int> od-commit-page: 0;
    in-out property <int> od-commit-total: 0;
    in-out property <string> od-upstream-line;         // "main → origin/main · ↑2 ↓0"
    callback od-commit-page-prev();
    callback od-commit-page-next();

    // ==================== Paginação do Mercado ====================
    in-out property <int> mkt-page: 0;
    in-out property <int> mkt-total: 0;   // total de skills na página-tab ativa
    callback mkt-recompute();             // recomputa `disp` das linhas (troca de tab)

    callback toggle(int);
    callback row-install(int);   // Marketplace: instalar a linha i
    callback row-update(int);    // Instaladas: atualizar a linha i (só se outdated)
    callback row-remove(int);    // Instaladas: desinstalar a linha i
    callback open-author(int);   // abrir sponsor.url da linha i
    callback install-selected(); // Marketplace: instalar selecionadas (missing)
    callback update-selected();  // Instaladas: atualizar selecionadas (outdated)
    callback remove-selected();  // Instaladas: desinstalar selecionadas (instaladas)
    callback update-all();       // Instaladas: atualizar TODAS as instaladas-desatualizadas
    callback check();            // rechecar versões (re-resolve latest)
    callback select-all();
    callback select-pending();
    callback select-none();

    // ---- aba Environments ----
    callback env-install(int);        // instala o environment da linha i (abre TERMINAL)
    callback env-remove(int);         // remove o environment da linha i (abre TERMINAL)
    callback env-pick-method(int, string); // escolhe o método de instalação da linha i
    callback env-refresh();           // re-sonda a máquina e recarrega o status

    // ---- aba Overdev ----
    callback od-pick-project(string);  // escolhe um projeto (caminho) do seletor
    callback od-open-folder();          // abre pasta avulsa como projeto (picker nativo)
    callback od-open-project-folder();  // abre a pasta do projeto atual no gerenciador de arquivos
    callback od-open-vscode();          // abre o projeto atual no VSCode (code <root> / vscode://)
    callback od-reload();               // re-sonda dev_dirs + recarrega o projeto
    callback od-new-window();           // abre o projeto atual em nova janela (overdev em paralelo)
    callback od-gen-from-archive();     // GERA afazeres pro overdev do histórico recuperável do archive
    // ---- Split multiagent + governador de concorrência ----
    in-out property <int> od-agent-cap: 0;        // teto seguro de claudes na máquina
    in-out property <int> od-agent-avail: 0;      // disponível p/ lançar (teto − rodando)
    in-out property <int> od-agent-running: 0;    // claudes rodando na máquina agora
    in-out property <string> od-agent-load: "—";  // load average 1min (formatado)
    in-out property <int> od-split-k: 2;          // K do split (claudes principais)
    in-out property <string> od-split-status: ""; // feedback do último split
    callback od-split(int, bool);       // divide o checklist em K parts; bool = também lançar (dispatch)
    callback od-refresh-agents();       // recomputa o orçamento do governador
    // ---- Ações de skills instaladas (gui.json → botões: Q.A., Pentest, …) ----
    in property <[SkillAction]> skill-actions;
    callback run-skill-action(string);  // dispara o `command` da ação no claude de um terminal
    callback od-add-dev-dir();          // cadastra um diretório de desenvolvimento (picker)
    callback od-remove-dev-dir(string); // remove um diretório de desenvolvimento
    callback od-pin-folder();           // fixa uma pasta como projeto (picker nativo → pin_project)
    callback od-unpin(string);          // desafixa uma pasta fixada (unpin_project)
    callback od-open-browser();         // abre o painel HTML do projeto no navegador
    // ---- Fase 3: marcar-humano + editor + notas/correção ----
    callback od-mark-human(int);        // fecha o i-ésimo humano aberto (- [H ]→- [H x])
    callback od-cl-set-page(int);       // checklist fatiado: vai pra página N (0-based)
    callback od-cl-set-filter(int);     // checklist fatiado: troca o filtro (volta pra página 0)
    callback od-editor-toggle();        // abre/fecha o editor acoplado (e lê/descarta o conteúdo)
    callback od-editor-open-external(); // arquivo grande demais → abre no editor do sistema
    callback od-editor-pick(string);    // troca o arquivo do editor (PLAN.md/CHECKLIST.md)
    callback od-editor-save();          // regrava o arquivo do editor no .overdev/
    callback od-add-note(string);       // add_note(root,"task",texto) — ponto por task
    callback od-add-correction(string); // add_note(root,"correcao",texto) — prompt de correção
    // ---- Fase 4: agente acoplado (run/stop) ----
    callback od-run-request();          // clique "Executar overdev" → abre o guardrail (mostra o comando)
    callback od-run-confirm();          // clique "Confirmar" no guardrail → dispara o agente acoplado
    callback od-run-cancel();           // fecha o guardrail sem disparar
    callback od-stop();                 // "Parar" → session.kill() + encerra a thread
    callback od-attach();               // "Reload / Acompanhar" → anexa o monitor a um overdev externo
    callback od-refresh-tokens();       // "Atualizar tokens" → relê agent_usage sob demanda
    // ---- app ----
    callback restart();                 // relança o app (janela nova) — usado pós self-update

    // ==================== Versão do app + self-update ====================
    in property <string> app-version;                  // "schematize v0.25.1" (montado no Rust)
    in-out property <bool> app-checking: false;        // checagem de update em andamento
    in-out property <string> app-update-status;        // linha de resultado ("atualizado" / erro)
    in-out property <bool> updater-missing: false;     // o schematize-updater NÃO está instalado
    in-out property <bool> updater-installing: false;  // instalação do updater em andamento
    in-out property <string> updater-status;           // resultado da instalação do updater
    callback install-updater();                        // baixa+instala o schematize-updater
    in-out property <bool> app-has-update: false;      // há versão nova?
    in-out property <bool> app-updating: false;        // self-update em andamento
    in-out property <bool> app-update-done: false;     // update concluído → sugerir reiniciar
    callback app-check-update();                        // app_update_available() em thread
    callback app-do-update();                           // selfupdate::run() em thread

    // ==================== Sininho de notificações ====================
    in-out property <int> notif-count: 0;              // badge (notifications::count())
    in-out property <bool> notif-open: false;          // painel aberto?
    in-out property <bool> notif-loading: false;       // collect() em thread
    in-out property <int> notif-total: 0;              // total colhido (empty-state)
    in property <[NotifItem]> notif-global;            // notificações de escopo Global
    in property <[NotifItem]> notif-personal;          // notificações de escopo Pessoal
    callback notif-refresh();                           // só recomputa a contagem (thread)
    callback notif-toggle();                            // abre o painel + collect() (thread)
    callback notif-action(string, string);              // executa a ação (kind, action) da notificação

    // ==================== Fork na edição (Gerenciar) ====================
    in-out property <bool> mg-sel-official: false;     // a skill escolhida é OFICIAL (catálogo)?
    in-out property <bool> mg-sel-forked: false;       // já virou fork editável?

    // ==================== Comparar fork vs oficial ====================
    in-out property <bool> cmp-open: false;            // painel de comparação aberto?
    in-out property <bool> cmp-loading: false;         // compare_update() em thread
    in-out property <string> cmp-slug;                 // slug em comparação
    in-out property <string> cmp-title;                // "Comparar: <slug>"
    in-out property <string> cmp-versions;             // "base vX → nova vY"
    in-out property <string> cmp-error;                // erro (ou "")
    in-out property <string> cmp-diff;                 // diff unificado (visor mono read-only)
    in property <[CmpFile]> cmp-files;                 // arquivos + status
    callback cmp-request(string);                       // abre o painel + compare_update(slug) em thread
    callback cmp-close();                               // fecha o painel

    // ==================== Conta (login via device flow) ====================
    // Estado da sessão + do fluxo de login. O device flow roda em threads no Rust
    // (device_start + loop de poll); a UI só reflete e o loop é cancelável.
    in-out property <bool> acc-logged-in: false;        // há sessão persistida?
    in-out property <string> acc-sub;                   // subject do usuário logado
    in-out property <bool> acc-modal-open: false;       // modal do device flow aberto?
    in-out property <bool> acc-polling: false;          // login em andamento (device_start/poll)
    in-out property <string> acc-user-code;             // código a digitar no navegador (destaque)
    in-out property <string> acc-verification-uri;      // URL curta pra mostrar
    in-out property <string> acc-verification-uri-complete; // URL completa (botão "Abrir")
    in-out property <string> acc-status;                // erro/info (negado/expirado/falha)
    callback acc-login();                               // inicia o device flow (thread)
    callback acc-logout();                              // encerra a sessão + atualiza UI
    callback acc-cancel-login();                        // cancela o loop de poll + fecha o modal
    callback acc-open-verify();                         // abre a verification_uri_complete no navegador

    // ---- aba Grafo (força-dirigida nativa) ----
    // Estado da transformação (dono no Rust; o Slint só lê pra renderizar).
    in property <[GraphNode]> graph-nodes;
    in property <[GraphEdge]> graph-edges;
    in-out property <float> g-scale: 1.0;   // zoom
    in-out property <float> g-ox: 0;         // pan X (px de tela)
    in-out property <float> g-oy: 0;         // pan Y (px de tela)
    in-out property <bool> g-has-graph: false;
    in-out property <int> g-node-count: 0;
    in-out property <string> g-search;
    in-out property <bool> g-has-sel: false;
    in-out property <string> g-sel-id;
    in-out property <string> g-sel-loc;      // "" = nó sem arquivo:linha
    in-out property <string> g-sel-desc;     // descrição do nó (do índice/MAPA); "" = sem descrição
    in-out property <bool> g-in-service: false;  // true = vendo o grafo detalhado de UM microserviço
    in-out property <string> g-service-name;     // nome do serviço em drill-down (título da visão)
    in-out property <string> g-reindex-status; // banner: "índice rodando no terminal <nome>…" / erro
    // Ponteiro/roda → Rust (coords relativas ao canvas, em px). O Rust faz o
    // hit-test (mundo), decide pan-vs-arrasto-de-nó e escreve a transformação.
    callback graph-press(float, float);       // mouse-down (mx, my)
    callback graph-move(float, float);        // arrasto (mx, my)
    callback graph-release();                 // mouse-up
    callback graph-scroll(float, float, float); // zoom (mx, my, delta)
    callback graph-canvas-resized(float, float); // canvas mudou de tamanho (w, h)
    callback graph-fit();                     // enquadrar tudo
    callback graph-search-changed(string);    // busca digitada
    callback graph-open-editor();             // abre o arquivo:linha do nó selecionado
    callback graph-export();                  // exporta o vault Obsidian
    callback graph-open-browser();            // abre o painel HTML no navegador
    callback graph-reindex();                 // dispara o índice §39 num terminal externo (thread)
    callback graph-enter();             // aba Grafo aberta → carrega (se preciso) e liga a física
    callback graph-reload();                  // re-roda load_graph + node_descriptions e atualiza a UI
    callback graph-clear-sel();               // fecha o bloco de info do nó (deseleciona)
    callback graph-drill();                   // drill-down: abre o grafo detalhado do serviço selecionado
    callback graph-global();                  // volta da visão por-serviço para o grafo global

    // ==================== Database builder (tela 6) ====================
    // Sub-seção ativa: 0 = Conectar, 1 = Schema, 2 = Gerar, 3 = Grafo.
    in-out property <int> db-view: 0;
    in-out property <bool> db-has-schema: false;
    in-out property <string> db-status;                // banner de status (ok/info)
    in-out property <string> db-error;                 // banner de erro ("" = nenhum)
    in-out property <bool> db-busy: false;             // introspecção Postgres em andamento
    // Conectar
    in-out property <string> db-sqlite-path;           // caminho do arquivo SQLite (picker)
    in-out property <string> db-pg-conn;               // connection string Postgres
    // Schema carregado (tabelas → colunas/FKs/índices)
    in property <[DbTableRow]> db-tables;
    in property <[string]> db-table-names;             // nomes das tabelas (dropdown do editor)
    // Editor (form mínimo viável)
    in-out property <string> db-new-table;             // nome da nova tabela
    in-out property <string> db-sel-table;             // tabela alvo (coluna/FK)
    in-out property <string> db-new-col;               // nome da coluna
    in-out property <string> db-new-col-type: "TEXT";  // tipo da coluna
    in-out property <bool> db-new-col-pk: false;
    in-out property <bool> db-new-col-unique: false;
    in-out property <bool> db-new-col-nullable: false;
    in-out property <string> db-fk-col;                // FK: coluna local
    in-out property <string> db-fk-reftable;           // FK: tabela referenciada
    in-out property <string> db-fk-refcol;             // FK: coluna referenciada
    // Gerar (visor read-only)
    in-out property <bool> db-gen-open: false;
    in-out property <string> db-gen-title;
    in-out property <string> db-gen-content;
    // Gerar por descrição (IA)
    in-out property <string> db-ai-desc;               // descrição do domínio
    in-out property <string> db-ai-status;             // banner do disparo no terminal
    callback db-pick-sqlite();                          // picker nativo → db-sqlite-path
    callback db-introspect-sqlite();                    // introspect_sqlite(path) → schema
    callback db-introspect-postgres();                  // introspect_postgres(conn) em thread
    callback db-load-json();                            // picker → serde → schema
    callback db-save-json();                            // picker → serde → arquivo
    callback db-add-table();                            // append tabela vazia
    callback db-add-column();                           // append coluna à tabela alvo
    callback db-add-fk();                               // append FK à tabela alvo
    callback db-pick-table(string);                     // escolhe a tabela alvo do editor
    callback db-gen-sql();                              // to_sql → visor
    callback db-gen-migration();                        // to_migration → visor
    callback db-gen-save();                             // salva o conteúdo do visor num arquivo
    callback db-show-graph();                           // (re)constrói o grafo do schema atual
    callback db-ai-generate();                          // dispara a skill schematize-database num terminal
    // ---- grafo do schema (estado dedicado; NÃO colide com o grafo do índice) ----
    in property <[GraphNode]> db-graph-nodes;
    in property <[GraphEdge]> db-graph-edges;
    in-out property <float> db-g-scale: 1.0;
    in-out property <float> db-g-ox: 0;
    in-out property <float> db-g-oy: 0;
    in-out property <bool> db-g-has-graph: false;
    in-out property <int> db-g-node-count: 0;
    in-out property <bool> db-g-has-sel: false;
    in-out property <string> db-g-sel-id;
    in-out property <string> db-g-sel-desc;
    callback db-graph-press(float, float);
    callback db-graph-move(float, float);
    callback db-graph-release();
    callback db-graph-scroll(float, float, float);
    callback db-graph-canvas-resized(float, float);
    callback db-graph-fit();
    callback db-graph-clear-sel();

    // ---- modal de instalação do Marketplace ----
    callback mp-confirm();            // aplica: instala skill (+ base marcada) + (env em terminal se marcado)
    callback mp-cancel();             // fecha sem fazer nada
    callback mp-pick-method(string);  // escolhe o método do environment no modal
    callback mp-toggle-rec();         // liga/desliga instalar a recomendada
    callback mp-toggle-env();         // liga/desliga instalar o environment

    // Troca de sub-aba do Mercado → zera a paginação e recomputa os índices.
    changed active-tab => { root.mkt-page = 0; root.mkt-recompute(); }
    // Entrar na tela Overdev → recarrega o histórico (DB + commits) do projeto.
    changed screen => {
        if (root.screen == 2) { root.od-refresh-history(); }
        if (root.screen == 0) { root.notif-refresh(); }
        // A aba Grafo carrega o grafo e liga a física SÓ ao ser aberta — parsear o
        // índice e simular a 60 fps num projeto grande travava o app inteiro quando
        // isso acontecia junto com a escolha do projeto na aba Overdev.
        if (root.screen == 3) { root.graph-enter(); }
    }

    VerticalLayout {
        // ---- cabeçalho -------------------------------------------------
        Rectangle {
            height: 76px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 14px;
                // logo clicável — sempre volta pra Home.
                Rectangle {
                    width: logobox.preferred-width;
                    VerticalLayout {
                        alignment: center;
                        logobox := VerticalLayout {
                            alignment: center;
                            Text {
                                text: "schematize";
                                font-size: 22px;
                                font-weight: 800;
                                color: logota.has-hover ? Theme.header-fg : Theme.text;
                                animate color { duration: 120ms; }
                            }
                        }
                    }
                    logota := TouchArea { mouse-cursor: pointer; clicked => { root.screen = 0; } }
                }
                // breadcrumb: aparece fora da Home (clicável = voltar pra Home).
                if root.screen != 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        width: crumb.preferred-width + 22px;
                        border-radius: 8px;
                        background: crumbta.has-hover ? Theme.surface-2 : transparent;
                        animate background { duration: 120ms; }
                        crumb := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text { text: "←"; font-size: 15px; color: Theme.header-fg; vertical-alignment: center; }
                            Text {
                                text: "Voltar";
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.header-fg;
                                vertical-alignment: center;
                            }
                        }
                        crumbta := TouchArea { mouse-cursor: pointer; clicked => { root.screen = 0; } }
                    }
                }
                // Seletor de projeto + ícones INLINE no cabeçalho (Overdev/Grafo) — ao lado do Voltar.
                if root.screen == 2 || root.screen == 3: VerticalLayout {
                    alignment: center;
                    ProjectBar {
                        projects: root.od-projects;
                        current: root.od-current;
                        pick(p) => { root.od-pick-project(p); }
                        open-folder => { root.od-open-project-folder(); }
                        open-vscode => { root.od-open-vscode(); }
                        reload => { root.od-reload(); }
                        manage-dirs => { root.dev-modal-open = true; }
                        new-window => { root.od-new-window(); }
                    }
                }
                Rectangle {}  // espaçador elástico
                // indicador de sessão — pontinho verde clicável (vai pra Configurações),
                // com tooltip. Só aparece logado; leve, sem poluir o header.
                if root.acc-logged-in: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 26px;
                        height: 38px;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.good;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        accdotta := TouchArea { mouse-cursor: pointer; clicked => { root.screen = 5; } }
                        if accdotta.has-hover: Rectangle {
                            y: parent.height + 2px;
                            x: parent.width - self.width;
                            height: 22px;
                            width: acctip.preferred-width + 16px;
                            border-radius: 6px;
                            background: Theme.surface-2;
                            border-width: 1px;
                            border-color: Theme.border;
                            acctip := Text {
                                text: L.acc-indicator-tip;
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Versão em uso + bolinha de update quando há nova (sempre visível). Clica → Configurações.
                VerticalLayout {
                    alignment: center;
                    verchip := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.screen = 5; }
                        HorizontalLayout {
                            spacing: 5px;
                            Text {
                                text: root.app-version;
                                font-size: 11.5px;
                                font-weight: 600;
                                color: root.app-has-update ? Theme.header-fg : (verchip.has-hover ? Theme.text : Theme.text-dim);
                                vertical-alignment: center;
                            }
                            if root.app-has-update: Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: Theme.header-fg;
                                y: 3px;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Bell {
                        count: root.notif-count;
                        clicked => { root.notif-toggle(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ThemeToggle {
                        clicked => { Theme.dark = !Theme.dark; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- HOME (0) — escolha do que fazer (cards grandes) ----------
        // A cara do app deixa de ser "atualizar skills": abre aqui e o usuário
        // escolhe Overdev / Mercado / Grafo. Futuros ficam como placeholders.
        if root.screen == 0: VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 28px;
            padding-bottom: 28px;
            spacing: 22px;
            Text {
                text: L.home-title;
                font-size: 22px;
                font-weight: 800;
                color: Theme.text;
            }
            // linha 1 — destinos ativos
            HorizontalLayout {
                spacing: 18px;
                HomeCard {
                    title: L.tab-overdev;
                    desc: L.home-overdev-desc;
                    clicked => { root.screen = 2; }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M3 6h9 M3 12h9 M3 18h6 M15 6l2.2 2.2 4.3-4.3 M15 15l2.2 2.2 4.3-4.3";
                        fill: transparent; stroke: Theme.accent; stroke-width: 2px;
                    }
                }
                HomeCard {
                    title: L.home-market;
                    desc: L.home-market-desc;
                    clicked => { root.screen = 1; }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M5 8h14l-1.3 12H6.3z M9 8a3 3 0 0 1 6 0";
                        fill: transparent; stroke: Theme.accent; stroke-width: 2px;
                    }
                }
                HomeCard {
                    title: L.tab-graph;
                    desc: L.home-graph-desc;
                    clicked => { root.screen = 3; }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M7 7 L17 9 M7 7 L10 17 M17 9 L10 17 M4.8 7a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0 M14.8 9a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0 M7.8 17a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0";
                        fill: transparent; stroke: Theme.accent; stroke-width: 1.8px;
                    }
                }
                HomeCard {
                    title: L.home-database;
                    desc: L.home-database-desc;
                    clicked => { root.screen = 6; }
                    // cilindro de banco de dados (SVG inline — nunca emoji).
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M4 6a8 3 0 1 0 16 0a8 3 0 1 0-16 0 M4 6v12a8 3 0 0 0 16 0V6 M4 12a8 3 0 0 0 16 0";
                        fill: transparent; stroke: Theme.accent; stroke-width: 1.8px;
                    }
                }
            }
            // linha 2 — futuros (placeholders "em breve")
            HorizontalLayout {
                spacing: 18px;
                HomeCard {
                    title: L.home-environments;
                    desc: L.home-environments-desc;
                    clicked => { root.screen = 1; root.active-tab = 2; root.env-refresh(); }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M12 3l8 4.6v8.8L12 21l-8-4.6V7.6z M4.2 7.8L12 12l7.8-4.2 M12 12v9";
                        fill: transparent; stroke: Theme.text-dim; stroke-width: 1.8px;
                    }
                }
                HomeCard {
                    title: L.home-ssh;
                    desc: L.home-ssh-desc;
                    clicked => { root.screen = 4; root.ssh-refresh(); }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M3 5h18v14H3z M7 10l3 2.5-3 2.5 M13 15.5h5";
                        fill: transparent; stroke: Theme.accent; stroke-width: 1.8px;
                    }
                }
                HomeCard {
                    title: L.home-settings;
                    desc: L.home-settings-desc;
                    clicked => { root.screen = 5; }
                    Path {
                        width: 30px; height: 30px; viewbox-width: 24; viewbox-height: 24;
                        commands: "M4 12a8 8 0 1 0 16 0a8 8 0 1 0-16 0 M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0";
                        fill: transparent; stroke: Theme.accent; stroke-width: 1.8px;
                    }
                }
            }
            Rectangle {}  // empurra os cards pro topo
        }

        // ---- TELA SSH (4) — chaves SSH da máquina --------------------
        // Lista as chaves (só metadados PÚBLICOS), gera novos pares e copia a
        // pública / remove um par. A PRIVADA nunca é exposta (no máx. o caminho).
        if root.screen == 4: VerticalLayout {
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.ssh-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.ssh-priv-note; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.check; small: true; clicked => { root.ssh-refresh(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    // ---- formulário Gerar ----
                    Text { text: L.ssh-generate; font-size: 14px; font-weight: 800; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: L.ssh-name; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                            LineEdit {
                                width: 220px;
                                placeholder-text: L.ssh-name;
                                text: root.ssh-gen-name;
                                edited(s) => { root.ssh-gen-name = s; }
                            }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: L.ssh-kind; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                            HorizontalLayout {
                                spacing: 8px;
                                Chip { label: "ed25519"; selected: root.ssh-gen-kind == "ed25519"; clicked => { root.ssh-gen-kind = "ed25519"; } }
                                Chip { label: "rsa"; selected: root.ssh-gen-kind == "rsa"; clicked => { root.ssh-gen-kind = "rsa"; } }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: L.ssh-comment; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                            LineEdit {
                                width: 300px;
                                placeholder-text: L.ssh-comment;
                                text: root.ssh-gen-comment;
                                edited(s) => { root.ssh-gen-comment = s; }
                            }
                        }
                        VerticalLayout {
                            spacing: 5px;
                            Text { text: L.ssh-passphrase; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                            LineEdit {
                                width: 220px;
                                input-type: InputType.password;
                                placeholder-text: L.ssh-passphrase;
                                text: root.ssh-gen-passphrase;
                                edited(s) => { root.ssh-gen-passphrase = s; }
                            }
                        }
                    }
                    // Nota de entropia do tipo SELECIONADO (antes de gerar; atualiza ao trocar o
                    // chip) + a regra da casa (ed25519 default forte / RSA exige >= 4096).
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.ssh-gen-kind == "rsa" ? L.ssh-entropy-rsa : L.ssh-entropy-ed25519;
                            font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap;
                        }
                        Text {
                            text: L.ssh-kind-hint;
                            font-size: 11.5px; font-weight: 700; color: Theme.text; wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn {
                            label: L.ssh-generate; primary: true; small: true;
                            enabled: root.ssh-gen-name != "";
                            clicked => { root.ssh-generate(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            if root.ssh-gen-status != "": Text {
                                text: root.ssh-gen-status;
                                font-size: 12.5px; font-weight: 600;
                                color: root.ssh-gen-error ? Theme.warn : Theme.good;
                            }
                        }
                    }
                    // PROVA da chave recém-gerada (ssh-keygen -l): bits · fingerprint · tipo.
                    if root.ssh-gen-proof != "": Rectangle {
                        border-radius: 8px;
                        background: Theme.good.transparentize(0.9);
                        border-width: 1px;
                        border-color: Theme.good.transparentize(0.6);
                        VerticalLayout {
                            padding: 10px;
                            spacing: 3px;
                            Text { text: L.ssh-proof-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            Text { text: root.ssh-gen-proof; font-size: 12.5px; color: Theme.text; wrap: word-wrap; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- lista de chaves ----
                    Text { text: L.ssh-keys-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    // Exportar p/ Bitwarden — nota de segurança + resultado da última exportação.
                    Text { text: L.ssh-bw-note; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                    if root.ssh-bw-result != "": Rectangle {
                        border-radius: 8px;
                        background: root.ssh-bw-error ? Theme.warn.transparentize(0.88) : Theme.good.transparentize(0.9);
                        border-width: 1px;
                        border-color: root.ssh-bw-error ? Theme.warn.transparentize(0.6) : Theme.good.transparentize(0.6);
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.ssh-bw-result;
                                font-size: 12px; wrap: word-wrap;
                                color: root.ssh-bw-error ? Theme.warn : Theme.text;
                            }
                        }
                    }
                    if root.ssh-rows.length == 0: Text {
                        text: L.ssh-empty; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap;
                    }
                    for k[ki] in root.ssh-rows: Rectangle {
                        height: 92px;
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: k.name; font-size: 14.5px; font-weight: 700; color: Theme.text; }
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 22px;
                                    width: ktxt.preferred-width + 18px;
                                    border-radius: 11px;
                                    background: Theme.accent.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: Theme.accent.transparentize(0.5);
                                    ktxt := Text {
                                        text: k.kind; color: Theme.accent; font-size: 11px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                Rectangle {}
                                if k.op-label != "": VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: k.op-label; font-size: 12px; font-weight: 600;
                                        color: k.op-error ? Theme.warn : Theme.good;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { label: L.ssh-export-bw; small: true; clicked => { root.ssh-export-bw(ki); } }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { label: L.ssh-copy-pub; small: true; clicked => { root.ssh-copy(ki); } }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { label: L.ssh-remove; small: true; danger: true; clicked => { root.ssh-remove-request(ki); } }
                                }
                            }
                            if k.comment != "": Text { text: k.comment; font-size: 12px; color: Theme.text-dim; overflow: elide; }
                            Text { text: k.fingerprint; font-size: 11.5px; color: Theme.text-dim; overflow: elide; }
                        }
                    }
                    Rectangle {}
                }
            }
        }

        // ---- TELA CONFIGURAÇÕES (5) ---------------------------------
        // Idioma (troca ao vivo), tema, autostart do agente, hooks do overdev,
        // e atalho pro modal de diretórios de dev / projetos fixados.
        if root.screen == 5: VerticalLayout {
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.cfg-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;
                    // ---- conta (login pela plataforma via device flow) ----
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.acc-section; font-size: 14px; font-weight: 800; color: Theme.text; }
                        // logado: "Conectado como <sub>" + Sair.
                        if root.acc-logged-in: HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "\{L.acc-connected-as} \{root.acc-sub}";
                                    font-size: 13.5px; font-weight: 700; color: Theme.text; overflow: elide;
                                }
                            }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                Btn { label: L.acc-logout; small: true; danger: true; clicked => { root.acc-logout(); } }
                            }
                        }
                        // deslogado: descrição + "Entrar na plataforma".
                        if !root.acc-logged-in: HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.acc-logged-out-hint;
                                    font-size: 12px; color: Theme.text-dim; wrap: word-wrap;
                                }
                            }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: L.acc-login; small: true; primary: true;
                                    enabled: !root.acc-polling;
                                    clicked => { root.acc-login(); }
                                }
                            }
                        }
                        if !root.acc-modal-open && root.acc-status != "": Text {
                            text: root.acc-status;
                            font-size: 12px; font-weight: 600; color: Theme.warn; wrap: word-wrap;
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- versão do app + self-update ----
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.app-version-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.app-version; font-size: 13.5px; font-weight: 700; color: Theme.text; }
                            }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: root.app-checking ? L.app-checking : L.app-check-update;
                                    small: true;
                                    enabled: !root.app-checking && !root.app-updating;
                                    clicked => { root.app-check-update(); }
                                }
                            }
                        }
                        // Gestor de atualizações ausente → pede pra instalar (na abertura o app seta
                        // updater-missing). Cobre instalação limpa E update: sem ele, o update central falha.
                        if root.updater-missing: Rectangle {
                            background: Theme.surface-2;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    text: L.updater-missing-msg;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                if root.updater-status != "": Text {
                                    text: root.updater-status;
                                    font-size: 12px;
                                    color: Theme.text-dim;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Btn {
                                        label: root.updater-installing ? L.app-updating : L.updater-install-btn;
                                        primary: true;
                                        small: true;
                                        enabled: !root.updater-installing;
                                        clicked => { root.install-updater(); }
                                    }
                                }
                            }
                        }
                        // resultado da checagem (atualizado / erro / nova versão).
                        if root.app-update-status != "": Text {
                            text: root.app-update-status;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: root.app-has-update ? Theme.header-fg : Theme.text-dim;
                            wrap: word-wrap;
                        }
                        // há update → botão Atualizar app (ou hint de reiniciar quando pronto).
                        if root.app-has-update && !root.app-update-done: HorizontalLayout {
                            alignment: start;
                            Btn {
                                label: root.app-updating ? L.app-updating : L.app-update-btn;
                                primary: true;
                                small: true;
                                enabled: !root.app-updating;
                                clicked => { root.app-do-update(); }
                            }
                        }
                        if root.app-update-done: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Text { text: L.app-restart-hint; font-size: 12.5px; font-weight: 600; color: Theme.good; wrap: word-wrap; }
                            }
                            Btn { label: L.app-restart; small: true; primary: true; clicked => { root.restart(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- idioma ----
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.cfg-language; font-size: 14px; font-weight: 800; color: Theme.text; }
                        Rectangle {
                            width: 260px;
                            height: 34px;
                            border-radius: 8px;
                            background: lgdd.has-hover ? Theme.surface-2 : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: root.cfg-lang-name != "" ? root.cfg-lang-name : root.cfg-lang-code;
                                    color: Theme.text; font-size: 13.5px; font-weight: 600;
                                    vertical-alignment: center; overflow: elide;
                                }
                                Rectangle {}
                                Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            lgdd := TouchArea { mouse-cursor: pointer; clicked => { lgpop.show(); } }
                            lgpop := PopupWindow {
                                // Sem isto, a política padrão `close-on-click` fecha o popup no PRESS e
                                // o Flickable do ScrollView engole o gesto — o `clicked` (release) do
                                // item nunca dispara e o idioma não troca. `close-on-click-outside`
                                // só fecha ao clicar FORA, deixando o clique no item chegar ao callback.
                                close-policy: close-on-click-outside;
                                x: 0;
                                y: parent.height + 4px;
                                width: 260px;
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 10px;
                                    ScrollView {
                                        height: 280px;
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 1px;
                                            for lg[lgi] in root.cfg-langs: Rectangle {
                                                height: 30px;
                                                border-radius: 6px;
                                                background: lg.current
                                                    ? Theme.accent-soft
                                                    : (lgita.has-hover ? Theme.surface-2 : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    Text {
                                                        text: lg.name;
                                                        font-size: 13px;
                                                        font-weight: lg.current ? 700 : 500;
                                                        color: lg.current ? Theme.header-fg : Theme.text;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                                lgita := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.cfg-set-lang(lg.code); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- tema ----
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: L.cfg-theme; font-size: 14px; font-weight: 800; color: Theme.text; }
                        }
                        Rectangle {}
                        ThemeToggle { clicked => { Theme.dark = !Theme.dark; } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- autostart do agente ----
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text { text: L.cfg-autostart; font-size: 14px; font-weight: 800; color: Theme.text; }
                            Text { text: L.cfg-autostart-desc; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Check { checked: root.cfg-autostart-on; toggled => { root.cfg-toggle-autostart(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- hooks do overdev ----
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text { text: L.cfg-hooks; font-size: 14px; font-weight: 800; color: Theme.text; }
                            Text { text: L.cfg-hooks-desc; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Check { checked: root.cfg-hooks-on; toggled => { root.cfg-toggle-hooks(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- diretórios de dev + projetos fixados ----
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text { text: L.cfg-dirs; font-size: 14px; font-weight: 800; color: Theme.text; }
                            Text { text: L.cfg-dirs-desc; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Btn { label: L.cfg-manage; small: true; clicked => { root.cfg-manage-dirs(); } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- diagnóstico (relatório de debug) ----
                    VerticalLayout {
                        spacing: 10px;
                        Text { text: L.cfg-debug-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                        // toggle: incluir diagnóstico de rede (mais lento).
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Check {
                                    checked: root.cfg-debug-online;
                                    enabled: !root.cfg-debug-running;
                                    toggled => { root.cfg-debug-toggle-online(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: L.cfg-debug-net; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap; }
                            }
                            Rectangle {}
                        }
                        HorizontalLayout {
                            alignment: start;
                            Btn {
                                label: root.cfg-debug-running ? L.cfg-debug-generating : L.cfg-debug-btn;
                                primary: true;
                                small: true;
                                enabled: !root.cfg-debug-running;
                                clicked => { root.cfg-debug-generate(); }
                            }
                        }
                        // erro → mensagem em warn.
                        if root.cfg-debug-error != "": Text {
                            text: root.cfg-debug-error;
                            font-size: 12.5px; font-weight: 600; color: Theme.warn; wrap: word-wrap;
                        }
                        // sucesso → caminho + resumo + Abrir pasta + nota.
                        if root.cfg-debug-path != "": VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "\{L.cfg-debug-saved} \{root.cfg-debug-path}";
                                font-size: 12.5px; font-weight: 600; color: Theme.good; wrap: word-wrap;
                            }
                            if root.cfg-debug-summary != "": Text {
                                text: root.cfg-debug-summary;
                                font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Btn { label: L.cfg-debug-open; small: true; clicked => { root.cfg-debug-open-folder(); } }
                            }
                            Text {
                                text: L.cfg-debug-note;
                                font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {}
                }
            }
        }

        // ---- TELA DATABASE BUILDER (6) ------------------------------
        // 4 capacidades: (1) conectar+ler (introspecção SQLite/Postgres),
        // (2) visualizar/editar o schema (+ carregar/salvar schema.json),
        // (3) gerar SQL/migration (visor) + gerar por descrição (IA no terminal),
        // (4) grafo do schema (tabela=nó, FK=aresta) no MESMO GraphCanvas.
        if root.screen == 6: VerticalLayout {
            // cabeçalho: título + Carregar/Salvar schema.json (sempre visíveis).
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.db-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-load-json; small: true; clicked => { root.db-load-json(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-save-json; small: true; enabled: root.db-has-schema; clicked => { root.db-save-json(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // sub-abas.
            Rectangle {
                height: 50px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    alignment: start;
                    TabBtn { label: L.db-sub-connect; active: root.db-view == 0; clicked => { root.db-view = 0; } }
                    TabBtn { label: L.db-sub-schema; active: root.db-view == 1; clicked => { root.db-view = 1; } }
                    TabBtn { label: L.db-sub-generate; active: root.db-view == 2; clicked => { root.db-view = 2; } }
                    TabBtn { label: L.db-sub-graph; active: root.db-view == 3; clicked => { root.db-view = 3; root.db-show-graph(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // banners de status/erro (compartilhados).
            if root.db-error != "": Rectangle {
                background: Theme.warn.transparentize(0.88);
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
                    Text { text: root.db-error; font-size: 12px; font-weight: 600; color: Theme.warn; wrap: word-wrap; }
                }
            }
            if root.db-error == "" && root.db-status != "": Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 24px; padding-right: 24px; padding-top: 8px; padding-bottom: 8px;
                    Text { text: root.db-status; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                }
            }

            // ---- (0) CONECTAR + LER ----
            if root.db-view == 0: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    // SQLite
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.db-sqlite-label; font-size: 14px; font-weight: 800; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                width: 380px;
                                placeholder-text: "/caminho/para/app.db";
                                text: root.db-sqlite-path;
                                edited(s) => { root.db-sqlite-path = s; }
                            }
                            VerticalLayout { alignment: center; Btn { label: L.db-pick-file; small: true; clicked => { root.db-pick-sqlite(); } } }
                            VerticalLayout {
                                alignment: center;
                                Btn { label: L.db-introspect; small: true; primary: true; enabled: root.db-sqlite-path != ""; clicked => { root.db-introspect-sqlite(); } }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // Postgres
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.db-pg-label; font-size: 14px; font-weight: 800; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                width: 460px;
                                placeholder-text: "postgres://user:pass@host:5432/db";
                                text: root.db-pg-conn;
                                edited(s) => { root.db-pg-conn = s; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: root.db-busy ? L.db-introspect + "…" : L.db-introspect;
                                    small: true; primary: true;
                                    enabled: root.db-pg-conn != "" && !root.db-busy;
                                    clicked => { root.db-introspect-postgres(); }
                                }
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // ---- (1) VISUALIZAR/EDITAR O SCHEMA ----
            if root.db-view == 1: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    // editor mínimo viável (adicionar tabela / coluna / FK).
                    Text { text: L.db-editor-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    // adicionar tabela.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit {
                            width: 220px;
                            placeholder-text: L.db-table-name;
                            text: root.db-new-table;
                            edited(s) => { root.db-new-table = s; }
                        }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-table; small: true; enabled: root.db-new-table != ""; clicked => { root.db-add-table(); } } }
                    }
                    // tabela alvo (para coluna/FK) — dropdown dos nomes atuais.
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout { alignment: center; Text { text: L.db-select-table; font-size: 12px; font-weight: 700; color: Theme.text-dim; } }
                        Rectangle {
                            width: 220px;
                            height: 34px;
                            border-radius: 8px;
                            background: tsel.has-hover ? Theme.surface-2 : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 8px;
                                Text {
                                    text: root.db-sel-table != "" ? root.db-sel-table : "—";
                                    color: root.db-sel-table != "" ? Theme.text : Theme.text-dim;
                                    font-size: 13.5px; font-weight: 600; vertical-alignment: center; overflow: elide;
                                }
                                Rectangle {}
                                Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            tsel := TouchArea { mouse-cursor: pointer; clicked => { tselpop.show(); } }
                            tselpop := PopupWindow {
                                close-policy: close-on-click-outside; // vide lgpop: ScrollView+close-on-click engole o clique
                                x: 0; y: parent.height + 4px; width: 220px;
                                Rectangle {
                                    background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                                    VerticalLayout {
                                        padding: 6px; spacing: 1px;
                                        if root.db-table-names.length == 0: Text { text: L.db-no-schema; font-size: 12px; color: Theme.text-dim; }
                                        for tn[tni] in root.db-table-names: Rectangle {
                                            height: 30px; border-radius: 6px;
                                            background: tnta.has-hover ? Theme.surface-2 : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px;
                                                Text { text: tn; font-size: 13px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                            }
                                            tnta := TouchArea { mouse-cursor: pointer; clicked => { root.db-pick-table(tn); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // adicionar coluna.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { width: 160px; placeholder-text: L.db-col-name; text: root.db-new-col; edited(s) => { root.db-new-col = s; } }
                        LineEdit { width: 130px; placeholder-text: L.db-col-type; text: root.db-new-col-type; edited(s) => { root.db-new-col-type = s; } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: root.db-new-col-pk; toggled => { root.db-new-col-pk = !root.db-new-col-pk; } } VerticalLayout { alignment: center; Text { text: L.db-pk; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: root.db-new-col-unique; toggled => { root.db-new-col-unique = !root.db-new-col-unique; } } VerticalLayout { alignment: center; Text { text: L.db-unique; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; HorizontalLayout { spacing: 6px; Check { checked: root.db-new-col-nullable; toggled => { root.db-new-col-nullable = !root.db-new-col-nullable; } } VerticalLayout { alignment: center; Text { text: L.db-nullable; font-size: 12px; color: Theme.text-dim; } } } }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-column; small: true; enabled: root.db-sel-table != "" && root.db-new-col != ""; clicked => { root.db-add-column(); } } }
                    }
                    // adicionar FK.
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { width: 150px; placeholder-text: L.db-fk-col; text: root.db-fk-col; edited(s) => { root.db-fk-col = s; } }
                        LineEdit { width: 150px; placeholder-text: L.db-fk-reftable; text: root.db-fk-reftable; edited(s) => { root.db-fk-reftable = s; } }
                        LineEdit { width: 150px; placeholder-text: L.db-fk-refcol; text: root.db-fk-refcol; edited(s) => { root.db-fk-refcol = s; } }
                        VerticalLayout { alignment: center; Btn { label: L.db-add-fk; small: true; enabled: root.db-sel-table != "" && root.db-fk-col != "" && root.db-fk-reftable != ""; clicked => { root.db-add-fk(); } } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // lista de tabelas.
                    Text { text: L.db-tables-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    if !root.db-has-schema: Text { text: L.db-no-schema; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap; }
                    for t[ti] in root.db-tables: Rectangle {
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: t.name; font-size: 15px; font-weight: 800; color: Theme.header-fg; }
                            // colunas
                            Text { text: L.db-cols-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for c[ci] in t.columns: HorizontalLayout {
                                spacing: 8px;
                                Text { text: c.name; font-size: 13px; font-weight: 600; color: Theme.text; }
                                Text { text: c.ty; font-size: 12.5px; color: Theme.text-dim; }
                                if c.pk: Text { text: "PK"; font-size: 11px; font-weight: 800; color: Theme.accent; }
                                if c.unique && !c.pk: Text { text: "UK"; font-size: 11px; font-weight: 800; color: Theme.good; }
                                if c.nullable: Text { text: "NULL"; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                                Rectangle {}
                            }
                            // FKs
                            if t.fks.length > 0: Text { text: L.db-fks-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for f[fi] in t.fks: Text {
                                text: f.column + " → " + f.ref-table + "." + f.ref-column;
                                font-size: 12.5px; color: Theme.text; wrap: word-wrap;
                            }
                            // índices
                            if t.indexes.length > 0: Text { text: L.db-indexes-label; font-size: 11px; font-weight: 700; color: Theme.text-dim; }
                            for ix[ixi] in t.indexes: Text {
                                text: (ix.unique ? "UNIQUE " : "") + ix.name + " (" + ix.columns-text + ")";
                                font-size: 12px; color: Theme.text-dim; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {}
                }
            }

            // ---- (2) GERAR ----
            if root.db-view == 2: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 18px;
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.db-gen-sql; small: true; primary: true; enabled: root.db-has-schema; clicked => { root.db-gen-sql(); } }
                        Btn { label: L.db-gen-migration; small: true; enabled: root.db-has-schema; clicked => { root.db-gen-migration(); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // Gerar por descrição (IA).
                    Text { text: L.db-ai-title; font-size: 14px; font-weight: 800; color: Theme.text; }
                    Text { text: L.db-ai-note; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                    Rectangle {
                        height: 160px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            width: 100%; height: 100%;
                            text: root.db-ai-desc;
                            font-size: 13px;
                            wrap: word-wrap;
                            edited(s) => { root.db-ai-desc = s; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.db-ai-generate; small: true; primary: true; enabled: root.db-ai-desc != ""; clicked => { root.db-ai-generate(); } }
                    }
                    if root.db-ai-status != "": Text { text: root.db-ai-status; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                    Rectangle {}
                }
            }

            // ---- (3) GRAFO DO SCHEMA (mesmo GraphCanvas) ----
            if root.db-view == 3: VerticalLayout {
                Rectangle {
                    height: 46px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 24px; spacing: 12px;
                        VerticalLayout { alignment: center; Text { text: root.db-g-node-count + " " + L.g-nodes-suffix; font-size: 12.5px; color: Theme.text-dim; } }
                        Rectangle {}
                        VerticalLayout { alignment: center; Btn { label: L.g-fit; small: true; enabled: root.db-g-has-graph; clicked => { root.db-graph-fit(); } } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if !root.db-g-has-graph: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        alignment: center; padding: 24px;
                        Text { text: L.db-no-schema; font-size: 13px; color: Theme.text-dim; wrap: word-wrap; horizontal-alignment: center; }
                    }
                }
                if root.db-g-has-graph: GraphCanvas {
                    nodes: root.db-graph-nodes;
                    edges: root.db-graph-edges;
                    scale: root.db-g-scale;
                    ox: root.db-g-ox;
                    oy: root.db-g-oy;
                    has-sel: root.db-g-has-sel;
                    sel-id: root.db-g-sel-id;
                    sel-desc: root.db-g-sel-desc;
                    sel-loc: "";
                    show-loc: false;
                    nodesc-label: L.db-node-cols;
                    press(a, b) => { root.db-graph-press(a, b); }
                    move(a, b) => { root.db-graph-move(a, b); }
                    release => { root.db-graph-release(); }
                    scroll(a, b, d) => { root.db-graph-scroll(a, b, d); }
                    resized(w, h) => { root.db-graph-canvas-resized(w, h); }
                    clear-sel => { root.db-graph-clear-sel(); }
                }
            }
        }

        // ---- barra de sub-abas do MERCADO (só na tela Mercado) --------
        if root.screen == 1: Rectangle {
            height: 50px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                TabBtn {
                    label: L.tab-installed;
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                TabBtn {
                    label: L.tab-marketplace;
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                TabBtn {
                    label: L.tab-environments;
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                TabBtn {
                    label: L.manage;
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; root.mg-refresh-skills(); }
                }
            }
        }
        if root.screen == 1: Rectangle { height: 1px; background: Theme.border; }

        // ---- aba GRAFO (4) — força-dirigida nativa ---------------------
        // Porta o graph_view + step_graph do egui: física em Rust num Timer, e o
        // Slint renderiza arestas (Path) e nós (Rectangle circular). Reusa o MESMO
        // seletor de projeto da aba Overdev (od-projects/od-current/od-pick-project)
        // — o projeto escolhido alimenta as DUAS abas.
        if root.screen == 3: VerticalLayout {
            // (seletor de projeto agora vive no CABEÇALHO)
            // ---- linha de ferramentas do grafo (busca + nº nós + ações) ----
            Rectangle {
                height: 50px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        gsearch := LineEdit {
                            width: 190px;
                            placeholder-text: L.g-search-hint;
                            text: root.g-search;
                            edited(s) => { root.graph-search-changed(s); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.g-node-count + " " + L.g-nodes-suffix;
                            font-size: 12.5px;
                            color: Theme.text-dim;
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        // "chama a skill que organiza o grafo" — roda o índice §39 num terminal externo.
                        Btn { label: L.g-reindex; small: true; enabled: root.od-has-project; clicked => { root.graph-reindex(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        // re-roda load_graph + node_descriptions e atualiza a UI (após reindexar).
                        Btn { label: L.g-reload; small: true; enabled: root.od-has-project; clicked => { root.graph-reload(); } }
                    }
                    // Drill-down: abre o grafo detalhado do microserviço selecionado (só na visão global,
                    // com um nó selecionado). Na visão por-serviço, vira o botão de VOLTAR ao global.
                    if !root.g-in-service: VerticalLayout {
                        alignment: center;
                        Btn { label: L.g-drill; small: true; enabled: root.g-has-sel; clicked => { root.graph-drill(); } }
                    }
                    if root.g-in-service: VerticalLayout {
                        alignment: center;
                        Btn { label: L.g-global; small: true; enabled: true; clicked => { root.graph-global(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.g-fit; small: true; enabled: root.g-has-graph; clicked => { root.graph-fit(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.g-export-obsidian; small: true; enabled: root.g-has-graph; clicked => { root.graph-export(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.open-browser; small: true; enabled: root.g-has-graph; clicked => { root.graph-open-browser(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // Banner do (re)index: mensagem de "índice rodando no terminal <nome>…" ou erro.
            if root.g-reindex-status != "": Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    Text {
                        text: root.g-reindex-status;
                        font-size: 12px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }
                }
            }

            // Empty-state: nenhum projeto escolhido.
            if !root.od-has-project: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: L.no-project;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            // Empty-state: projeto sem índice/grafo.
            if root.od-has-project && !root.g-has-graph: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: L.g-no-graph;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }

            // ---- canvas do grafo (componente reusável) ----
            if root.od-has-project && root.g-has-graph: GraphCanvas {
                nodes: root.graph-nodes;
                edges: root.graph-edges;
                scale: root.g-scale;
                ox: root.g-ox;
                oy: root.g-oy;
                has-sel: root.g-has-sel;
                sel-id: root.g-sel-id;
                sel-desc: root.g-sel-desc;
                sel-loc: root.g-sel-loc;
                show-loc: true;
                nodesc-label: L.g-node-nodesc;
                noloc-label: L.g-no-loc;
                open-editor-label: L.g-open-editor;
                press(a, b) => { root.graph-press(a, b); }
                move(a, b) => { root.graph-move(a, b); }
                release => { root.graph-release(); }
                scroll(a, b, d) => { root.graph-scroll(a, b, d); }
                resized(w, h) => { root.graph-canvas-resized(w, h); }
                clear-sel => { root.graph-clear-sel(); }
                open-editor => { root.graph-open-editor(); }
            }
        }

        // ---- aba OVERDEV (3) — seletor de projeto + view nativa --------
        // Porta o project_bar + overdev_view do egui: escolhe um projeto (detectados
        // pelos marcadores + recentes + pasta avulsa via picker nativo), gere os
        // dev_dirs, e renderiza o estado do overdev (objetivo, progresso, checklist
        // colorido, e as seções Decisões/Plano/Perguntas colapsáveis).
        if root.screen == 2: VerticalLayout {
            // (seletor de projeto agora vive no CABEÇALHO, ao lado do "← Voltar")
            // ---- conteúdo do overdev ----
            // Empty-state: nenhum projeto escolhido.
            if !root.od-has-project: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: L.no-project;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            // Empty-state: projeto sem run de overdev — oferece GERAR afazeres do archive recuperável.
            // Ações declaradas por skills instaladas (Q.A., Pentest, …) — aparecem quando a skill
            // tem gui.json. Visível sempre que há um projeto (com ou sem overdev).
            if root.od-has-project && !root.od-has-overdev && root.skill-actions.length > 0: VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 8px;
                Text {
                    text: "Ações de skills";
                    font-size: 12px; font-weight: 700; color: Theme.text-dim;
                }
                HorizontalLayout {
                    spacing: 8px;
                    for a in root.skill-actions: Btn {
                        label: a.label;
                        small: true;
                        enabled: !a.needs-project || root.od-has-project;
                        clicked => { root.run-skill-action(a.command); }
                    }
                    Rectangle {}
                }
            }
            if root.od-has-project && !root.od-has-overdev: VerticalLayout {
                alignment: center;
                spacing: 14px;
                padding: 24px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: L.no-overdev;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Btn {
                        label: L.od-gen-archive;
                        primary: true;
                        small: true;
                        enabled: root.od-has-project;
                        clicked => { root.od-gen-from-archive(); }
                    }
                }
                if root.od-run-status != "": HorizontalLayout {
                    alignment: center;
                    Text { text: root.od-run-status; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
            // Estado do overdev: objetivo + progresso + checklist + seções.
            if root.od-has-project && root.od-has-overdev: ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    // objetivo + pill de mode
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.od-objetivo;
                                font-size: 18px;
                                font-weight: 800;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                width: modetxt.preferred-width + 20px;
                                border-radius: 12px;
                                property <color> tone: root.od-mode == "active" ? Theme.good : Theme.text-dim;
                                background: tone.transparentize(0.85);
                                border-width: 1px;
                                border-color: tone.transparentize(0.5);
                                modetxt := Text {
                                    text: root.od-mode;
                                    color: parent.tone;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // progresso: feitos / máquina-abertos / on-hold / humanos-abertos
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        Text { text: "✓ \{root.od-done}"; font-size: 13.5px; font-weight: 700; color: Theme.good; }
                        Text { text: "○ \{root.od-open}"; font-size: 13.5px; font-weight: 700; color: Theme.text-dim; }
                        Text { text: "~ \{root.od-hold}"; font-size: 13.5px; font-weight: 700; color: Theme.warn; }
                        Text { text: "\{L.od-human} \{root.od-human-open}"; font-size: 13.5px; font-weight: 700; color: Theme.accent; }
                        Rectangle {}
                        Btn { label: L.open-browser; small: true; clicked => { root.od-open-browser(); } }
                    }
                    // ---- Fase 4: overdev em terminal externo + MONITOR leve ----
                    // O `claude` roda num terminal do sistema (processo próprio, RAM dele,
                    // fora do app). Aqui é só o botão de disparo + um monitor que relê o
                    // `.overdev/` a cada ~3s. O "não pare" é do Stop hook do overdev.
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        property <bool> od-show-monitor: root.od-session-running || root.od-mon-mode != "";
                        HorizontalLayout {
                            spacing: 12px;
                            Btn {
                                label: L.od-run;
                                primary: true;
                                small: true;
                                // só com .overdev/ presente E nenhum monitor ativo.
                                enabled: root.od-has-overdev && !root.od-session-running;
                                clicked => { root.od-run-request(); }
                            }
                            Btn {
                                label: L.od-stop;
                                small: true;
                                danger: true;
                                enabled: root.od-session-running;
                                clicked => { root.od-stop(); }
                            }
                            // Anexa o monitor a um overdev que já roda POR FORA (terminal),
                            // sem ter clicado "Executar overdev". Desligado enquanto um
                            // monitor deste app já está vivo (evita thread duplicada).
                            Btn {
                                label: L.od-attach;
                                small: true;
                                enabled: !root.od-session-running;
                                clicked => { root.od-attach(); }
                            }
                            // Regenera/complementa os afazeres do overdev a partir do histórico
                            // recuperável do archive (dispara a skill schematize-archive num
                            // terminal). Disponível MESMO com overdev já existente (antes só
                            // aparecia no empty-state), pra enriquecer o checklist a qualquer hora.
                            Btn {
                                label: L.od-gen-archive;
                                small: true;
                                enabled: root.od-has-project && !root.od-session-running;
                                clicked => { root.od-gen-from-archive(); }
                            }
                            // Atualizar tokens — relê o uso do run sob demanda, INLINE nos controles.
                            Btn {
                                label: L.od-refresh-tokens;
                                small: true;
                                enabled: root.od-has-overdev;
                                clicked => { root.od-refresh-tokens(); }
                            }
                            // pill de estado (active/parado) enquanto o monitor vive.
                            if root.od-session-running: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 22px;
                                    width: runtxt.preferred-width + 18px;
                                    border-radius: 11px;
                                    background: Theme.good.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: Theme.good.transparentize(0.5);
                                    runtxt := Text {
                                        text: root.od-mon-mode == "active" ? L.od-mon-active : L.od-running;
                                        color: Theme.good;
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {}
                            if root.od-run-status != "": VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.od-run-status;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // ---- 3 colunas: Ações de skills · Multiagents · Sistema ----
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            spacing: 16px;
                            // COL 1 — Ações de skills (Q.A., Pentest, … via gui.json)
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Text { text: "Ações de skills"; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for a in root.skill-actions: Btn {
                                        label: a.label;
                                        small: true;
                                        enabled: !a.needs-project || root.od-has-project;
                                        clicked => { root.run-skill-action(a.command); }
                                    }
                                    Rectangle {}
                                }
                            }
                            // COL 2 — Multiagents (split)
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Text { text: "Multiagents (split)"; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "dividir em"; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                                    Btn { label: "−"; small: true; enabled: root.od-split-k > 2; clicked => { root.od-split-k = max(2, root.od-split-k - 1); } }
                                    Text { text: "\{root.od-split-k}"; font-size: 15px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                    Btn { label: "+"; small: true; enabled: root.od-split-k < root.od-agent-cap; clicked => { root.od-split-k = min(root.od-agent-cap, root.od-split-k + 1); } }
                                    Btn { label: "Dividir"; small: true; enabled: root.od-has-overdev && !root.od-session-running; clicked => { root.od-split(root.od-split-k, false); } }
                                    Btn { label: "Dividir + lançar"; primary: true; small: true; enabled: root.od-has-overdev && !root.od-session-running && root.od-agent-avail >= root.od-split-k; clicked => { root.od-split(root.od-split-k, true); } }
                                    Rectangle {}
                                }
                                if root.od-split-status != "": Text { text: root.od-split-status; font-size: 11px; color: Theme.text-dim; wrap: word-wrap; }
                            }
                            // COL 3 — Sistema (governador de concorrência)
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "Sistema"; font-size: 12px; font-weight: 700; color: Theme.text-dim; }
                                Text { text: "teto \{root.od-agent-cap} · livre \{root.od-agent-avail}"; font-size: 12px; font-weight: 600; color: Theme.text; }
                                Text { text: "load \{root.od-agent-load} · \{root.od-agent-running} rodando"; font-size: 11.5px; color: Theme.text-dim; }
                                HorizontalLayout {
                                    Btn { label: L.g-reload; small: true; clicked => { root.od-refresh-agents(); } }
                                    Rectangle {}
                                }
                            }
                        }
                        // rótulo: o claude é um processo próprio num terminal externo.
                        if root.od-session-running: Text {
                            text: L.od-ext-terminal;
                            font-size: 11.5px;
                            font-weight: 600;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                        // contadores do monitor: feitos / abertos / humano / on-hold + iterações.
                        if od-show-monitor: HorizontalLayout {
                            spacing: 18px;
                            alignment: start;
                            Text { text: "✓ \{root.od-run-done}"; font-size: 13px; font-weight: 700; color: Theme.good; }
                            Text { text: "○ \{root.od-run-open}"; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                            Text { text: "\{L.od-human} \{root.od-mon-human}"; font-size: 13px; font-weight: 700; color: Theme.accent; }
                            Text { text: "~ \{root.od-mon-hold}"; font-size: 13px; font-weight: 700; color: Theme.warn; }
                            Rectangle {}
                            Text {
                                text: "\{L.od-mon-iters} \{root.od-mon-iter}/\{root.od-mon-max}";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.text-dim;
                            }
                        }
                        // barra de progresso (feitos / feitos+abertos) + percentual.
                        if od-show-monitor: HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                vertical-stretch: 0;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.surface-2;
                                Rectangle {
                                    x: 0;
                                    height: 100%;
                                    width: parent.width * root.od-run-done / max(1, root.od-run-done + root.od-run-open);
                                    border-radius: 4px;
                                    background: Theme.good;
                                    animate width { duration: 240ms; }
                                }
                            }
                            Text {
                                text: "\{round(100 * root.od-run-done / max(1, root.od-run-done + root.od-run-open))}%";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }
                        // lista dos itens abertos (máquina) — o que ainda trava o run.
                        if root.od-mon-items.length > 0: VerticalLayout {
                            spacing: 4px;
                            Text { text: L.od-mon-open-title; font-size: 12.5px; font-weight: 700; color: Theme.text-dim; }
                            for item in root.od-mon-items: HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text { text: "○"; font-size: 12px; font-weight: 800; color: Theme.text-dim; }
                                Text { text: item; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                        // Tokens + modelo (agent_usage) + botão pra reler sob demanda.
                        // A linha só aparece quando já houve uma leitura (evita "0" enganoso).
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            if root.od-usage-line != "": Text {
                                text: root.od-usage-line;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            Rectangle {}
                        }
                        // Log de CONCLUSÕES com data/hora (mais recentes embaixo). Atualiza
                        // junto com o monitor. Rola internamente (a aba já está num ScrollView).
                        if root.od-completions.length > 0: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "\{L.od-completions-title} (\{root.od-completions.length})";
                                font-size: 12.5px;
                                font-weight: 700;
                                color: Theme.text-dim;
                            }
                            ScrollView {
                                height: 150px;
                                VerticalLayout {
                                    spacing: 3px;
                                    for line in root.od-completions: HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text { text: "✓"; font-size: 12px; font-weight: 800; color: Theme.good; }
                                        Text { text: line; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // ---- checklist 2-níveis: barra de FILTRO + PAGINAÇÃO ----
                    // O repeater abaixo NÃO é virtualizado (limitação do Slint), então o
                    // Rust só entrega uma PÁGINA por vez. Sem isto, um projeto com 500+
                    // itens instancia milhares de elementos de uma vez e trava o app.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Chip { label: L.od-cl-all;   selected: root.od-cl-filter == 0; clicked => { root.od-cl-set-filter(0); } }
                        Chip { label: L.od-cl-open;  selected: root.od-cl-filter == 1; clicked => { root.od-cl-set-filter(1); } }
                        Chip { label: L.od-cl-done;  selected: root.od-cl-filter == 2; clicked => { root.od-cl-set-filter(2); } }
                        Chip { label: L.od-cl-hold;  selected: root.od-cl-filter == 3; clicked => { root.od-cl-set-filter(3); } }
                        Chip { label: L.od-cl-human; selected: root.od-cl-filter == 4; clicked => { root.od-cl-set-filter(4); } }
                    }
                    if root.od-cl-total == 0: Text {
                        text: L.od-cl-empty;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                    // itens HUMANOS ABERTOS ganham o botão "marcar como feito".
                    for it[ii] in root.od-items: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        // ícone de estado (✓ feito · ~ on-hold · ○ aberto)
                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: (it.kind == "done" || it.kind == "hdone") ? "✓" : it.kind == "hold" ? "~" : "○";
                                font-size: 13px;
                                font-weight: 800;
                                color: (it.kind == "done" || it.kind == "hdone") ? Theme.good
                                     : it.kind == "hold" ? Theme.warn
                                     : it.machine ? Theme.text-dim : Theme.accent;
                            }
                        }
                        // etiqueta de origem (MÁQUINA = agente · HUMANO = pessoa)
                        Rectangle {
                            y: 1px;
                            height: 18px;
                            width: tagtxt.preferred-width + 12px;
                            border-radius: 5px;
                            property <color> ttone: it.machine ? Theme.text-dim : Theme.accent;
                            background: ttone.transparentize(0.86);
                            border-width: 1px;
                            border-color: ttone.transparentize(0.6);
                            tagtxt := Text {
                                text: it.machine ? L.od-machine : L.od-human;
                                color: parent.ttone;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: it.text;
                            font-size: 13px;
                            color: (it.kind == "done" || it.kind == "hdone") ? Theme.good : Theme.text;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        // só o HUMANO ABERTO é marcável pela GUI (máquina é do agente)
                        if it.kind == "hopen": Btn {
                            label: L.od-mark-human;
                            small: true;
                            clicked => { root.od-mark-human(it.hindex); }
                        }
                    }
                    // navegação de páginas — só aparece quando há mais de uma.
                    if root.od-cl-pages > 1: HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Btn {
                            label: "‹";
                            small: true;
                            enabled: root.od-cl-page > 0;
                            clicked => { root.od-cl-set-page(root.od-cl-page - 1); }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "\{root.od-cl-from}–\{root.od-cl-to} \{L.od-cl-of} \{root.od-cl-total}";
                                font-size: 12.5px;
                                color: Theme.text-dim;
                            }
                        }
                        Btn {
                            label: "›";
                            small: true;
                            enabled: root.od-cl-page < root.od-cl-pages - 1;
                            clicked => { root.od-cl-set-page(root.od-cl-page + 1); }
                        }
                    }
                    Rectangle { height: 6px; }
                    // ---- editor acoplado de PLAN.md / CHECKLIST.md ----
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: L.od-editor; font-size: 14px; font-weight: 800; color: Theme.text; vertical-alignment: center; }
                            Rectangle {}
                            if root.od-editor-open: Btn {
                                label: "PLAN.md"; small: true;
                                primary: root.od-editor-target == "PLAN.md";
                                clicked => { root.od-editor-pick("PLAN.md"); }
                            }
                            if root.od-editor-open: Btn {
                                label: "CHECKLIST.md"; small: true;
                                primary: root.od-editor-target == "CHECKLIST.md";
                                clicked => { root.od-editor-pick("CHECKLIST.md"); }
                            }
                            // Abrir/fechar: o TextEdit do Slint faz layout do texto INTEIRO a
                            // cada medida, então ele só existe enquanto o editor está aberto.
                            Btn {
                                label: root.od-editor-open ? L.od-editor-hide : L.od-editor-show;
                                small: true;
                                clicked => { root.od-editor-toggle(); }
                            }
                        }
                        // arquivo acima do teto: não entra no TextEdit (travaria) — manda pro externo.
                        if root.od-editor-open && root.od-editor-too-big: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "\{L.od-editor-big} (\{root.od-editor-size})";
                                font-size: 12.5px;
                                color: Theme.warn;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Btn { label: L.od-editor-external; small: true; clicked => { root.od-editor-open-external(); } }
                            }
                        }
                        if root.od-editor-open && !root.od-editor-too-big: Rectangle {
                            height: 220px;
                            border-radius: 8px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextEdit {
                                width: 100%;
                                height: 100%;
                                text: root.od-editor-content;
                                wrap: word-wrap;
                                edited(s) => { root.od-editor-content = s; }
                            }
                        }
                        if root.od-editor-open && !root.od-editor-too-big: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Btn { label: L.od-save-plan; primary: true; small: true; clicked => { root.od-editor-save(); } }
                            if root.od-editor-status != "": Text {
                                text: root.od-editor-status;
                                font-size: 12.5px; font-weight: 600;
                                color: root.od-editor-error ? Theme.warn : Theme.good;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // ---- tarefas: adicionar um ponto/nota específico ----
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.od-tasks; font-size: 14px; font-weight: 800; color: Theme.text; }
                        Text { text: L.od-note; font-size: 12px; color: Theme.text-dim; }
                        Rectangle {
                            height: 66px; border-radius: 8px; background: Theme.surface;
                            border-width: 1px; border-color: Theme.border;
                            TextEdit {
                                width: 100%; height: 100%;
                                text: root.od-note-input;
                                wrap: word-wrap;
                                edited(s) => { root.od-note-input = s; }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Btn {
                                label: L.od-add-note; small: true;
                                enabled: root.od-note-input != "";
                                clicked => { root.od-add-note(root.od-note-input); root.od-note-input = ""; }
                            }
                        }
                    }
                    // ---- prompt de correção do overdev ----
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.od-correction; font-size: 14px; font-weight: 800; color: Theme.text; }
                        Rectangle {
                            height: 66px; border-radius: 8px; background: Theme.surface;
                            border-width: 1px; border-color: Theme.border;
                            TextEdit {
                                width: 100%; height: 100%;
                                text: root.od-correction-input;
                                wrap: word-wrap;
                                edited(s) => { root.od-correction-input = s; }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Btn {
                                label: L.od-add-note; small: true; primary: true;
                                enabled: root.od-correction-input != "";
                                clicked => { root.od-add-correction(root.od-correction-input); root.od-correction-input = ""; }
                            }
                        }
                    }
                    Rectangle { height: 6px; }
                    // ---- Histórico do DB do overdev (cópia de segurança) ----
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.od-history; font-size: 14px; font-weight: 800; color: Theme.text; }
                        Text { text: L.od-history-note; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                        if root.od-snaps.length == 0: Text { text: L.od-snap-empty; font-size: 12px; color: Theme.text-dim; }
                        for s[si] in root.od-snaps: Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    width: 210px;
                                    alignment: center;
                                    Text { text: s.file; font-size: 12.5px; font-weight: 600; color: Theme.text; overflow: elide; }
                                }
                                VerticalLayout {
                                    width: 130px;
                                    alignment: center;
                                    Text { text: s.date; font-size: 11.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    width: 70px;
                                    alignment: center;
                                    Text { text: s.size; font-size: 11.5px; color: Theme.text-dim; }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn { label: L.od-view; small: true; clicked => { root.od-snap-view(s.id); } }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { label: L.od-restore; small: true; danger: true; clicked => { root.od-snap-restore-request(s.id); } }
                                }
                            }
                        }
                        if root.od-snap-total > 20: Pager {
                            page: root.od-snap-page;
                            total: root.od-snap-total;
                            prev => { root.od-snap-page-prev(); }
                            next => { root.od-snap-page-next(); }
                        }
                    }
                    // ---- Histórico de commits / push ----
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: L.od-commits; font-size: 14px; font-weight: 800; color: Theme.text; }
                        if root.od-upstream-line != "": Text { text: root.od-upstream-line; font-size: 12px; font-weight: 600; color: Theme.accent; }
                        if root.od-commits.length == 0: Text { text: L.od-commits-empty; font-size: 12px; color: Theme.text-dim; }
                        for c[ci] in root.od-commits: Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: c.pushed ? "●" : "○"; font-size: 13px; color: c.pushed ? Theme.good : Theme.text-dim; }
                                }
                                VerticalLayout {
                                    width: 70px;
                                    alignment: center;
                                    Text { text: c.short; font-size: 12px; color: Theme.accent; }
                                }
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: c.date; font-size: 11.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text { text: c.subject; font-size: 12.5px; color: Theme.text; overflow: elide; }
                                }
                                VerticalLayout {
                                    width: 110px;
                                    alignment: center;
                                    Text { text: c.author; font-size: 11.5px; color: Theme.text-dim; overflow: elide; }
                                }
                            }
                        }
                        if root.od-commit-total > 20: Pager {
                            page: root.od-commit-page;
                            total: root.od-commit-total;
                            prev => { root.od-commit-page-prev(); }
                            next => { root.od-commit-page-next(); }
                        }
                    }
                    Rectangle { height: 6px; }
                    // seções colapsáveis (só quando há conteúdo)
                    if root.od-notes != "": Collapse { title: L.od-notes-title; body: root.od-notes; }
                    if root.od-decisoes != "": Collapse { title: L.od-decisions; body: root.od-decisoes; }
                    if root.od-plano != "": Collapse { title: L.od-plan; body: root.od-plano; }
                    if root.od-perguntas != "": Collapse { title: L.od-questions; body: root.od-perguntas; }
                }
            }
        }

        // ---- aba ENVIRONMENTS (2) — gestão dos runtimes de linguagem --
        // Cada linha: linguagem, status, escolha de MÉTODO (chips) e botões
        // Instalar/Desinstalar. As ações NÃO mexem na máquina de dentro da GUI:
        // abrem um TERMINAL rodando `schematize env …` (plano + consentimento lá).
        if root.screen == 1 && root.active-tab == 2: VerticalLayout {
            // texto-guia + botão recarregar
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: L.env-intro;
                            font-size: 12.5px;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            small: true;
                            clicked => { root.env-refresh(); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    // Cada linha vem embrulhada: se `section-title` != "" ela ABRE uma
                    // seção (título "Linguagens" / "Ferramentas de dev", computado no
                    // Rust a partir do `category`), depois vem o card da linha.
                    for erow[ei] in root.env-rows: VerticalLayout {
                        spacing: 12px;
                        if erow.section-title != "": Text {
                            text: erow.section-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text-dim;
                        }
                        Rectangle {
                        height: 96px;
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            // linha 1: nome + status
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: erow.display;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 24px;
                                    width: stxt.preferred-width + 22px;
                                    border-radius: 12px;
                                    property <color> tone: erow.installed ? Theme.good : Theme.text-dim;
                                    background: tone.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: tone.transparentize(0.5);
                                    stxt := Text {
                                        text: erow.status-label;
                                        color: erow.installed ? Theme.good : Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {}
                                if erow.op-label != "": Text {
                                    text: erow.op-label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                            // linha 2 — LINGUAGEM: seletor de método (chips) + ações
                            if erow.category != "tool": HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-method;
                                        font-size: 12.5px;
                                        color: Theme.text-dim;
                                    }
                                }
                                if erow.methods.length == 0: VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-no-methods;
                                        font-size: 12.5px;
                                        color: Theme.warn;
                                    }
                                }
                                for m[mi] in erow.methods: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        label: m;
                                        selected: m == erow.method-sel;
                                        clicked => { root.env-pick-method(ei, m); }
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-install;
                                        primary: true;
                                        small: true;
                                        enabled: erow.methods.length > 0 && erow.method-sel != "";
                                        clicked => { root.env-install(ei); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-remove;
                                        danger: true;
                                        small: true;
                                        enabled: erow.installed;
                                        clicked => { root.env-remove(ei); }
                                    }
                                }
                            }
                            // linha 2 — FERRAMENTA: sem seletor de método; mostra só o
                            // caminho de instalação (install-hint) + as ações.
                            if erow.category == "tool": HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: erow.install-hint;
                                        font-size: 12.5px;
                                        color: Theme.text-dim;
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-install;
                                        primary: true;
                                        small: true;
                                        enabled: !erow.installed;
                                        clicked => { root.env-install(ei); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-remove;
                                        danger: true;
                                        small: true;
                                        enabled: erow.installed;
                                        clicked => { root.env-remove(ei); }
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }
        }

        // ---- aba GERENCIAR (3) — criar + editar skills ----------------
        // Dois modos (Criar / Editar). Criar: form (slug validado, nome, descrição)
        // → skilledit::scaffold. Editar: dropdown das skills instaladas → lista de
        // arquivos → editor de texto → skilledit::write_file (aplica em ~/.claude/skills).
        if root.screen == 1 && root.active-tab == 3: VerticalLayout {
            // seletor de modo (Criar | Editar)
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            label: L.create-skill;
                            selected: root.mg-mode == 0;
                            clicked => { root.mg-mode = 0; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            label: L.edit-skill;
                            selected: root.mg-mode == 1;
                            clicked => { root.mg-mode = 1; root.mg-refresh-skills(); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ===== MODO CRIAR =====
            if root.mg-mode == 0: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    // campo slug (validado)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-slug; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        LineEdit {
                            width: 360px;
                            placeholder-text: L.skill-slug;
                            text: root.mg-slug;
                            edited(s) => { root.mg-slug-edited(s); }
                        }
                        if root.mg-slug-error != "": Text {
                            text: root.mg-slug-error;
                            font-size: 12px;
                            color: Theme.warn;
                            wrap: word-wrap;
                        }
                    }
                    // campo nome
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-name; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        LineEdit {
                            width: 360px;
                            placeholder-text: L.skill-name;
                            text: root.mg-name;
                            edited(s) => { root.mg-name = s; }
                        }
                    }
                    // campo descrição (multi-linha)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-desc; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        Rectangle {
                            width: 560px;
                            height: 100px;
                            border-radius: 8px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextEdit {
                                width: 100%;
                                height: 100%;
                                text: root.mg-desc;
                                wrap: word-wrap;
                                edited(s) => { root.mg-desc = s; }
                            }
                        }
                    }
                    // ação criar
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            label: L.create;
                            primary: true;
                            enabled: root.mg-slug != "" && root.mg-slug-error == "";
                            clicked => { root.mg-create(); }
                        }
                    }
                    // resultado (sucesso = caminho / erro)
                    if root.mg-create-result != "": Text {
                        text: root.mg-create-result;
                        font-size: 13px;
                        font-weight: 600;
                        color: root.mg-create-error ? Theme.warn : Theme.good;
                        wrap: word-wrap;
                    }
                    // pós-criar: oferece editar já
                    if root.mg-create-result != "" && !root.mg-create-error: HorizontalLayout {
                        alignment: start;
                        Btn { label: L.edit-now; small: true; clicked => { root.mg-edit-created(); } }
                    }
                    Rectangle {}
                }
            }

            // ===== MODO EDITAR =====
            if root.mg-mode == 1: HorizontalLayout {
                // ---- barra lateral: dropdown de skills + lista de arquivos ----
                Rectangle {
                    width: 300px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: L.edit-skill; font-size: 14px; font-weight: 800; color: Theme.text; }
                        // dropdown das skills instaladas
                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: skdd.has-hover ? Theme.surface-2 : Theme.bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: root.mg-sel-skill != "" ? root.mg-sel-skill : L.pick-skill;
                                    color: root.mg-sel-skill != "" ? Theme.text : Theme.text-dim;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {}
                                Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            skdd := TouchArea { mouse-cursor: pointer; clicked => { skpop.show(); } }
                            skpop := PopupWindow {
                                close-policy: close-on-click-outside; // vide lgpop: ScrollView+close-on-click engole o clique
                                x: 0;
                                y: parent.height + 4px;
                                width: 268px;
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 10px;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;
                                        if root.mg-skills.length == 0: Text {
                                            text: L.no-installed-skills;
                                            font-size: 12px;
                                            color: Theme.text-dim;
                                            wrap: word-wrap;
                                        }
                                        for sk[si] in root.mg-skills: Rectangle {
                                            height: 30px;
                                            border-radius: 6px;
                                            background: skita.has-hover ? Theme.surface-2 : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: sk;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            skita := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.mg-pick-skill(sk); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // lista de arquivos da skill escolhida
                        if root.mg-sel-skill != "": Text {
                            text: L.pick-file;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text-dim;
                        }
                        ScrollView {
                            VerticalLayout {
                                spacing: 2px;
                                for f[fi] in root.mg-files: Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: f == root.mg-sel-file
                                        ? Theme.accent-soft
                                        : (fita.has-hover ? Theme.surface-2 : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: f;
                                            font-size: 12.5px;
                                            font-weight: f == root.mg-sel-file ? 700 : 500;
                                            color: f == root.mg-sel-file ? Theme.header-fg : Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    fita := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.mg-pick-file(f); }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
                // ---- editor de texto ----
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    // aviso de FORK: skill OFICIAL ainda não-forkada → editar vai forkar;
                    // skill já forkada → [fork] ativo + botão Comparar com a oficial nova.
                    if root.mg-sel-skill != "" && root.mg-sel-official && !root.mg-sel-forked: Rectangle {
                        border-radius: 8px;
                        background: Theme.warn.transparentize(0.86);
                        border-width: 1px;
                        border-color: Theme.warn.transparentize(0.5);
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "⚠"; font-size: 14px; color: Theme.warn; vertical-alignment: center; }
                            Text {
                                text: L.fork-will;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if root.mg-sel-skill != "" && root.mg-sel-forked: Rectangle {
                        border-radius: 8px;
                        background: Theme.accent-soft;
                        border-width: 1px;
                        border-color: Theme.accent.transparentize(0.5);
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.fork-active;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: L.compare-official;
                                    small: true;
                                    clicked => { root.cmp-request(root.mg-sel-skill); }
                                }
                            }
                        }
                    }
                    // empty-state: nenhum arquivo escolhido
                    if root.mg-sel-file == "": VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: L.pick-file-hint;
                                font-size: 13px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    // cabeçalho: skill / arquivo
                    if root.mg-sel-file != "": Text {
                        text: root.mg-sel-skill + " / " + root.mg-sel-file;
                        font-size: 13.5px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    // editor multi-linha (ocupa o espaço restante)
                    if root.mg-sel-file != "": Rectangle {
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            width: 100%;
                            height: 100%;
                            text: root.mg-content;
                            wrap: no-wrap;
                            edited(s) => { root.mg-content = s; }
                        }
                    }
                    // salvar + feedback
                    if root.mg-sel-file != "": HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.save; primary: true; clicked => { root.mg-save(); } }
                        VerticalLayout {
                            alignment: center;
                            if root.mg-save-result != "": Text {
                                text: root.mg-save-result;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: root.mg-save-error ? Theme.warn : Theme.good;
                            }
                        }
                    }
                }
            }
        }

        // ---- páginas Instaladas (0) e Marketplace (1) -----------------
        if root.screen == 1 && root.active-tab <= 1: VerticalLayout {
            // ---- barra de ações (difere por página) -----------------------
            Rectangle {
                height: 62px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;

                    // --- ações da página INSTALADAS ---
                    if root.active-tab == 0: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            // "Atualizar tudo": SÓ instaladas-desatualizadas. Nunca instala nova.
                            Btn {
                                label: L.update-all;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.update-all(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: L.update-installed-only;
                                font-size: 11px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.update-sel;
                                enabled: !root.busy;
                                clicked => { root.update-selected(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.remove-sel;
                                danger: true;
                                enabled: !root.busy;
                                clicked => { root.remove-selected(); }
                            }
                        }
                    }

                    // --- ações da página MARKETPLACE ---
                    if root.active-tab == 1: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.install-sel-market;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.install-selected(); }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            enabled: !root.busy;
                            clicked => { root.check(); }
                        }
                    }
                    Rectangle {}  // espaçador
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.sel-label;
                                    font-size: 12.5px;
                                    color: Theme.text-dim;
                                }
                            }
                            Btn { label: L.sel-all; small: true; enabled: !root.busy; clicked => { root.select-all(); } }
                            // "Selecionar pendentes" só faz sentido em Instaladas (desatualizadas).
                            if root.active-tab == 0: Btn { label: L.sel-pending; small: true; enabled: !root.busy; clicked => { root.select-pending(); } }
                            Btn { label: L.sel-none; small: true; enabled: !root.busy; clicked => { root.select-none(); } }
                        }
                    }
                }
            }
            // ---- linha de status/toast ------------------------------------
            Rectangle {
                height: 26px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    Text {
                        text: root.status;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- cabeçalho de colunas (difere por página) -----------------
            Rectangle {
                height: 34px;
                background: Theme.surface-2;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 0px;
                    Rectangle { width: 34px; }
                    Text { width: 260px; text: L.col-skill; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 170px; text: L.col-author; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 90px; text: L.col-installed; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 90px; text: L.col-latest; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 150px; text: L.col-state; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { text: L.col-actions; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ---- lista rolável (modelo único, filtrado por página) --------
            ScrollView {
                VerticalLayout {
                    padding-bottom: 16px;
                    spacing: 0px;
                    for row[i] in root.rows: Rectangle {
                        // Visível quando: cabeçalho da página ativa com itens,
                        // ou skill cujo ESTADO casa com a página ativa.
                        //   tab 0 (Instaladas)  → state != "missing"
                        //   tab 1 (Marketplace) → state == "missing"
                        property <bool> on-page: row.is-header
                            ? (row.count > 0 && root.active-tab == row.page)
                            : (root.active-tab == 0 ? row.state != "missing"
                               : root.active-tab == 1 ? row.state == "missing"
                               : false);
                        // Paginação: cabeçalho segue as regras de página; skill só
                        // aparece se seu índice de exibição cai na janela atual (20/página).
                        property <bool> show: row.is-header
                            ? on-page
                            : (on-page && row.disp >= root.mkt-page * 20 && row.disp < (root.mkt-page + 1) * 20);
                        height: show ? (row.is-header ? 48px : 56px) : 0px;
                        visible: show;
                        background: row.is-header
                            ? Theme.bg
                            : (Math.mod(i, 2) == 0 ? Theme.stripe : Theme.bg);

                        // --- cabeçalho de categoria ---
                        if row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-top: 18px;
                            Text {
                                text: row.header-label;
                                font-size: 14px;
                                font-weight: 800;
                                color: Theme.header-fg;
                            }
                        }

                        // --- linha de skill ---
                        if !row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 0px;
                            // checkbox
                            VerticalLayout {
                                width: 34px;
                                alignment: center;
                                Check {
                                    checked: row.selected;
                                    enabled: !root.busy;
                                    toggled => { root.toggle(i); }
                                }
                            }
                            // skill + selo (+ badge [fork] quando forkada)
                            VerticalLayout {
                                width: 260px;
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 6px;
                                    SkillName { slug: row.slug; verified: row.verified; }
                                    if row.forked: Rectangle {
                                        width: forktxt.preferred-width + 12px;
                                        height: 18px;
                                        border-radius: 5px;
                                        background: Theme.accent-soft;
                                        border-width: 1px;
                                        border-color: Theme.accent.transparentize(0.55);
                                        forktxt := Text {
                                            text: L.fork-badge;
                                            font-size: 10.5px;
                                            font-weight: 800;
                                            color: Theme.header-fg;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Nota do marketplace (discreta): "★4.7 (12)". Vazio → some.
                                    if row.rating != "": Text {
                                        text: row.rating;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #d9a406;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {}
                                }
                            }
                            // autor
                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                AuthorCell {
                                    author: row.author;
                                    author-url: row.author-url;
                                    clicked => { root.open-author(i); }
                                }
                            }

                            // ===== colunas + ações da página INSTALADAS =====
                            if root.active-tab == 0: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.installed; font-size: 13.5px; color: Theme.text; }
                                }
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    width: 150px;
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: start;
                                        StatePill { state: row.state; label: row.state-label; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        // Atualizar: habilitado só se desatualizada.
                                        Btn {
                                            label: L.act-update; small: true; primary: true;
                                            enabled: !root.busy && row.state == "outdated";
                                            clicked => { root.row-update(i); }
                                        }
                                        // Comparar com a oficial nova (só skills forkadas).
                                        if row.forked: Btn {
                                            label: L.compare-official; small: true;
                                            enabled: !root.busy;
                                            clicked => { root.cmp-request(row.slug); }
                                        }
                                        // Desinstalar sempre disponível numa instalada.
                                        Btn {
                                            label: L.act-remove; small: true; danger: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-remove(i); }
                                        }
                                    }
                                }
                            }

                            // ===== colunas + ação da página MARKETPLACE =====
                            if root.active-tab == 1: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Botão Instalar grande/óbvio.
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            label: L.act-install; primary: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-install(i); }
                                        }
                                    }
                                }
                            }
                        }

                        // separador fino sob cada skill visível
                        if !row.is-header && show: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border.transparentize(0.5);
                        }
                    }
                }
            }
            // paginação (só quando passa de uma página)
            if root.mkt-total > 20: Rectangle {
                height: 44px;
                background: Theme.bg;
                Pager {
                    page: root.mkt-page;
                    total: root.mkt-total;
                    prev => { root.mkt-page = root.mkt-page - 1; }
                    next => { root.mkt-page = root.mkt-page + 1; }
                }
            }
        }
    }

    // ---- MODAL de instalação (Marketplace) ----------------------------
    // Aparece ao instalar uma skill de LINGUAGEM: mostra que ela RECOMENDA a
    // engineering (skill base) e oferece, OPCIONALMENTE, instalar o environment
    // da linguagem (runtime+ferramentas) por um método disponível nesta máquina.
    // Nada é marcado por padrão — a recomendada e o environment só entram se o
    // usuário marcar. O environment roda num TERMINAL (consentimento honesto).
    if root.mp-open: Rectangle {
        // fundo escurecido cobrindo a janela (clique fora = cancelar).
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.mp-cancel(); } }

        // cartão central
        Rectangle {
            width: Math.min(root.width - 64px, 520px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            // absorve cliques (não fecha ao clicar dentro).
            TouchArea {}
            card := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                // título
                Text {
                    text: root.mp-title;
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text;
                }
                // dependência opcional (skill base recomendada)
                if root.mp-rec-show: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: L.mp-recommends-note;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                checked: root.mp-rec-check;
                                toggled => { root.mp-toggle-rec(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.mp-rec-label;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                    }
                }
                // environment opcional da linguagem
                if root.mp-env-show: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                checked: root.mp-env-check;
                                toggled => { root.mp-toggle-env(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.mp-env-label;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                    }
                    // escolha do método (só quando marca instalar o environment)
                    if root.mp-env-check: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Text { text: L.env-method; font-size: 12.5px; color: Theme.text-dim; }
                        }
                        if root.mp-methods.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: L.env-no-methods; font-size: 12.5px; color: Theme.warn; }
                        }
                        for mm[mmi] in root.mp-methods: Chip {
                            label: mm;
                            selected: mm == root.mp-method-sel;
                            clicked => { root.mp-pick-method(mm); }
                        }
                    }
                    if root.mp-env-check: Text {
                        text: L.mp-env-note;
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                // ações
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Btn {
                        label: L.mp-cancel;
                        clicked => { root.mp-cancel(); }
                    }
                    Btn {
                        label: L.mp-confirm;
                        primary: true;
                        // se marcou instalar o environment, exige um método escolhido
                        enabled: !root.mp-env-check || root.mp-method-sel != "";
                        clicked => { root.mp-confirm(); }
                    }
                }
            }
        }
    }

    // ---- MODAL de diretórios de dev (aberto pela ProjectBar) ----------
    // TODA a gestão de dev_dirs vive AQUI (fora da tela principal): listar,
    // adicionar (rfd::pick_folder → config::add_dev_dir), remover. Fechar o
    // modal re-scaneia os projetos (via od-reload). Também oferece abrir um
    // projeto avulso (fora dos dev_dirs) sem poluir a barra.
    if root.dev-modal-open: Rectangle {
        background: #000000.transparentize(0.45);
        // clique fora = fechar + re-scan.
        TouchArea { clicked => { root.dev-modal-open = false; root.od-reload(); } }

        Rectangle {
            width: Math.min(root.width - 64px, 560px);
            height: Math.min(root.height - 96px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}  // absorve cliques (não fecha ao clicar dentro)
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                // título + adicionar
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.dev-dirs; font-size: 18px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.add-dev-dir; primary: true; small: true; clicked => { root.od-add-dev-dir(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                // lista dos dev_dirs (rolável)
                if root.od-dev-dirs.length == 0: Text {
                    text: L.dev-dirs-empty;
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for dd[ddi] in root.od-dev-dirs: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: dxta.has-hover ? Theme.warn.transparentize(0.85) : transparent;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text { text: "✕"; font-size: 11px; color: Theme.text-dim; }
                                    dxta := TouchArea { mouse-cursor: pointer; clicked => { root.od-remove-dev-dir(dd); } }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: dd; font-size: 12.5px; color: Theme.text-dim; overflow: elide; }
                            }
                        }
                    }
                }
                // ---- Projetos fixados (pins) ----
                // Uma pasta fixada vira UM projeto no seletor mesmo sem marcador
                // git — útil pra workspace/monorepo de microserviços.
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.pinned-projects; font-size: 15px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.pin-folder; primary: true; small: true; clicked => { root.od-pin-folder(); } }
                    }
                }
                Text {
                    text: L.pin-hint;
                    font-size: 11.5px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if root.od-pinned.length > 0: ScrollView {
                    max-height: 130px;
                    VerticalLayout {
                        spacing: 6px;
                        for pp[ppi] in root.od-pinned: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: pxta.has-hover ? Theme.warn.transparentize(0.85) : transparent;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text { text: "✕"; font-size: 11px; color: Theme.text-dim; }
                                    pxta := TouchArea { mouse-cursor: pointer; clicked => { root.od-unpin(pp); } }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: pp; font-size: 12.5px; color: Theme.text-dim; overflow: elide; }
                            }
                        }
                    }
                }
                Rectangle {}  // empurra o rodapé pra base
                // rodapé: abrir projeto avulso + fechar
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.open-loose-project; small: true; clicked => { root.od-open-folder(); } }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.mp-cancel; small: true; clicked => { root.dev-modal-open = false; root.od-reload(); } }
                    }
                }
            }
        }
    }

    // ---- GUARDRAIL do agente acoplado (Fase 4) --------------------------
    // Antes de disparar o `claude` acoplado: MOSTRA o comando do agente
    // (runner.command_line), o projeto e um aviso. Só o "Confirmar" dispara.
    if root.od-confirm-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.od-run-cancel(); } }  // clique fora = cancela

        Rectangle {
            width: Math.min(root.width - 64px, 560px);
            height: Math.min(root.height - 96px, 400px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}  // absorve cliques dentro
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text { text: L.od-run; font-size: 18px; font-weight: 800; color: Theme.text; }
                // aviso do disparo
                Text {
                    text: L.od-confirm-run;
                    font-size: 13px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                // projeto alvo
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: L.project; font-size: 12.5px; font-weight: 700; color: Theme.text-dim; }
                    Text { text: root.od-current; font-size: 12.5px; font-weight: 700; color: Theme.text; overflow: elide; }
                }
                // comando do agente (monospace)
                Text { text: L.od-agent-cmd; font-size: 12.5px; font-weight: 700; color: Theme.text-dim; }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.od-agent-cmdline;
                            font-size: 12px;
                            font-family: "monospace";
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle {}  // empurra o rodapé
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {}
                    Btn { label: L.mp-cancel; small: true; clicked => { root.od-run-cancel(); } }
                    Btn { label: L.od-run; primary: true; small: true; clicked => { root.od-run-confirm(); } }
                }
            }
        }
    }

    // ---- MODAL de confirmação de remoção de chave SSH -------------------
    if root.ssh-confirm-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.ssh-remove-cancel(); } }
        Rectangle {
            width: Math.min(root.width - 64px, 460px);
            height: sshcard.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            sshcard := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                Text { text: root.ssh-confirm-msg; font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Btn { label: L.mp-cancel; clicked => { root.ssh-remove-cancel(); } }
                    Btn { label: L.ssh-remove; primary: true; danger: true; clicked => { root.ssh-remove-confirm(); } }
                }
            }
        }
    }

    // ---- MODAL de confirmação de RESTAURAR snapshot ---------------------
    if root.od-snap-confirm-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.od-snap-restore-cancel(); } }
        Rectangle {
            width: Math.min(root.width - 64px, 460px);
            height: snapcard.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            snapcard := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                Text { text: root.od-snap-confirm-msg; font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Btn { label: L.mp-cancel; clicked => { root.od-snap-restore-cancel(); } }
                    Btn { label: L.od-restore; primary: true; danger: true; clicked => { root.od-snap-restore-confirm(); } }
                }
            }
        }
    }

    // ---- VISOR read-only de um snapshot do DB ---------------------------
    if root.od-snap-view-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.od-snap-view-open = false; } }
        Rectangle {
            width: Math.min(root.width - 64px, 720px);
            height: Math.min(root.height - 96px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.od-snap-view-title; font-size: 14px; font-weight: 800; color: Theme.text; overflow: elide; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.od-close; small: true; clicked => { root.od-snap-view-open = false; } }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextEdit {
                        width: 100%;
                        height: 100%;
                        read-only: true;
                        text: root.od-snap-view-content;
                        font-size: 12px;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }

    // ---- PAINEL de notificações (sininho) -------------------------------
    // Overlay ancorado no topo-direito. Agrupa Globais e Pessoais; cada item com
    // título + corpo + (se houver) botão de ação. Vazio → "Sem notificações".
    if root.notif-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.notif-open = false; } }
        Rectangle {
            width: Math.min(root.width - 48px, 420px);
            height: Math.min(root.height - 110px, 520px);
            x: parent.width - self.width - 20px;
            y: 78px;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.notif-title; font-size: 15px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.od-close; small: true; clicked => { root.notif-open = false; } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if root.notif-loading: Text { text: L.notif-loading; font-size: 12.5px; color: Theme.text-dim; }
                if !root.notif-loading && root.notif-total == 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: L.notif-empty;
                        font-size: 13px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
                if !root.notif-loading && root.notif-total > 0: ScrollView {
                    VerticalLayout {
                        spacing: 10px;
                        // ---- Globais ----
                        if root.notif-global.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: L.notif-global; font-size: 11.5px; font-weight: 800; color: Theme.header-fg; }
                            for n[ni] in root.notif-global: Rectangle {
                                border-radius: 9px;
                                background: Theme.bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 5px;
                                    Text { text: n.title; font-size: 13px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                    Text { text: n.body; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                    if n.has-action: HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            label: n.kind == "app_update" ? L.notif-do-update
                                                 : n.kind == "news" ? L.notif-open
                                                 : L.notif-go-installed;
                                            small: true;
                                            primary: n.kind == "app_update";
                                            clicked => { root.notif-action(n.kind, n.action); }
                                        }
                                    }
                                }
                            }
                        }
                        // ---- Pessoais ----
                        if root.notif-personal.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: L.notif-personal; font-size: 11.5px; font-weight: 800; color: Theme.header-fg; }
                            for n[ni] in root.notif-personal: Rectangle {
                                border-radius: 9px;
                                background: Theme.bg;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 11px;
                                    spacing: 5px;
                                    Text { text: n.title; font-size: 13px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                                    Text { text: n.body; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
                                    if n.has-action: HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            label: n.kind == "skill_outdated" ? L.notif-go-installed : L.notif-open;
                                            small: true;
                                            clicked => { root.notif-action(n.kind, n.action); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- MODAL de login (device flow) ----------------------------------
    // Mostra o user_code em destaque + a verification_uri e o botão de abrir no
    // navegador. Enquanto aberto, o Rust roda o loop de poll numa thread; Cancelar
    // levanta o flag de parada. Não fecha ao clicar fora (usa Cancelar de propósito).
    if root.acc-modal-open: Rectangle {
        background: #000000.transparentize(0.5);
        TouchArea {}  // captura cliques do fundo (evita fechar sem cancelar o poll)
        Rectangle {
            width: Math.min(root.width - 48px, 460px);
            height: Math.min(root.height - 80px, 440px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: L.acc-modal-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                Text { text: L.acc-code-label; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap; }
                // código em destaque.
                Rectangle {
                    height: 62px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(0.4);
                    Text {
                        text: root.acc-user-code;
                        font-size: 30px;
                        font-weight: 800;
                        color: Theme.header-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // URL de verificação.
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.acc-verification-at; font-size: 12px; color: Theme.text-dim; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.acc-verification-uri;
                            font-size: 12.5px; font-weight: 700; color: Theme.text; overflow: elide;
                        }
                    }
                    Rectangle {}
                }
                Btn { label: L.acc-open-browser; primary: true; clicked => { root.acc-open-verify(); } }
                Rectangle {}  // empurra a base pra baixo
                if root.acc-status != "": Text {
                    text: root.acc-status;
                    font-size: 12px; font-weight: 600; color: Theme.warn; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.acc-waiting; font-size: 12px; color: Theme.text-dim; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.acc-cancel; small: true; clicked => { root.acc-cancel-login(); } }
                    }
                }
            }
        }
    }

    // ---- PAINEL de comparação (fork ativo vs nova oficial) --------------
    // Só LEITURA: base→nova, lista de arquivos com status e o diff monoespaçado.
    // Deixa explícito que comparar NÃO sobrescreve nada.
    if root.cmp-open: Rectangle {
        background: #000000.transparentize(0.5);
        TouchArea { clicked => { root.cmp-close(); } }
        Rectangle {
            width: Math.min(root.width - 48px, 820px);
            height: Math.min(root.height - 80px, 640px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: root.cmp-title; font-size: 15px; font-weight: 800; color: Theme.text; overflow: elide; }
                        if root.cmp-versions != "": Text { text: root.cmp-versions; font-size: 12.5px; font-weight: 700; color: Theme.header-fg; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.od-close; small: true; clicked => { root.cmp-close(); } }
                    }
                }
                Text { text: L.compare-note; font-size: 11.5px; color: Theme.text-dim; wrap: word-wrap; }
                if root.cmp-loading: Text { text: L.compare-loading; font-size: 12.5px; color: Theme.text-dim; }
                if !root.cmp-loading && root.cmp-error != "": Text { text: root.cmp-error; font-size: 12.5px; font-weight: 600; color: Theme.warn; wrap: word-wrap; }
                if !root.cmp-loading && root.cmp-error == "": HorizontalLayout {
                    spacing: 12px;
                    // ---- lista de arquivos (status) ----
                    Rectangle {
                        width: 240px;
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text { text: L.compare-files; font-size: 11.5px; font-weight: 800; color: Theme.text-dim; }
                            ScrollView {
                                VerticalLayout {
                                    spacing: 2px;
                                    for cf[cfi] in root.cmp-files: HorizontalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            width: statustxt.preferred-width + 12px;
                                            height: 17px;
                                            border-radius: 5px;
                                            background: cf.status == "mudou" ? Theme.warn.transparentize(0.75)
                                                     : cf.status == "novo" ? Theme.good.transparentize(0.75)
                                                     : cf.status == "removido" ? #ff6b6b.transparentize(0.78)
                                                     : Theme.surface-2;
                                            statustxt := Text {
                                                text: cf.status;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: Theme.text;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text { text: cf.path; font-size: 11.5px; color: Theme.text; overflow: elide; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    // ---- diff unificado (mono, read-only) ----
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            width: 100%;
                            height: 100%;
                            read-only: true;
                            text: root.cmp-diff;
                            font-size: 12px;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }
    }

    // ---- VISOR read-only do SQL/migration gerado (Database builder) -----
    // Mostra o resultado de to_sql/to_migration num TextEdit mono + botão de salvar.
    if root.db-gen-open: Rectangle {
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.db-gen-open = false; } }
        Rectangle {
            width: Math.min(root.width - 64px, 760px);
            height: Math.min(root.height - 96px, 580px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.db-gen-title; font-size: 14px; font-weight: 800; color: Theme.text; overflow: elide; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.db-gen-save; small: true; clicked => { root.db-gen-save(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.od-close; small: true; clicked => { root.db-gen-open = false; } }
                    }
                }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.border;
                    TextEdit {
                        width: 100%;
                        height: 100%;
                        read-only: true;
                        text: root.db-gen-content;
                        font-size: 12px;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }
}
