// ---------------------------------------------------------------------------
// schematize — GUI em Slint (migração incremental egui→Slint).
//
// O quê: DUAS páginas de topo — "Instaladas" e "Marketplace" — sobre o MESMO
// modelo de linhas (uma linha por skill + cabeçalhos de categoria). A página
// ativa filtra as linhas por ESTADO:
//   • Marketplace = skills NÃO instaladas (state == "missing") → descobrir/instalar.
//   • Instaladas  = skills instaladas (state != "missing")     → atualizar/desinstalar.
// Overdev/Grafo seguem como placeholders ("em breve").
//
// Selo verificado: um CHECK pequeno (círculo de acento + ✓), estilo Instagram/X,
// com tooltip no hover — SEM texto ao lado.
//
// i18n: NADA de texto hardcoded — toda string estática vem do `global L`,
// preenchido pelo Rust a partir de `schematize::i18n` (11 locales).
// ---------------------------------------------------------------------------

import { ScrollView } from "std-widgets.slint";

// Uma linha do modelo. Pode ser um CABEÇALHO de categoria (is-header) ou uma
// SKILL. Campos preenchidos/atualizados pelo Rust (catálogo + rede + ações).
export struct SkillRow {
    is-header: bool,
    header-label: string,
    // Cabeçalho: a QUAL página pertence (0 = Instaladas, 1 = Marketplace) e
    // quantas skills ele agrupa AGORA nessa página (0 → cabeçalho some).
    page: int,
    count: int,
    // Categoria (base/language/external) — usada pelo Rust p/ recontar os
    // cabeçalhos após instalar/desinstalar (skill muda de página).
    category: string,
    slug: string,
    author: string,
    author-url: string,
    installed: string,
    latest: string,
    state: string,        // "missing" | "outdated" | "current" | "loading"
    state-label: string,
    verified: bool,
    selected: bool,
    busy: bool,           // operação (instalar/remover) em andamento nesta linha
    op-label: string,     // status transitório da linha ("instalando…", erro…)
    op-error: bool,       // op-label é um erro? (colore em warn)
}

// Uma linha da aba Environments: uma LINGUAGEM, seus métodos disponíveis nesta
// máquina, o método escolhido pra instalar, e o status (instalado? por qual método).
// Preenchida pelo Rust a partir de `schematize::environments::status()`.
export struct EnvRow {
    lang: string,           // slug ("go", "rust", ...) — vira o arg do `schematize env`
    display: string,        // nome de exibição ("Go", "C# / .NET", ...)
    methods: [string],      // métodos utilizáveis AQUI (docker|mise|distro|official)
    method-sel: string,     // método escolhido pra instalar (chip selecionado)
    installed: bool,        // já instalado (por método detectado OU runtime no PATH)
    status-label: string,   // texto de status traduzido (instalado via X / instalado / não)
    op-label: string,       // mensagem transitória da linha (terminal aberto / erro)
}

// Uma entrada do seletor de projeto da aba Overdev: um CABEÇALHO de grupo
// (Detectados/Recentes) ou um PROJETO clicável. Preenchida pelo Rust a partir de
// `schematize::projects::scan()` (detectados) + `config::recent_projects()`.
export struct ProjItem {
    is-header: bool,
    label: string,    // cabeçalho: rótulo do grupo
    name: string,     // projeto: nome de exibição (basename)
    path: string,     // projeto: caminho absoluto (arg das ações)
    marker: string,   // projeto: marcador que o identificou (.git/.overdev/…)
}

// Um item do checklist do overdev: o tipo (done/open/hold) + o texto.
// `kind` decide a cor no Slint (done=verde, open=normal, hold=amarelo).
export struct OverItem {
    kind: string,   // "done" | "open" | "hold"
    text: string,
}

// Rótulos estáticos da UI — ponto único de injeção de i18n vindo do Rust.
export global L {
    in-out property <string> window-title: "schematize";
    in-out property <string> subtitle;
    in-out property <string> theme-light;
    in-out property <string> theme-dark;
    in-out property <string> check;
    in-out property <string> update-all;
    in-out property <string> update-installed-only; // texto-guia do "Atualizar tudo"
    in-out property <string> update-sel;
    in-out property <string> install-sel-market;
    in-out property <string> remove-sel;
    in-out property <string> sel-label;
    in-out property <string> sel-all;
    in-out property <string> sel-pending;
    in-out property <string> sel-none;
    in-out property <string> col-skill;
    in-out property <string> col-author;
    in-out property <string> col-installed;
    in-out property <string> col-latest;
    in-out property <string> col-state;
    in-out property <string> col-actions;
    in-out property <string> verified;   // tooltip do selo
    in-out property <string> tab-installed;
    in-out property <string> tab-marketplace;
    in-out property <string> tab-overdev;
    in-out property <string> tab-graph;
    in-out property <string> coming-soon;
    in-out property <string> act-install;
    in-out property <string> act-update;
    in-out property <string> act-remove;   // "Desinstalar" por-linha
    // aba Environments
    in-out property <string> tab-environments;
    in-out property <string> env-intro;      // texto-guia (mexe na máquina / roda em terminal)
    in-out property <string> env-method;      // "Método:"
    in-out property <string> env-no-methods;  // nenhum método disponível
    // modal de instalação do Marketplace (dep opcional + environment opcional)
    in-out property <string> mp-recommends-note; // "Recomenda a skill base:"
    in-out property <string> mp-env-note;         // "o environment mexe na máquina / roda em terminal"
    in-out property <string> mp-confirm;          // "Instalar"
    in-out property <string> mp-cancel;           // "Cancelar"
    // aba Overdev (seletor de projeto + view)
    in-out property <string> project;            // "Projeto:"
    in-out property <string> no-project;          // empty-state: nenhum projeto
    in-out property <string> detected-projects;   // cabeçalho do grupo detectados
    in-out property <string> recent-projects;     // cabeçalho do grupo recentes
    in-out property <string> open-folder;         // "Abrir pasta…"
    in-out property <string> reload;              // "recarregar"
    in-out property <string> dev-dirs;            // "Diretórios de desenvolvimento"
    in-out property <string> add-dev-dir;         // "Adicionar diretório…"
    in-out property <string> dev-dirs-empty;      // empty-state dos dev_dirs
    in-out property <string> remove;              // tooltip "remover"
    in-out property <string> no-overdev;          // empty-state: sem run de overdev
    in-out property <string> od-decisions;        // "Decisões"
    in-out property <string> od-plan;             // "Plano"
    in-out property <string> od-questions;        // "Perguntas parkeadas"
    in-out property <string> open-browser;        // "abrir no navegador"
}

// Paleta central — um único ponto de verdade para claro/escuro.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:        dark ? #14161c : #f4f6fb;
    out property <color> surface:   dark ? #1b1e27 : #ffffff;
    out property <color> surface-2: dark ? #222634 : #eef1f8;
    out property <color> stripe:    dark ? #1e222d : #f8fafd;
    out property <color> border:    dark ? #2b3040 : #dfe4ee;
    out property <color> text:      dark ? #e6e9f2 : #1a1e2b;
    out property <color> text-dim:  dark ? #8a90a2 : #6b7280;
    out property <color> accent:    #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #dfe8ff;
    out property <color> good:      #3ecf8e;
    out property <color> warn:      #e6b23a;
    out property <color> header-fg: dark ? #9db4ff : #3a5bd0;
}

// Selo verificado: check pequeno (círculo de acento + ✓) + tooltip no hover.
// Sem texto ao lado do nome — só o ícone (estilo Instagram/X).
component VerifiedCheck inherits Rectangle {
    in property <string> tip;
    width: 17px;
    height: 17px;
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        Text {
            text: "✓";
            color: #ffffff;
            font-size: 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: default; }
    // tooltip flutuante (aparece no hover; pode transbordar a linha).
    if ta.has-hover: Rectangle {
        x: parent.width + 6px;
        y: (parent.height - self.height) / 2;
        height: 22px;
        width: tip-txt.preferred-width + 16px;
        border-radius: 6px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        tip-txt := Text {
            text: root.tip;
            color: Theme.text;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Checkbox próprio (controle total do visual + tema). Emite `toggled`.
component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: checked ? Theme.accent : Theme.text-dim;
    background: checked ? Theme.accent : transparent;
    opacity: enabled ? 1.0 : 0.4;
    animate background, border-color { duration: 120ms; }
    Text {
        text: "✓";
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        visible: root.checked;
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
}

// Botão de ação com estilo próprio (primário/secundário, normal/compacto).
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> small: false;
    in property <bool> danger: false;
    callback clicked();
    height: small ? 30px : 38px;
    border-radius: small ? 7px : 9px;
    background: primary
        ? (ta.has-hover && enabled ? #6f9bff : Theme.accent)
        : (ta.has-hover && enabled ? Theme.surface-2 : Theme.surface);
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.warn.transparentize(0.4) : Theme.border;
    opacity: enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.small ? 12px : 16px;
        padding-right: root.small ? 12px : 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: primary ? #ffffff : (danger ? Theme.warn : Theme.text);
            font-size: small ? 12.5px : 14px;
            font-weight: 600;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// Toggle de tema discreto estilo sol/lua — botão-ícone pequeno, sem texto.
// Mostra a LUA quando está no claro (clica → escuro) e o SOL quando está no
// escuro (clica → claro). Ícones desenhados por Path (SVG inline), tema-aware.
component ThemeToggle inherits Rectangle {
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: ta.has-hover ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border : transparent;
    animate background, border-color { duration: 160ms; }

    // LUA (crescente) — visível no tema CLARO; clicar leva ao escuro.
    if !Theme.dark: Path {
        width: 19px;
        height: 19px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z";
        fill: Theme.text-dim;
    }

    // SOL (disco + raios) — visível no tema ESCURO; clicar leva ao claro.
    if Theme.dark: Rectangle {
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // raios (traço)
        Path {
            width: 22px;
            height: 22px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 2.2v2.6 M12 19.2v2.6 M2.2 12h2.6 M19.2 12h2.6 M4.8 4.8l1.9 1.9 M17.3 17.3l1.9 1.9 M4.8 19.2l1.9-1.9 M17.3 6.7l1.9-1.9";
            stroke: Theme.warn;
            stroke-width: 2px;
        }
        // disco central
        Rectangle {
            width: 11px;
            height: 11px;
            border-radius: 5.5px;
            background: Theme.warn;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Painel colapsável (título clicável + corpo mono). Usado nas seções do overdev
// (Decisões / Plano / Perguntas). Começa fechado.
component Collapse inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    property <bool> open: false;
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: 7px;
        background: hta.has-hover ? Theme.surface-2 : transparent;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: root.open ? "▾" : "▸";
                font-size: 12px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        hta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open = !root.open; }
        }
    }
    if root.open: Rectangle {
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding: 12px;
            Text {
                text: root.body;
                font-size: 12.5px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }
    }
}

// Chip selecionável (escolha de MÉTODO do environment). Emite `clicked`.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    border-radius: 8px;
    background: selected ? Theme.accent-soft : (ta.has-hover && enabled ? Theme.surface-2 : Theme.surface);
    border-width: 1px;
    border-color: selected ? Theme.accent : Theme.border;
    opacity: enabled ? 1.0 : 0.5;
    animate background, border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: selected ? Theme.header-fg : Theme.text;
            font-size: 12.5px;
            font-weight: selected ? 700 : 600;
        }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { if (root.enabled) { root.clicked(); } } }
}

// Aba do topo (rótulo + marca de "em breve" para as ainda não implementadas).
component TabBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> soon: false;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: active ? Theme.accent-soft : (ta.has-hover ? Theme.surface-2 : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: active ? Theme.header-fg : Theme.text-dim;
            font-size: 13.5px;
            font-weight: active ? 700 : 600;
        }
        if root.soon: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            width: soonlbl.preferred-width + 12px;
            border-radius: 9px;
            background: Theme.warn.transparentize(0.85);
            border-width: 1px;
            border-color: Theme.warn.transparentize(0.55);
            soonlbl := Text {
                text: L.coming-soon;
                color: Theme.warn;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Pill de estado (Atualizar / Em dia / carregando) — usada na página Instaladas.
component StatePill inherits Rectangle {
    in property <string> state;
    in property <string> label;
    property <color> tone:
        state == "missing"  ? Theme.warn :
        state == "outdated" ? Theme.accent : Theme.text-dim;
    width: txt.preferred-width + 22px;
    height: 24px;
    border-radius: 12px;
    background: tone.transparentize(0.85);
    border-width: 1px;
    border-color: tone.transparentize(0.5);
    txt := Text {
        text: root.label;
        color: root.tone;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Nome da skill + selo verificado (compartilhado pelas duas páginas).
component SkillName inherits HorizontalLayout {
    in property <string> slug;
    in property <bool> verified;
    spacing: 7px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Text {
            text: root.slug;
            font-size: 14.5px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
    }
    if root.verified: VerticalLayout {
        alignment: center;
        VerifiedCheck { tip: L.verified; }
    }
}

// Autor clicável (abre sponsor.url). Compartilhado pelas duas páginas.
component AuthorCell inherits Rectangle {
    in property <string> author;
    in property <string> author-url;
    callback clicked();
    height: 24px;
    HorizontalLayout {
        alignment: start;
        Text {
            text: root.author;
            font-size: 13.5px;
            color: root.author-url != "" ? Theme.accent : Theme.text-dim;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.author-url != "";
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: L.window-title;
    icon: root.app-icon;
    preferred-width: 1040px;
    preferred-height: 680px;
    min-width: 820px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 14px;

    // Logo da janela (barra de título/taskbar). Setada pelo Rust a partir de
    // `schematize::appicon::rgba(256)` (mesma marca do egui).
    in property <image> app-icon;

    in property <[SkillRow]> rows;
    in-out property <string> status: "";
    in-out property <bool> busy: false;
    // 0 = Instaladas, 1 = Marketplace, 2 = Environments, 3 = Overdev, 4 = Grafo (soon).
    in-out property <int> active-tab: 0;

    // ---- aba Overdev ----
    in property <[ProjItem]> od-projects;      // seletor de projeto (detectados + recentes)
    in property <[string]> od-dev-dirs;         // diretórios de desenvolvimento cadastrados
    in-out property <string> od-current;         // nome do projeto atual ("" = nenhum)
    in-out property <bool> od-has-project: false;
    in-out property <bool> od-has-overdev: false;
    in-out property <string> od-objetivo;
    in-out property <string> od-mode;
    in-out property <int> od-done;
    in-out property <int> od-open;
    in-out property <int> od-hold;
    in property <[OverItem]> od-items;
    in-out property <string> od-decisoes;
    in-out property <string> od-plano;
    in-out property <string> od-perguntas;

    // ---- aba Environments ----
    in property <[EnvRow]> env-rows;

    // ---- modal de instalação do Marketplace (dep opcional + environment opcional) ----
    in-out property <bool> mp-open: false;    // modal visível?
    in-out property <int> mp-idx: -1;          // linha (skill) sendo instalada
    in-out property <string> mp-title;          // "Instalar <slug>" (montado no Rust)
    in-out property <bool> mp-rec-show: false;  // oferecer a recomendada (base)?
    in-out property <string> mp-rec-label;       // "instalar também a <slug> (base)"
    in-out property <bool> mp-rec-check: false; // usuário marcou instalar a base? (default OFF)
    in-out property <bool> mp-env-show: false;  // oferecer o environment da linguagem?
    in-out property <string> mp-env-label;       // "instalar também o environment <lang>"
    in-out property <bool> mp-env-check: false; // usuário marcou instalar o environment?
    in property <[string]> mp-methods;          // métodos do environment disponíveis aqui
    in-out property <string> mp-method-sel;      // método escolhido (chip)

    callback toggle(int);
    callback row-install(int);   // Marketplace: instalar a linha i
    callback row-update(int);    // Instaladas: atualizar a linha i (só se outdated)
    callback row-remove(int);    // Instaladas: desinstalar a linha i
    callback open-author(int);   // abrir sponsor.url da linha i
    callback install-selected(); // Marketplace: instalar selecionadas (missing)
    callback update-selected();  // Instaladas: atualizar selecionadas (outdated)
    callback remove-selected();  // Instaladas: desinstalar selecionadas (instaladas)
    callback update-all();       // Instaladas: atualizar TODAS as instaladas-desatualizadas
    callback check();            // rechecar versões (re-resolve latest)
    callback select-all();
    callback select-pending();
    callback select-none();

    // ---- aba Environments ----
    callback env-install(int);        // instala o environment da linha i (abre TERMINAL)
    callback env-remove(int);         // remove o environment da linha i (abre TERMINAL)
    callback env-pick-method(int, string); // escolhe o método de instalação da linha i
    callback env-refresh();           // re-sonda a máquina e recarrega o status

    // ---- aba Overdev ----
    callback od-pick-project(string);  // escolhe um projeto (caminho) do seletor
    callback od-open-folder();          // abre pasta avulsa (picker nativo)
    callback od-reload();               // re-sonda dev_dirs + recarrega o projeto
    callback od-add-dev-dir();          // cadastra um diretório de desenvolvimento (picker)
    callback od-remove-dev-dir(string); // remove um diretório de desenvolvimento
    callback od-open-browser();         // abre o painel HTML do projeto no navegador

    // ---- modal de instalação do Marketplace ----
    callback mp-confirm();            // aplica: instala skill (+ base marcada) + (env em terminal se marcado)
    callback mp-cancel();             // fecha sem fazer nada
    callback mp-pick-method(string);  // escolhe o método do environment no modal
    callback mp-toggle-rec();         // liga/desliga instalar a recomendada
    callback mp-toggle-env();         // liga/desliga instalar o environment

    VerticalLayout {
        // ---- cabeçalho -------------------------------------------------
        Rectangle {
            height: 76px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "schematize";
                        font-size: 24px;
                        font-weight: 800;
                        color: Theme.text;
                    }
                    Text {
                        text: L.subtitle;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                }
                Rectangle {}  // espaçador elástico
                VerticalLayout {
                    alignment: center;
                    ThemeToggle {
                        clicked => { Theme.dark = !Theme.dark; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- barra de abas --------------------------------------------
        Rectangle {
            height: 50px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                TabBtn {
                    label: L.tab-installed;
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                TabBtn {
                    label: L.tab-marketplace;
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                TabBtn {
                    label: L.tab-environments;
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                TabBtn {
                    label: L.tab-overdev;
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; }
                }
                TabBtn {
                    label: L.tab-graph;
                    soon: true;
                    active: root.active-tab == 4;
                    clicked => { root.active-tab = 4; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- placeholder do Grafo (4) — próximo incremento -------------
        if root.active-tab == 4: Rectangle {
            background: Theme.bg;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: L.coming-soon;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text-dim;
                    }
                }
            }
        }

        // ---- aba OVERDEV (3) — seletor de projeto + view nativa --------
        // Porta o project_bar + overdev_view do egui: escolhe um projeto (detectados
        // pelos marcadores + recentes + pasta avulsa via picker nativo), gere os
        // dev_dirs, e renderiza o estado do overdev (objetivo, progresso, checklist
        // colorido, e as seções Decisões/Plano/Perguntas colapsáveis).
        if root.active-tab == 3: VerticalLayout {
            // ---- barra do seletor de projeto + dev_dirs ----
            Rectangle {
                background: Theme.bg;
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 12px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    // linha 1: Projeto: [dropdown] [Abrir pasta…] [recarregar]
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: L.project; font-size: 13px; font-weight: 600; color: Theme.text-dim; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 340px;
                                height: 34px;
                                border-radius: 8px;
                                background: pta.has-hover ? Theme.surface-2 : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: root.od-current != "" ? root.od-current : "—";
                                        color: root.od-current != "" ? Theme.text : Theme.text-dim;
                                        font-size: 13.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {}
                                    Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                                }
                                pta := TouchArea { mouse-cursor: pointer; clicked => { projpop.show(); } }
                                projpop := PopupWindow {
                                    x: 0;
                                    y: parent.height + 4px;
                                    width: 340px;
                                    Rectangle {
                                        background: Theme.surface;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        border-radius: 10px;
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 1px;
                                            if root.od-projects.length == 0: Text {
                                                text: L.no-project;
                                                font-size: 12px;
                                                color: Theme.text-dim;
                                                wrap: word-wrap;
                                            }
                                            for pit[pi] in root.od-projects: Rectangle {
                                                height: pit.is-header ? 26px : 32px;
                                                border-radius: 6px;
                                                background: (!pit.is-header && ita.has-hover) ? Theme.surface-2 : transparent;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    if pit.is-header: Text {
                                                        text: pit.label;
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: Theme.text-dim;
                                                        vertical-alignment: center;
                                                    }
                                                    if !pit.is-header: Text {
                                                        text: pit.name;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    Rectangle {}
                                                    if !pit.is-header && pit.marker != "": Text {
                                                        text: pit.marker;
                                                        font-size: 11px;
                                                        color: Theme.text-dim;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                ita := TouchArea {
                                                    enabled: !pit.is-header;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.od-pick-project(pit.path); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn { label: L.open-folder; small: true; clicked => { root.od-open-folder(); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn { label: L.reload; small: true; clicked => { root.od-reload(); } }
                        }
                        Rectangle {}
                    }
                    // linha 2: gestão dos diretórios de desenvolvimento
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: L.dev-dirs; font-size: 12.5px; font-weight: 700; color: Theme.text; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn { label: L.add-dev-dir; small: true; clicked => { root.od-add-dev-dir(); } }
                        }
                        Rectangle {}
                    }
                    if root.od-dev-dirs.length == 0: Text {
                        text: L.dev-dirs-empty;
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    for dd[ddi] in root.od-dev-dirs: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                background: xta.has-hover ? Theme.warn.transparentize(0.85) : transparent;
                                border-width: 1px;
                                border-color: Theme.border;
                                Text { text: "✕"; font-size: 11px; color: Theme.text-dim; }
                                xta := TouchArea { mouse-cursor: pointer; clicked => { root.od-remove-dev-dir(dd); } }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: dd; font-size: 12px; color: Theme.text-dim; overflow: elide; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ---- conteúdo do overdev ----
            // Empty-state: nenhum projeto escolhido.
            if !root.od-has-project: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: L.no-project;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            // Empty-state: projeto sem run de overdev.
            if root.od-has-project && !root.od-has-overdev: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: L.no-overdev;
                        font-size: 13px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
            // Estado do overdev: objetivo + progresso + checklist + seções.
            if root.od-has-project && root.od-has-overdev: ScrollView {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    // objetivo + pill de mode
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.od-objetivo;
                                font-size: 18px;
                                font-weight: 800;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 24px;
                                width: modetxt.preferred-width + 20px;
                                border-radius: 12px;
                                property <color> tone: root.od-mode == "active" ? Theme.good : Theme.text-dim;
                                background: tone.transparentize(0.85);
                                border-width: 1px;
                                border-color: tone.transparentize(0.5);
                                modetxt := Text {
                                    text: root.od-mode;
                                    color: parent.tone;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    // progresso: feitos / abertos / on-hold
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        Text { text: "✓ \{root.od-done}"; font-size: 13.5px; font-weight: 700; color: Theme.good; }
                        Text { text: "○ \{root.od-open}"; font-size: 13.5px; font-weight: 700; color: Theme.text-dim; }
                        Text { text: "~ \{root.od-hold}"; font-size: 13.5px; font-weight: 700; color: Theme.warn; }
                        Rectangle {}
                        Btn { label: L.open-browser; small: true; clicked => { root.od-open-browser(); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    // checklist colorido (verde feito, normal aberto, amarelo on-hold)
                    for it[ii] in root.od-items: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: start;
                            Text {
                                text: it.kind == "done" ? "✓" : it.kind == "hold" ? "~" : "○";
                                font-size: 13px;
                                font-weight: 800;
                                color: it.kind == "done" ? Theme.good : it.kind == "hold" ? Theme.warn : Theme.text-dim;
                            }
                        }
                        Text {
                            text: it.text;
                            font-size: 13px;
                            color: it.kind == "done" ? Theme.good : Theme.text;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle { height: 6px; }
                    // seções colapsáveis (só quando há conteúdo)
                    if root.od-decisoes != "": Collapse { title: L.od-decisions; body: root.od-decisoes; }
                    if root.od-plano != "": Collapse { title: L.od-plan; body: root.od-plano; }
                    if root.od-perguntas != "": Collapse { title: L.od-questions; body: root.od-perguntas; }
                }
            }
        }

        // ---- aba ENVIRONMENTS (2) — gestão dos runtimes de linguagem --
        // Cada linha: linguagem, status, escolha de MÉTODO (chips) e botões
        // Instalar/Desinstalar. As ações NÃO mexem na máquina de dentro da GUI:
        // abrem um TERMINAL rodando `schematize env …` (plano + consentimento lá).
        if root.active-tab == 2: VerticalLayout {
            // texto-guia + botão recarregar
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: L.env-intro;
                            font-size: 12.5px;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            small: true;
                            clicked => { root.env-refresh(); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    for erow[ei] in root.env-rows: Rectangle {
                        height: 96px;
                        border-radius: 12px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            // linha 1: nome + status
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: erow.display;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 24px;
                                    width: stxt.preferred-width + 22px;
                                    border-radius: 12px;
                                    property <color> tone: erow.installed ? Theme.good : Theme.text-dim;
                                    background: tone.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: tone.transparentize(0.5);
                                    stxt := Text {
                                        text: erow.status-label;
                                        color: erow.installed ? Theme.good : Theme.text-dim;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {}
                                if erow.op-label != "": Text {
                                    text: erow.op-label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                            // linha 2: método (chips) + ações
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-method;
                                        font-size: 12.5px;
                                        color: Theme.text-dim;
                                    }
                                }
                                if erow.methods.length == 0: VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: L.env-no-methods;
                                        font-size: 12.5px;
                                        color: Theme.warn;
                                    }
                                }
                                for m[mi] in erow.methods: VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        label: m;
                                        selected: m == erow.method-sel;
                                        clicked => { root.env-pick-method(ei, m); }
                                    }
                                }
                                Rectangle {}
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-install;
                                        primary: true;
                                        small: true;
                                        enabled: erow.methods.length > 0 && erow.method-sel != "";
                                        clicked => { root.env-install(ei); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn {
                                        label: L.act-remove;
                                        danger: true;
                                        small: true;
                                        enabled: erow.installed;
                                        clicked => { root.env-remove(ei); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- páginas Instaladas (0) e Marketplace (1) -----------------
        if root.active-tab <= 1: VerticalLayout {
            // ---- barra de ações (difere por página) -----------------------
            Rectangle {
                height: 62px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 10px;

                    // --- ações da página INSTALADAS ---
                    if root.active-tab == 0: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            // "Atualizar tudo": SÓ instaladas-desatualizadas. Nunca instala nova.
                            Btn {
                                label: L.update-all;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.update-all(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: L.update-installed-only;
                                font-size: 11px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.update-sel;
                                enabled: !root.busy;
                                clicked => { root.update-selected(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.remove-sel;
                                danger: true;
                                enabled: !root.busy;
                                clicked => { root.remove-selected(); }
                            }
                        }
                    }

                    // --- ações da página MARKETPLACE ---
                    if root.active-tab == 1: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.install-sel-market;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.install-selected(); }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Btn {
                            label: L.check;
                            enabled: !root.busy;
                            clicked => { root.check(); }
                        }
                    }
                    Rectangle {}  // espaçador
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.sel-label;
                                    font-size: 12.5px;
                                    color: Theme.text-dim;
                                }
                            }
                            Btn { label: L.sel-all; small: true; enabled: !root.busy; clicked => { root.select-all(); } }
                            // "Selecionar pendentes" só faz sentido em Instaladas (desatualizadas).
                            if root.active-tab == 0: Btn { label: L.sel-pending; small: true; enabled: !root.busy; clicked => { root.select-pending(); } }
                            Btn { label: L.sel-none; small: true; enabled: !root.busy; clicked => { root.select-none(); } }
                        }
                    }
                }
            }
            // ---- linha de status/toast ------------------------------------
            Rectangle {
                height: 26px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    Text {
                        text: root.status;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- cabeçalho de colunas (difere por página) -----------------
            Rectangle {
                height: 34px;
                background: Theme.surface-2;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 0px;
                    Rectangle { width: 34px; }
                    Text { width: 260px; text: L.col-skill; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 170px; text: L.col-author; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 90px; text: L.col-installed; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 90px; text: L.col-latest; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    if root.active-tab == 0: Text { width: 150px; text: L.col-state; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { text: L.col-actions; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ---- lista rolável (modelo único, filtrado por página) --------
            ScrollView {
                VerticalLayout {
                    padding-bottom: 16px;
                    spacing: 0px;
                    for row[i] in root.rows: Rectangle {
                        // Visível quando: cabeçalho da página ativa com itens,
                        // ou skill cujo ESTADO casa com a página ativa.
                        //   tab 0 (Instaladas)  → state != "missing"
                        //   tab 1 (Marketplace) → state == "missing"
                        property <bool> show: row.is-header
                            ? (row.count > 0 && root.active-tab == row.page)
                            : (root.active-tab == 0 ? row.state != "missing"
                               : root.active-tab == 1 ? row.state == "missing"
                               : false);
                        height: show ? (row.is-header ? 48px : 56px) : 0px;
                        visible: show;
                        background: row.is-header
                            ? Theme.bg
                            : (Math.mod(i, 2) == 0 ? Theme.stripe : Theme.bg);

                        // --- cabeçalho de categoria ---
                        if row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-top: 18px;
                            Text {
                                text: row.header-label;
                                font-size: 14px;
                                font-weight: 800;
                                color: Theme.header-fg;
                            }
                        }

                        // --- linha de skill ---
                        if !row.is-header && show: HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 0px;
                            // checkbox
                            VerticalLayout {
                                width: 34px;
                                alignment: center;
                                Check {
                                    checked: row.selected;
                                    enabled: !root.busy;
                                    toggled => { root.toggle(i); }
                                }
                            }
                            // skill + selo
                            VerticalLayout {
                                width: 260px;
                                alignment: center;
                                SkillName { slug: row.slug; verified: row.verified; }
                            }
                            // autor
                            VerticalLayout {
                                width: 170px;
                                alignment: center;
                                AuthorCell {
                                    author: row.author;
                                    author-url: row.author-url;
                                    clicked => { root.open-author(i); }
                                }
                            }

                            // ===== colunas + ações da página INSTALADAS =====
                            if root.active-tab == 0: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.installed; font-size: 13.5px; color: Theme.text; }
                                }
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    width: 150px;
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: start;
                                        StatePill { state: row.state; label: row.state-label; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        // Atualizar: habilitado só se desatualizada.
                                        Btn {
                                            label: L.act-update; small: true; primary: true;
                                            enabled: !root.busy && row.state == "outdated";
                                            clicked => { root.row-update(i); }
                                        }
                                        // Desinstalar sempre disponível numa instalada.
                                        Btn {
                                            label: L.act-remove; small: true; danger: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-remove(i); }
                                        }
                                    }
                                }
                            }

                            // ===== colunas + ação da página MARKETPLACE =====
                            if root.active-tab == 1: HorizontalLayout {
                                spacing: 0px;
                                VerticalLayout {
                                    width: 90px;
                                    alignment: center;
                                    Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    if row.busy || row.op-label != "": HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: row.op-label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: row.op-error ? Theme.warn : Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Botão Instalar grande/óbvio.
                                    if !row.busy && row.op-label == "": HorizontalLayout {
                                        alignment: start;
                                        Btn {
                                            label: L.act-install; primary: true;
                                            enabled: !root.busy;
                                            clicked => { root.row-install(i); }
                                        }
                                    }
                                }
                            }
                        }

                        // separador fino sob cada skill visível
                        if !row.is-header && show: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border.transparentize(0.5);
                        }
                    }
                }
            }
        }
    }

    // ---- MODAL de instalação (Marketplace) ----------------------------
    // Aparece ao instalar uma skill de LINGUAGEM: mostra que ela RECOMENDA a
    // engineering (skill base) e oferece, OPCIONALMENTE, instalar o environment
    // da linguagem (runtime+ferramentas) por um método disponível nesta máquina.
    // Nada é marcado por padrão — a recomendada e o environment só entram se o
    // usuário marcar. O environment roda num TERMINAL (consentimento honesto).
    if root.mp-open: Rectangle {
        // fundo escurecido cobrindo a janela (clique fora = cancelar).
        background: #000000.transparentize(0.45);
        TouchArea { clicked => { root.mp-cancel(); } }

        // cartão central
        Rectangle {
            width: Math.min(root.width - 64px, 520px);
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            // absorve cliques (não fecha ao clicar dentro).
            TouchArea {}
            card := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                // título
                Text {
                    text: root.mp-title;
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text;
                }
                // dependência opcional (skill base recomendada)
                if root.mp-rec-show: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: L.mp-recommends-note;
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                checked: root.mp-rec-check;
                                toggled => { root.mp-toggle-rec(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.mp-rec-label;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                    }
                }
                // environment opcional da linguagem
                if root.mp-env-show: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                checked: root.mp-env-check;
                                toggled => { root.mp-toggle-env(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.mp-env-label;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                    }
                    // escolha do método (só quando marca instalar o environment)
                    if root.mp-env-check: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Text { text: L.env-method; font-size: 12.5px; color: Theme.text-dim; }
                        }
                        if root.mp-methods.length == 0: VerticalLayout {
                            alignment: center;
                            Text { text: L.env-no-methods; font-size: 12.5px; color: Theme.warn; }
                        }
                        for mm[mmi] in root.mp-methods: Chip {
                            label: mm;
                            selected: mm == root.mp-method-sel;
                            clicked => { root.mp-pick-method(mm); }
                        }
                    }
                    if root.mp-env-check: Text {
                        text: L.mp-env-note;
                        font-size: 11.5px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                // ações
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Btn {
                        label: L.mp-cancel;
                        clicked => { root.mp-cancel(); }
                    }
                    Btn {
                        label: L.mp-confirm;
                        primary: true;
                        // se marcou instalar o environment, exige um método escolhido
                        enabled: !root.mp-env-check || root.mp-method-sel != "";
                        clicked => { root.mp-confirm(); }
                    }
                }
            }
        }
    }
}
