// ---------------------------------------------------------------------------
// SPIKE — aba Skills do schematize em Slint.
// Objetivo: mostrar o salto visual sobre a GUI atual em egui. Uma tela só,
// bem acabada: lista agrupada por categoria, checkbox, selo de verificado,
// coluna de autor, versões, pill de estado, tema claro/escuro caprichado.
// Dados vêm do Rust (lê catalog.json). Botões chamam callbacks no Rust.
// ---------------------------------------------------------------------------

import { ScrollView } from "std-widgets.slint";

// Uma linha do modelo. Pode ser um CABEÇALHO de categoria (is-header) ou uma
// SKILL. Campos preenchidos pelo Rust a partir do catalog.json.
export struct SkillRow {
    is-header: bool,
    header-label: string,
    slug: string,
    author: string,
    author-url: string,
    installed: string,
    latest: string,
    state: string,        // "missing" | "outdated" | "current"
    state-label: string,
    verified: bool,
    selected: bool,
}

// Paleta central — um único ponto de verdade para claro/escuro. Trocar
// Theme.dark repinta a janela inteira.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:        dark ? #14161c : #f4f6fb;
    out property <color> surface:   dark ? #1b1e27 : #ffffff;
    out property <color> surface-2: dark ? #222634 : #eef1f8;
    out property <color> stripe:    dark ? #1e222d : #f8fafd;
    out property <color> border:    dark ? #2b3040 : #dfe4ee;
    out property <color> text:      dark ? #e6e9f2 : #1a1e2b;
    out property <color> text-dim:  dark ? #8a90a2 : #6b7280;
    out property <color> accent:    #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #dfe8ff;
    out property <color> good:      #3ecf8e;
    out property <color> warn:      #e6b23a;
    out property <color> header-fg: dark ? #9db4ff : #3a5bd0;
}

// Checkbox próprio (controle total do visual + tema). Emite `toggled`.
component Check inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: checked ? Theme.accent : Theme.text-dim;
    background: checked ? Theme.accent : transparent;
    animate background, border-color { duration: 120ms; }
    Text {
        text: "✓";
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
        visible: root.checked;
    }
    TouchArea { clicked => { root.toggled(); } }
}

// Botão de ação com estilo próprio (primário/secundário).
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 9px;
    background: primary
        ? (ta.has-hover ? #6f9bff : Theme.accent)
        : (ta.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    opacity: enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            color: primary ? #ffffff : Theme.text;
            font-size: 14px;
            font-weight: 600;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Pill de estado (Instalar / Atualizar / Em dia).
component StatePill inherits Rectangle {
    in property <string> state;
    in property <string> label;
    property <color> tone:
        state == "missing"  ? Theme.warn :
        state == "outdated" ? Theme.accent : Theme.text-dim;
    width: txt.preferred-width + 22px;
    height: 24px;
    border-radius: 12px;
    background: tone.transparentize(0.85);
    border-width: 1px;
    border-color: tone.transparentize(0.5);
    txt := Text {
        text: root.label;
        color: root.tone;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "schematize — Skills (spike Slint)";
    preferred-width: 940px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 460px;
    background: Theme.bg;
    default-font-size: 14px;

    in property <[SkillRow]> rows;
    in-out property <string> status: "";
    callback toggle(int);
    callback install-selected();
    callback update-all();

    VerticalLayout {
        // ---- cabeçalho -------------------------------------------------
        Rectangle {
            height: 76px;
            background: Theme.surface;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "schematize";
                        font-size: 24px;
                        font-weight: 800;
                        color: Theme.text;
                    }
                    Text {
                        text: "Gestor de skills · spike de UI em Slint";
                        font-size: 12.5px;
                        color: Theme.text-dim;
                    }
                }
                Rectangle {}  // espaçador elástico
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: Theme.dark ? "☀  Tema claro" : "🌙  Tema escuro";
                        clicked => { Theme.dark = !Theme.dark; }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- barra de ações -------------------------------------------
        Rectangle {
            height: 66px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: "Instalar selecionadas";
                        primary: true;
                        clicked => { root.install-selected(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        label: "Atualizar tudo";
                        clicked => { root.update-all(); }
                    }
                }
                Rectangle {}  // espaçador
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.status;
                        font-size: 13px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        // ---- cabeçalho de colunas -------------------------------------
        Rectangle {
            height: 34px;
            background: Theme.surface-2;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 0px;
                Rectangle { width: 34px; }
                Text { width: 320px; text: "Skill"; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                Text { width: 200px; text: "Autor"; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                Text { width: 110px; text: "Instalada"; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                Text { width: 90px; text: "Latest"; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                Text { text: "Estado"; font-weight: 700; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- lista rolável --------------------------------------------
        ScrollView {
            VerticalLayout {
                padding-bottom: 16px;
                for row[i] in root.rows: Rectangle {
                    height: row.is-header ? 48px : 56px;
                    background: row.is-header
                        ? Theme.bg
                        : (Math.mod(i, 2) == 0 ? Theme.stripe : Theme.bg);

                    // --- cabeçalho de categoria ---
                    if row.is-header: HorizontalLayout {
                        padding-left: 24px;
                        padding-top: 18px;
                        Text {
                            text: row.header-label;
                            font-size: 14px;
                            font-weight: 800;
                            color: Theme.header-fg;
                        }
                    }

                    // --- linha de skill ---
                    if !row.is-header: HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 0px;
                        // checkbox
                        VerticalLayout {
                            width: 34px;
                            alignment: center;
                            Check {
                                checked: row.selected;
                                toggled => { root.toggle(i); }
                            }
                        }
                        // skill + selo verificado
                        HorizontalLayout {
                            width: 320px;
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: row.slug;
                                    font-size: 14.5px;
                                    font-weight: 700;
                                    color: Theme.text;
                                }
                            }
                            if row.verified: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 20px;
                                    width: badge.preferred-width + 16px;
                                    border-radius: 10px;
                                    background: Theme.good.transparentize(0.85);
                                    border-width: 1px;
                                    border-color: Theme.good.transparentize(0.5);
                                    badge := Text {
                                        text: "✓ Verificado";
                                        color: Theme.good;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // autor
                        VerticalLayout {
                            width: 200px;
                            alignment: center;
                            Text {
                                text: row.author;
                                font-size: 13.5px;
                                color: Theme.text-dim;
                                overflow: elide;
                            }
                        }
                        // instalada
                        VerticalLayout {
                            width: 110px;
                            alignment: center;
                            Text { text: row.installed; font-size: 13.5px; color: Theme.text; }
                        }
                        // latest
                        VerticalLayout {
                            width: 90px;
                            alignment: center;
                            Text { text: row.latest; font-size: 13.5px; color: Theme.text-dim; }
                        }
                        // estado (pill)
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: start;
                                StatePill { state: row.state; label: row.state-label; }
                            }
                        }
                    }

                    // separador fino sob cada skill
                    if !row.is-header: Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border.transparentize(0.5);
                    }
                }
            }
        }
    }
}
