import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { NotifItem, CmpFile } from "types.slint";
import { Btn, Chip, Check, Collapse, IconBtn } from "widgets.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Modal de DIRETÓRIOS DE DEV e pastas fixadas — de onde o seletor de projeto
// descobre os projetos.
export component DevDirsModal inherits Rectangle {
        background: #000000.transparentize(0.45);
        // clique fora = fechar + re-scan.
        TouchArea { clicked => { Cfg.modal-open = false; Od.reload(); } }

        Rectangle {
            width: Math.min(root.width - 64px, 560px);
            height: Math.min(root.height - 96px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}  // absorve cliques (não fecha ao clicar dentro)
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                // título + adicionar
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.dev-dirs; font-size: 18px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.add-dev-dir; primary: true; small: true; clicked => { Od.add-dev-dir(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                // lista dos dev_dirs (rolável)
                if Od.dev-dirs.length == 0: Text {
                    text: L.dev-dirs-empty;
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for dd[ddi] in Od.dev-dirs: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: dxta.has-hover ? Theme.warn.transparentize(0.85) : transparent;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text { text: "✕"; font-size: 11px; color: Theme.text-dim; }
                                    dxta := TouchArea { mouse-cursor: pointer; clicked => { Od.remove-dev-dir(dd); } }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: dd; font-size: 12.5px; color: Theme.text-dim; overflow: elide; }
                            }
                        }
                    }
                }
                // ---- Projetos fixados (pins) ----
                // Uma pasta fixada vira UM projeto no seletor mesmo sem marcador
                // git — útil pra workspace/monorepo de microserviços.
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.pinned-projects; font-size: 15px; font-weight: 800; color: Theme.text; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.pin-folder; primary: true; small: true; clicked => { Od.pin-folder(); } }
                    }
                }
                Text {
                    text: L.pin-hint;
                    font-size: 11.5px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if Od.pinned.length > 0: ScrollView {
                    max-height: 130px;
                    VerticalLayout {
                        spacing: 6px;
                        for pp[ppi] in Od.pinned: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 6px;
                                    background: pxta.has-hover ? Theme.warn.transparentize(0.85) : transparent;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text { text: "✕"; font-size: 11px; color: Theme.text-dim; }
                                    pxta := TouchArea { mouse-cursor: pointer; clicked => { Od.unpin(pp); } }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: pp; font-size: 12.5px; color: Theme.text-dim; overflow: elide; }
                            }
                        }
                    }
                }
                Rectangle {}  // empurra o rodapé pra base
                // rodapé: abrir projeto avulso + fechar
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.open-loose-project; small: true; clicked => { Od.open-folder(); } }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.mp-cancel; small: true; clicked => { Cfg.modal-open = false; Od.reload(); } }
                    }
                }
            }
        }
}
