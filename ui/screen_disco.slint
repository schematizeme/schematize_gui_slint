import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { DiscoTotal, DiscoRow, DockerRow } from "types.slint";
import { Btn, Chip } from "widgets.slint";
import { Pager } from "chrome.slint";
import { Dsk } from "state.slint";

// Uma linha de TOTAL (por disco / por tipo): rótulo, barra proporcional e tamanho.
// A barra existe porque a pergunta é comparativa — "quem está enchendo" se lê de
// relance, e não somando números na cabeça.
component TotalRow inherits VerticalLayout {
    in property <DiscoTotal> t;
    spacing: 5px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.t.label;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Rectangle {}
        Text { text: root.t.note; font-size: 11.5px; color: Theme.text-dim; vertical-alignment: center; }
        Text {
            text: root.t.size;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text;
            width: 92px;
            horizontal-alignment: right;
        }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.surface-2;
        Rectangle {
            x: 0;
            width: parent.width * Math.max(0.02, root.t.frac);
            height: parent.height;
            border-radius: 3px;
            background: Theme.accent;
        }
    }
}

// Cabeçalho de seção — um título e um traço, sem caixa: a tela já é uma pilha de
// blocos, e mais borda só faria ruído.
component SectionTitle inherits VerticalLayout {
    in property <string> label;
    spacing: 8px;
    Text { text: root.label; font-size: 12px; font-weight: 800; color: Theme.text-dim; }
    Rectangle { height: 1px; background: Theme.border; }
}

// Tela DISCO (7) — o que está ocupando espaço e pode ser refeito.
export component DiscoScreen inherits VerticalLayout {
    // ---- barra de ação: filtro por tempo parado + varrer -------------------
    Rectangle {
        height: 62px;
        background: Theme.bg;
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Text { text: L.disk-min-days; font-size: 12.5px; color: Theme.text-dim; }
            }
            VerticalLayout {
                alignment: center;
                Chip { label: L.disk-any; selected: Dsk.min-days == 0; clicked => { Dsk.set-min-days(0); } }
            }
            VerticalLayout {
                alignment: center;
                Chip { label: "7"; selected: Dsk.min-days == 7; clicked => { Dsk.set-min-days(7); } }
            }
            VerticalLayout {
                alignment: center;
                Chip { label: "30"; selected: Dsk.min-days == 30; clicked => { Dsk.set-min-days(30); } }
            }
            VerticalLayout {
                alignment: center;
                Chip { label: "90"; selected: Dsk.min-days == 90; clicked => { Dsk.set-min-days(90); } }
            }
            Rectangle {}
            VerticalLayout {
                alignment: center;
                Text {
                    text: Dsk.scanning ? L.disk-scanning : Dsk.status;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.text-dim;
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    label: L.disk-scan;
                    primary: true;
                    small: true;
                    enabled: !Dsk.scanning;
                    clicked => { Dsk.scan(); }
                }
            }
        }
    }
    Rectangle { height: 1px; background: Theme.border; }

    // ---- banner do resultado da última ação --------------------------------
    if Dsk.banner != "": Rectangle {
        height: 40px;
        background: Dsk.banner-error ? Theme.warn.transparentize(0.88) : Theme.good.transparentize(0.88);
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            Text {
                text: Dsk.banner;
                font-size: 12.5px;
                font-weight: 600;
                color: Dsk.banner-error ? Theme.warn : Theme.good;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    ScrollView {
        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 24px;
            spacing: 22px;

            // vazio honesto: ANTES de varrer não mostramos zero (zero seria mentira).
            if !Dsk.scanned && !Dsk.scanning: Text {
                text: L.disk-intro;
                font-size: 13px;
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            // ---- POR DISCO — é o que enche ---------------------------------
            if Dsk.mounts.length > 0: VerticalLayout {
                spacing: 12px;
                SectionTitle { label: L.disk-by-mount; }
                for m in Dsk.mounts: TotalRow { t: m; }
            }

            // ---- POR TIPO — quem é o culpado -------------------------------
            if Dsk.kinds.length > 0: VerticalLayout {
                spacing: 12px;
                SectionTitle { label: L.disk-by-kind; }
                for k in Dsk.kinds: TotalRow { t: k; }
            }

            // ---- DOCKER ----------------------------------------------------
            if Dsk.docker.length > 0: VerticalLayout {
                spacing: 10px;
                SectionTitle { label: L.disk-docker; }
                for d[di] in Dsk.docker: Rectangle {
                    height: 46px;
                    border-radius: 9px;
                    background: Math.mod(di, 2) == 0 ? Theme.stripe : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: d.label; font-size: 13px; font-weight: 700; color: Theme.text; }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: d.op-label != "" ? d.op-label : "\{d.size} · \{L.disk-reclaimable} \{d.reclaim}";
                                font-size: 12px;
                                color: d.op-error ? Theme.warn : Theme.text-dim;
                            }
                        }
                        if d.prune != "": VerticalLayout {
                            alignment: center;
                            Btn {
                                label: d.destructive ? L.disk-prune-data : L.disk-prune;
                                small: true;
                                danger: d.destructive;
                                clicked => { Dsk.docker-prune-request(d.prune); }
                            }
                        }
                    }
                }
            }

            // ---- MAIORES — a lista acionável -------------------------------
            if Dsk.total > 0: VerticalLayout {
                spacing: 10px;
                SectionTitle { label: L.disk-largest; }
                for r[ri] in Dsk.rows: Rectangle {
                    height: 62px;
                    border-radius: 9px;
                    background: Math.mod(ri, 2) == 0 ? Theme.stripe : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: r.path;
                                font-size: 12.5px;
                                font-weight: 700;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: r.op-label != ""
                                    ? r.op-label
                                    : "\{r.kind} · \{r.days} · \{r.refaz}";
                                font-size: 11.5px;
                                color: r.op-error ? Theme.warn : Theme.text-dim;
                                overflow: elide;
                            }
                        }
                        Rectangle {}
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: r.size;
                                font-size: 13.5px;
                                font-weight: 800;
                                color: Theme.text;
                                width: 92px;
                                horizontal-alignment: right;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn { label: L.disk-open; small: true; clicked => { Dsk.open-folder(r.idx); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn {
                                label: L.disk-delete;
                                small: true;
                                danger: true;
                                clicked => { Dsk.remove-request(r.idx); }
                            }
                        }
                    }
                }
                if Dsk.total > Dsk.per-page: Pager {
                    page: Dsk.page;
                    total: Dsk.total;
                    per: Dsk.per-page;
                    prev => { Dsk.page-prev(); }
                    next => { Dsk.page-next(); }
                }
            }
        }
    }
}
