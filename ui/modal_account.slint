import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { NotifItem, CmpFile } from "types.slint";
import { Btn, Chip, Check, Collapse, IconBtn } from "widgets.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Modal da CONTA — o device flow do login (código + URL de verificação).
export component AccountModal inherits Rectangle {
        background: #000000.transparentize(0.5);
        TouchArea {}  // captura cliques do fundo (evita fechar sem cancelar o poll)
        Rectangle {
            width: Math.min(root.width - 48px, 460px);
            height: Math.min(root.height - 80px, 440px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: L.acc-modal-title; font-size: 16px; font-weight: 800; color: Theme.text; }
                Text { text: L.acc-code-label; font-size: 12.5px; color: Theme.text-dim; wrap: word-wrap; }
                // código em destaque.
                Rectangle {
                    height: 62px;
                    border-radius: 10px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(0.4);
                    Text {
                        text: Acc.user-code;
                        font-size: 30px;
                        font-weight: 800;
                        color: Theme.header-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // URL de verificação.
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.acc-verification-at; font-size: 12px; color: Theme.text-dim; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Acc.verification-uri;
                            font-size: 12.5px; font-weight: 700; color: Theme.text; overflow: elide;
                        }
                    }
                    Rectangle {}
                }
                Btn { label: L.acc-open-browser; primary: true; clicked => { Acc.open-verify(); } }
                Rectangle {}  // empurra a base pra baixo
                if Acc.status != "": Text {
                    text: Acc.status;
                    font-size: 12px; font-weight: 600; color: Theme.warn; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: L.acc-waiting; font-size: 12px; color: Theme.text-dim; }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        Btn { label: L.acc-cancel; small: true; clicked => { Acc.cancel-login(); } }
                    }
                }
            }
        }
}
