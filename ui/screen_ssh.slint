import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import {
    GraphNode, GraphEdge, SkillRow, EnvRow, ProjItem, OverItem, SkillAction, SshRow,
    LangItem, SnapRow, CommitRow, NotifItem, CmpFile, DbColumn, DbFkRow, DbIndexRow,
    DbTableRow,
} from "types.slint";
import {
    VerifiedCheck, Check, Btn, ThemeToggle, Bell, Collapse, Chip, TabBtn, StatePill,
    SkillName, AuthorCell, HomeCard, ReloadIcon, IconBtn,
} from "widgets.slint";
import { ProjectBar, Pager, GraphCanvas } from "chrome.slint";
import { Sk, Mp, Cfg, Mg, Od, G, Db, Ssh, Notif, Cmp, Acc, App } from "state.slint";

// Aba CHAVES SSH (Mercado > 3) — listar, gerar, exportar e remover.
export component SshScreen inherits VerticalLayout {
            // seletor de modo (Criar | Editar)
            Rectangle {
                height: 58px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            label: L.create-skill;
                            selected: Mg.mode == 0;
                            clicked => { Mg.mode = 0; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Chip {
                            label: L.edit-skill;
                            selected: Mg.mode == 1;
                            clicked => { Mg.mode = 1; Mg.refresh-skills(); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // ===== MODO CRIAR =====
            if Mg.mode == 0: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    // campo slug (validado)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-slug; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        LineEdit {
                            width: 360px;
                            placeholder-text: L.skill-slug;
                            text: Mg.slug;
                            edited(s) => { Mg.slug-edited(s); }
                        }
                        if Mg.slug-error != "": Text {
                            text: Mg.slug-error;
                            font-size: 12px;
                            color: Theme.warn;
                            wrap: word-wrap;
                        }
                    }
                    // campo nome
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-name; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        LineEdit {
                            width: 360px;
                            placeholder-text: L.skill-name;
                            text: Mg.name;
                            edited(s) => { Mg.name = s; }
                        }
                    }
                    // campo descrição (multi-linha)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: L.skill-desc; font-size: 13px; font-weight: 700; color: Theme.text-dim; }
                        Rectangle {
                            width: 560px;
                            height: 100px;
                            border-radius: 8px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            TextEdit {
                                width: 100%;
                                height: 100%;
                                text: Mg.desc;
                                wrap: word-wrap;
                                edited(s) => { Mg.desc = s; }
                            }
                        }
                    }
                    // ação criar
                    HorizontalLayout {
                        alignment: start;
                        Btn {
                            label: L.create;
                            primary: true;
                            enabled: Mg.slug != "" && Mg.slug-error == "";
                            clicked => { Mg.create(); }
                        }
                    }
                    // resultado (sucesso = caminho / erro)
                    if Mg.create-result != "": Text {
                        text: Mg.create-result;
                        font-size: 13px;
                        font-weight: 600;
                        color: Mg.create-error ? Theme.warn : Theme.good;
                        wrap: word-wrap;
                    }
                    // pós-criar: oferece editar já
                    if Mg.create-result != "" && !Mg.create-error: HorizontalLayout {
                        alignment: start;
                        Btn { label: L.edit-now; small: true; clicked => { Mg.edit-created(); } }
                    }
                    Rectangle {}
                }
            }

            // ===== MODO EDITAR =====
            if Mg.mode == 1: HorizontalLayout {
                // ---- barra lateral: dropdown de skills + lista de arquivos ----
                Rectangle {
                    width: 300px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: L.edit-skill; font-size: 14px; font-weight: 800; color: Theme.text; }
                        // dropdown das skills instaladas
                        Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: skdd.has-hover ? Theme.surface-2 : Theme.bg;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: Mg.sel-skill != "" ? Mg.sel-skill : L.pick-skill;
                                    color: Mg.sel-skill != "" ? Theme.text : Theme.text-dim;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle {}
                                Text { text: "▾"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                            }
                            skdd := TouchArea { mouse-cursor: pointer; clicked => { skpop.show(); } }
                            skpop := PopupWindow {
                                close-policy: close-on-click-outside; // vide lgpop: ScrollView+close-on-click engole o clique
                                x: 0;
                                y: parent.height + 4px;
                                width: 268px;
                                Rectangle {
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 10px;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;
                                        if Mg.skills.length == 0: Text {
                                            text: L.no-installed-skills;
                                            font-size: 12px;
                                            color: Theme.text-dim;
                                            wrap: word-wrap;
                                        }
                                        for sk[si] in Mg.skills: Rectangle {
                                            height: 30px;
                                            border-radius: 6px;
                                            background: skita.has-hover ? Theme.surface-2 : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: sk;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            skita := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { Mg.pick-skill(sk); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // lista de arquivos da skill escolhida
                        if Mg.sel-skill != "": Text {
                            text: L.pick-file;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text-dim;
                        }
                        ScrollView {
                            VerticalLayout {
                                spacing: 2px;
                                for f[fi] in Mg.files: Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: f == Mg.sel-file
                                        ? Theme.accent-soft
                                        : (fita.has-hover ? Theme.surface-2 : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: f;
                                            font-size: 12.5px;
                                            font-weight: f == Mg.sel-file ? 700 : 500;
                                            color: f == Mg.sel-file ? Theme.header-fg : Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    fita := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { Mg.pick-file(f); }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { width: 1px; background: Theme.border; }
                // ---- editor de texto ----
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    // aviso de FORK: skill OFICIAL ainda não-forkada → editar vai forkar;
                    // skill já forkada → [fork] ativo + botão Comparar com a oficial nova.
                    if Mg.sel-skill != "" && Mg.sel-official && !Mg.sel-forked: Rectangle {
                        border-radius: 8px;
                        background: Theme.warn.transparentize(0.86);
                        border-width: 1px;
                        border-color: Theme.warn.transparentize(0.5);
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "⚠"; font-size: 14px; color: Theme.warn; vertical-alignment: center; }
                            Text {
                                text: L.fork-will;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if Mg.sel-skill != "" && Mg.sel-forked: Rectangle {
                        border-radius: 8px;
                        background: Theme.accent-soft;
                        border-width: 1px;
                        border-color: Theme.accent.transparentize(0.5);
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: L.fork-active;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {}
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    label: L.compare-official;
                                    small: true;
                                    clicked => { Cmp.request(Mg.sel-skill); }
                                }
                            }
                        }
                    }
                    // empty-state: nenhum arquivo escolhido
                    if Mg.sel-file == "": VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: L.pick-file-hint;
                                font-size: 13px;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    // cabeçalho: skill / arquivo
                    if Mg.sel-file != "": Text {
                        text: Mg.sel-skill + " / " + Mg.sel-file;
                        font-size: 13.5px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    // editor multi-linha (ocupa o espaço restante)
                    if Mg.sel-file != "": Rectangle {
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        TextEdit {
                            width: 100%;
                            height: 100%;
                            text: Mg.content;
                            wrap: no-wrap;
                            edited(s) => { Mg.content = s; }
                        }
                    }
                    // salvar + feedback
                    if Mg.sel-file != "": HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Btn { label: L.save; primary: true; clicked => { Mg.save(); } }
                        VerticalLayout {
                            alignment: center;
                            if Mg.save-result != "": Text {
                                text: Mg.save-result;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Mg.save-error ? Theme.warn : Theme.good;
                            }
                        }
                    }
                }
            }
}
