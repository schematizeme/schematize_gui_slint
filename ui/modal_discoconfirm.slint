import { Theme } from "theme.slint";
import { L } from "i18n.slint";
import { Btn } from "widgets.slint";
import { Dsk } from "state.slint";

// Confirmação de APAGAR — do achado de disco ou de uma poda do Docker.
//
// A poda de VOLUMES é a única marcada `confirm-destructive`, e ela troca o rótulo
// do botão: perder imagem custa um `docker pull`, perder volume pode custar o
// trabalho de alguém. O texto do que será apagado é montado no Rust (caminho +
// tamanho + como se refaz) — a confirmação nunca é genérica.
export component DiscoConfirmModal inherits Rectangle {
    background: #000000.transparentize(0.45);
    TouchArea { clicked => { Dsk.confirm-no(); } }
    Rectangle {
        width: Math.min(root.width - 64px, 520px);
        height: card.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Dsk.confirm-destructive ? Theme.warn.transparentize(0.4) : Theme.border;
        TouchArea {}
        card := VerticalLayout {
            padding: 22px;
            spacing: 16px;
            Text {
                text: Dsk.confirm-msg;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if Dsk.confirm-destructive: Text {
                text: L.disk-data-warning;
                font-size: 12.5px;
                font-weight: 700;
                color: Theme.warn;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Btn { label: L.mp-cancel; clicked => { Dsk.confirm-no(); } }
                Btn {
                    label: Dsk.confirm-destructive ? L.disk-prune-data : L.disk-delete;
                    primary: true;
                    danger: true;
                    clicked => { Dsk.confirm-yes(); }
                }
            }
        }
    }
}
